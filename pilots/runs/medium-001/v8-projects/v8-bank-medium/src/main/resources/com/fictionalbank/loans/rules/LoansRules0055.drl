package com.fictionalbank.loans.rules;

import com.fictionalbank.model.MortgageAccount0031;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0055 High Value"
    ruleflow-group "loans-rules-0055"
    salience 10
when
    $o : MortgageAccount0031(amount > 4850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0055 Low Score"
    ruleflow-group "loans-rules-0055"
    salience 5
when
    $o : MortgageAccount0031(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0055 Standard"
    ruleflow-group "loans-rules-0055"
    salience 1
when
    $o : MortgageAccount0031(amount <= 4850, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

