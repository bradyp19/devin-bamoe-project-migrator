package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsCase0046;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0075 High Value"
    ruleflow-group "mortgage-rules-0075"
    salience 10
when
    $o : CardsCase0046(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0075 Low Score"
    ruleflow-group "mortgage-rules-0075"
    salience 5
when
    $o : CardsCase0046(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0075 Standard"
    ruleflow-group "mortgage-rules-0075"
    salience 1
when
    $o : CardsCase0046(amount <= 950, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

