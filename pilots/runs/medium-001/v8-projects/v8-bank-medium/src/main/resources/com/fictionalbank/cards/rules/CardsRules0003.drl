package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsCase0004;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0003 High Value"
    ruleflow-group "cards-rules-0003"
    salience 10
when
    $o : DepositsCase0004(amount > 1450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0003 Low Score"
    ruleflow-group "cards-rules-0003"
    salience 5
when
    $o : DepositsCase0004(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0003 Standard"
    ruleflow-group "cards-rules-0003"
    salience 1
when
    $o : DepositsCase0004(amount <= 1450, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

