package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsAccount0007;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0014 High Value"
    ruleflow-group "kyc-rules-0014"
    salience 10
when
    $o : DepositsAccount0007(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0014 Low Score"
    ruleflow-group "kyc-rules-0014"
    salience 5
when
    $o : DepositsAccount0007(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0014 Standard"
    ruleflow-group "kyc-rules-0014"
    salience 1
when
    $o : DepositsAccount0007(amount <= 3950, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

