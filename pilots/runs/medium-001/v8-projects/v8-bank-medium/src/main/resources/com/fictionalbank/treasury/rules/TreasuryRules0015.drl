package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.DepositsAccount0007;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0015 High Value"
    ruleflow-group "treasury-rules-0015"
    salience 10
when
    $o : DepositsAccount0007(amount > 4250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0015 Low Score"
    ruleflow-group "treasury-rules-0015"
    salience 5
when
    $o : DepositsAccount0007(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0015 Standard"
    ruleflow-group "treasury-rules-0015"
    salience 1
when
    $o : DepositsAccount0007(amount <= 4250, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

