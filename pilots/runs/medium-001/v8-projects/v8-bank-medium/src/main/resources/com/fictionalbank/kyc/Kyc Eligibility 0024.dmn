<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/kyc/eligibility0024" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0024" name="Kyc Eligibility 0024" namespace="https://fictionalbank.example/dmn/kyc/eligibility0024">
  <dmn:inputData id="_in0024_age" name="Age">
    <dmn:variable id="_in0024_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0024_amount" name="Amount">
    <dmn:variable id="_in0024_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0024" name="Eligible">
    <dmn:variable id="_dec0024_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0024a">
      <dmn:requiredInput href="#_in0024_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0024b">
      <dmn:requiredInput href="#_in0024_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0024" hitPolicy="FIRST">
      <dmn:input id="_dt0024_i1"><dmn:inputExpression id="_dt0024_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0024_i2"><dmn:inputExpression id="_dt0024_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0024_o1"/>
      <dmn:rule id="_dt0024_r1">
        <dmn:inputEntry id="_dt0024_r1a"><dmn:text>&lt; 20</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0024_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0024_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0024_r2">
        <dmn:inputEntry id="_dt0024_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0024_r2b"><dmn:text>&lt;= 15500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0024_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0024_r3">
        <dmn:inputEntry id="_dt0024_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0024_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0024_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
