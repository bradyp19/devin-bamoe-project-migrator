package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.MortgagePayment0002;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0008 High Value"
    ruleflow-group "fraud-rules-0008"
    salience 10
when
    $o : MortgagePayment0002(amount > 3800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0008 Low Score"
    ruleflow-group "fraud-rules-0008"
    salience 5
when
    $o : MortgagePayment0002(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0008 Standard"
    ruleflow-group "fraud-rules-0008"
    salience 1
when
    $o : MortgagePayment0002(amount <= 3800, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

