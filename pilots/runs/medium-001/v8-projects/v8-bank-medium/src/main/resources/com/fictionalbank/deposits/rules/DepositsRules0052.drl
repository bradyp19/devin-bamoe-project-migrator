package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.CardsParty0035;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0052 High Value"
    ruleflow-group "deposits-rules-0052"
    salience 10
when
    $o : CardsParty0035(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0052 Low Score"
    ruleflow-group "deposits-rules-0052"
    salience 5
when
    $o : CardsParty0035(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0052 Standard"
    ruleflow-group "deposits-rules-0052"
    salience 1
when
    $o : CardsParty0035(amount <= 700, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

