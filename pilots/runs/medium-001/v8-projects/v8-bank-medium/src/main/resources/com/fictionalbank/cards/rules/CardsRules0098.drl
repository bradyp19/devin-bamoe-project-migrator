package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycPayment0056;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0098 High Value"
    ruleflow-group "cards-rules-0098"
    salience 10
when
    $o : KycPayment0056(amount > 2650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0098 Low Score"
    ruleflow-group "cards-rules-0098"
    salience 5
when
    $o : KycPayment0056(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0098 Standard"
    ruleflow-group "cards-rules-0098"
    salience 1
when
    $o : KycPayment0056(amount <= 2650, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

