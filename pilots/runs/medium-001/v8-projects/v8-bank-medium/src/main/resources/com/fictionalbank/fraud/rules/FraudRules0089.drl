package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryPayment0050;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0089 High Value"
    ruleflow-group "fraud-rules-0089"
    salience 10
when
    $o : TreasuryPayment0050(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0089 Low Score"
    ruleflow-group "fraud-rules-0089"
    salience 5
when
    $o : TreasuryPayment0050(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0089 Standard"
    ruleflow-group "fraud-rules-0089"
    salience 1
when
    $o : TreasuryPayment0050(amount <= 2950, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

