package com.fictionalbank.payments.rules;

import com.fictionalbank.model.FraudParty0047;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0078 High Value"
    ruleflow-group "payments-rules-0078"
    salience 10
when
    $o : FraudParty0047(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0078 Low Score"
    ruleflow-group "payments-rules-0078"
    salience 5
when
    $o : FraudParty0047(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0078 Standard"
    ruleflow-group "payments-rules-0078"
    salience 1
when
    $o : FraudParty0047(amount <= 2150, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

