package com.fictionalbank.cards.rules;

import com.fictionalbank.model.CardsPayment0026;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0042 High Value"
    ruleflow-group "cards-rules-0042"
    salience 10
when
    $o : CardsPayment0026(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0042 Low Score"
    ruleflow-group "cards-rules-0042"
    salience 5
when
    $o : CardsPayment0026(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0042 Standard"
    ruleflow-group "cards-rules-0042"
    salience 1
when
    $o : CardsPayment0026(amount <= 3950, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

