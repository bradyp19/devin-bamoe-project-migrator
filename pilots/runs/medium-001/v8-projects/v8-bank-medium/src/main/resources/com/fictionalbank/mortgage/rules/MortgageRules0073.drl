package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsCase0046;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0073 High Value"
    ruleflow-group "mortgage-rules-0073"
    salience 10
when
    $o : CardsCase0046(amount > 4150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0073 Low Score"
    ruleflow-group "mortgage-rules-0073"
    salience 5
when
    $o : CardsCase0046(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0073 Standard"
    ruleflow-group "mortgage-rules-0073"
    salience 1
when
    $o : CardsCase0046(amount <= 4150, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

