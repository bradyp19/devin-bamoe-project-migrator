package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCard0003;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0010 High Value"
    ruleflow-group "fraud-rules-0010"
    salience 10
when
    $o : TreasuryCard0003(amount > 1850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0010 Low Score"
    ruleflow-group "fraud-rules-0010"
    salience 5
when
    $o : TreasuryCard0003(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0010 Standard"
    ruleflow-group "fraud-rules-0010"
    salience 1
when
    $o : TreasuryCard0003(amount <= 1850, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

