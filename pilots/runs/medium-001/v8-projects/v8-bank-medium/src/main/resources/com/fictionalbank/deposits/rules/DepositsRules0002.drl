package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgagePayment0002;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0002 High Value"
    ruleflow-group "deposits-rules-0002"
    salience 10
when
    $o : MortgagePayment0002(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0002 Low Score"
    ruleflow-group "deposits-rules-0002"
    salience 5
when
    $o : MortgagePayment0002(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0002 Standard"
    ruleflow-group "deposits-rules-0002"
    salience 1
when
    $o : MortgagePayment0002(amount <= 1000, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

