package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsCard0033;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0059 High Value"
    ruleflow-group "mortgage-rules-0059"
    salience 10
when
    $o : CardsCard0033(amount > 3550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0059 Low Score"
    ruleflow-group "mortgage-rules-0059"
    salience 5
when
    $o : CardsCard0033(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0059 Standard"
    ruleflow-group "mortgage-rules-0059"
    salience 1
when
    $o : CardsCard0033(amount <= 3550, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

