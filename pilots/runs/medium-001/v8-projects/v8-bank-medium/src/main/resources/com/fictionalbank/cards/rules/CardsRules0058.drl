package com.fictionalbank.cards.rules;

import com.fictionalbank.model.MortgageAccount0031;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0058 High Value"
    ruleflow-group "cards-rules-0058"
    salience 10
when
    $o : MortgageAccount0031(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0058 Low Score"
    ruleflow-group "cards-rules-0058"
    salience 5
when
    $o : MortgageAccount0031(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0058 Standard"
    ruleflow-group "cards-rules-0058"
    salience 1
when
    $o : MortgageAccount0031(amount <= 2200, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

