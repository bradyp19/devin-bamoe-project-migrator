package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsCase0004;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0007 High Value"
    ruleflow-group "payments-rules-0007"
    salience 10
when
    $o : DepositsCase0004(amount > 4050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0007 Low Score"
    ruleflow-group "payments-rules-0007"
    salience 5
when
    $o : DepositsCase0004(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0007 Standard"
    ruleflow-group "payments-rules-0007"
    salience 1
when
    $o : DepositsCase0004(amount <= 4050, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

