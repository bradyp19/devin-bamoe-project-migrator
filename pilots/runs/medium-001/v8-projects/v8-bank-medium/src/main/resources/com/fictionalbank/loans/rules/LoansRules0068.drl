package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryCard0039;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0068 High Value"
    ruleflow-group "loans-rules-0068"
    salience 10
when
    $o : TreasuryCard0039(amount > 4400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0068 Low Score"
    ruleflow-group "loans-rules-0068"
    salience 5
when
    $o : TreasuryCard0039(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0068 Standard"
    ruleflow-group "loans-rules-0068"
    salience 1
when
    $o : TreasuryCard0039(amount <= 4400, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

