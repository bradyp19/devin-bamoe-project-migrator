package com.fictionalbank.cards.rules;

import com.fictionalbank.model.LoansCase0052;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0081 High Value"
    ruleflow-group "cards-rules-0081"
    salience 10
when
    $o : LoansCase0052(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new LoansCase0052());
    update($o);
end

rule "Cards R0081 Low Score"
    ruleflow-group "cards-rules-0081"
    salience 5
when
    $o : LoansCase0052(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0081 Standard"
    ruleflow-group "cards-rules-0081"
    salience 1
when
    $o : LoansCase0052(amount <= 2900, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

