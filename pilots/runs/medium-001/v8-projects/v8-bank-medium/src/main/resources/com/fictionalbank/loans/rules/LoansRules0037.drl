package com.fictionalbank.loans.rules;

import com.fictionalbank.model.FraudParty0023;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0037 High Value"
    ruleflow-group "loans-rules-0037"
    salience 10
when
    $o : FraudParty0023(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0037 Low Score"
    ruleflow-group "loans-rules-0037"
    salience 5
when
    $o : FraudParty0023(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0037 Standard"
    ruleflow-group "loans-rules-0037"
    salience 1
when
    $o : FraudParty0023(amount <= 1800, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

