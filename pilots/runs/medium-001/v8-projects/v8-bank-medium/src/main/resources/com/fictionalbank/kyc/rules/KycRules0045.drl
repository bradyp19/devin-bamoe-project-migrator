package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsPayment0026;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0045 High Value"
    ruleflow-group "kyc-rules-0045"
    salience 10
when
    $o : CardsPayment0026(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0045 Low Score"
    ruleflow-group "kyc-rules-0045"
    salience 5
when
    $o : CardsPayment0026(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0045 Standard"
    ruleflow-group "kyc-rules-0045"
    salience 1
when
    $o : CardsPayment0026(amount <= 3950, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

