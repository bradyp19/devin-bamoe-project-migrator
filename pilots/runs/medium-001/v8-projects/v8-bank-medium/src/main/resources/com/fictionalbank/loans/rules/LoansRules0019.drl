package com.fictionalbank.loans.rules;

import com.fictionalbank.model.MortgageApplicant0012;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0019 High Value"
    ruleflow-group "loans-rules-0019"
    salience 10
when
    $o : MortgageApplicant0012(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0019 Low Score"
    ruleflow-group "loans-rules-0019"
    salience 5
when
    $o : MortgageApplicant0012(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0019 Standard"
    ruleflow-group "loans-rules-0019"
    salience 1
when
    $o : MortgageApplicant0012(amount <= 3950, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

