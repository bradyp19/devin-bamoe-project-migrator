package com.fictionalbank.payments.rules;

import com.fictionalbank.model.CardsCase0046;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0080 High Value"
    ruleflow-group "payments-rules-0080"
    salience 10
when
    $o : CardsCase0046(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0080 Low Score"
    ruleflow-group "payments-rules-0080"
    salience 5
when
    $o : CardsCase0046(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0080 Standard"
    ruleflow-group "payments-rules-0080"
    salience 1
when
    $o : CardsCase0046(amount <= 4950, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

