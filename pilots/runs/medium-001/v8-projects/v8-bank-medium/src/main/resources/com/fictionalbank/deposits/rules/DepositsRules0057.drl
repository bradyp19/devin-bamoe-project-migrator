package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.PaymentsCase0034;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0057 High Value"
    ruleflow-group "deposits-rules-0057"
    salience 10
when
    $o : PaymentsCase0034(amount > 1700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0057 Low Score"
    ruleflow-group "deposits-rules-0057"
    salience 5
when
    $o : PaymentsCase0034(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0057 Standard"
    ruleflow-group "deposits-rules-0057"
    salience 1
when
    $o : PaymentsCase0034(amount <= 1700, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

