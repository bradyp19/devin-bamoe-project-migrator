package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudParty0047;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0074 High Value"
    ruleflow-group "kyc-rules-0074"
    salience 10
when
    $o : FraudParty0047(amount > 600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0074 Low Score"
    ruleflow-group "kyc-rules-0074"
    salience 5
when
    $o : FraudParty0047(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0074 Standard"
    ruleflow-group "kyc-rules-0074"
    salience 1
when
    $o : FraudParty0047(amount <= 600, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

