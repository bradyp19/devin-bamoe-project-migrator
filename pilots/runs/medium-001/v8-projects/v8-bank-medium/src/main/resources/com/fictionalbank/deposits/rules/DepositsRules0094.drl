package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycPayment0056;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0094 High Value"
    ruleflow-group "deposits-rules-0094"
    salience 10
when
    $o : KycPayment0056(amount > 1400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0094 Low Score"
    ruleflow-group "deposits-rules-0094"
    salience 5
when
    $o : KycPayment0056(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0094 Standard"
    ruleflow-group "deposits-rules-0094"
    salience 1
when
    $o : KycPayment0056(amount <= 1400, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

