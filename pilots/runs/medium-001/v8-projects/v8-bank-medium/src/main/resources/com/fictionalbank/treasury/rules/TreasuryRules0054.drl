package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.MortgageAccount0031;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0054 High Value"
    ruleflow-group "treasury-rules-0054"
    salience 10
when
    $o : MortgageAccount0031(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0054 Low Score"
    ruleflow-group "treasury-rules-0054"
    salience 5
when
    $o : MortgageAccount0031(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0054 Standard"
    ruleflow-group "treasury-rules-0054"
    salience 1
when
    $o : MortgageAccount0031(amount <= 3450, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

