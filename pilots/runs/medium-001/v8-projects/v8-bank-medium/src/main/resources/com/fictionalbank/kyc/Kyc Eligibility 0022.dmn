<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/kyc/eligibility0022" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0022" name="Kyc Eligibility 0022" namespace="https://fictionalbank.example/dmn/kyc/eligibility0022">
  <dmn:inputData id="_in0022_age" name="Age">
    <dmn:variable id="_in0022_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0022_amount" name="Amount">
    <dmn:variable id="_in0022_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0022" name="Eligible">
    <dmn:variable id="_dec0022_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0022a">
      <dmn:requiredInput href="#_in0022_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0022b">
      <dmn:requiredInput href="#_in0022_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0022" hitPolicy="FIRST">
      <dmn:input id="_dt0022_i1"><dmn:inputExpression id="_dt0022_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0022_i2"><dmn:inputExpression id="_dt0022_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0022_o1"/>
      <dmn:rule id="_dt0022_r1">
        <dmn:inputEntry id="_dt0022_r1a"><dmn:text>&lt; 24</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0022_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0022_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0022_r2">
        <dmn:inputEntry id="_dt0022_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0022_r2b"><dmn:text>&lt;= 12500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0022_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0022_r3">
        <dmn:inputEntry id="_dt0022_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0022_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0022_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
