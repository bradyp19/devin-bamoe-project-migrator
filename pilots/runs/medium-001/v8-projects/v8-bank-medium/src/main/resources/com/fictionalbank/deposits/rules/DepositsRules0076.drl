package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudApplicant0048;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0076 High Value"
    ruleflow-group "deposits-rules-0076"
    salience 10
when
    $o : FraudApplicant0048(amount > 2000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0076 Low Score"
    ruleflow-group "deposits-rules-0076"
    salience 5
when
    $o : FraudApplicant0048(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0076 Standard"
    ruleflow-group "deposits-rules-0076"
    salience 1
when
    $o : FraudApplicant0048(amount <= 2000, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

