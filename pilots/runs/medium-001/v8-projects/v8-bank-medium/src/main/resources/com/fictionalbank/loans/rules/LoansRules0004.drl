package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsParty0005;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0004 High Value"
    ruleflow-group "loans-rules-0004"
    salience 10
when
    $o : PaymentsParty0005(amount > 3400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0004 Low Score"
    ruleflow-group "loans-rules-0004"
    salience 5
when
    $o : PaymentsParty0005(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0004 Standard"
    ruleflow-group "loans-rules-0004"
    salience 1
when
    $o : PaymentsParty0005(amount <= 3400, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

