package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansPayment0038;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0066 High Value"
    ruleflow-group "treasury-rules-0066"
    salience 10
when
    $o : LoansPayment0038(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0066 Low Score"
    ruleflow-group "treasury-rules-0066"
    salience 5
when
    $o : LoansPayment0038(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0066 Standard"
    ruleflow-group "treasury-rules-0066"
    salience 1
when
    $o : LoansPayment0038(amount <= 2200, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

