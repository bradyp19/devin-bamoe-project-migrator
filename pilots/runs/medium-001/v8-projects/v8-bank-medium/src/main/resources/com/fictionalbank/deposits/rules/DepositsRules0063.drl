package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryApplicant0042;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0063 High Value"
    ruleflow-group "deposits-rules-0063"
    salience 10
when
    $o : TreasuryApplicant0042(amount > 2400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0063 Low Score"
    ruleflow-group "deposits-rules-0063"
    salience 5
when
    $o : TreasuryApplicant0042(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0063 Standard"
    ruleflow-group "deposits-rules-0063"
    salience 1
when
    $o : TreasuryApplicant0042(amount <= 2400, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

