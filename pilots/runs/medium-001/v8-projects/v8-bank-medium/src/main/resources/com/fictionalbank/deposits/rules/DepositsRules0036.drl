package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycAccount0019;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0036 High Value"
    ruleflow-group "deposits-rules-0036"
    salience 10
when
    $o : KycAccount0019(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0036 Low Score"
    ruleflow-group "deposits-rules-0036"
    salience 5
when
    $o : KycAccount0019(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0036 Standard"
    ruleflow-group "deposits-rules-0036"
    salience 1
when
    $o : KycAccount0019(amount <= 4900, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

