package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsPayment0026;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0048 High Value"
    ruleflow-group "treasury-rules-0048"
    salience 10
when
    $o : CardsPayment0026(amount > 4750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0048 Low Score"
    ruleflow-group "treasury-rules-0048"
    salience 5
when
    $o : CardsPayment0026(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0048 Standard"
    ruleflow-group "treasury-rules-0048"
    salience 1
when
    $o : CardsPayment0026(amount <= 4750, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

