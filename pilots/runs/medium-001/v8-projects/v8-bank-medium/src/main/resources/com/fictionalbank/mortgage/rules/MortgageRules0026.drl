package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudAccount0013;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0026 High Value"
    ruleflow-group "mortgage-rules-0026"
    salience 10
when
    $o : FraudAccount0013(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0026 Low Score"
    ruleflow-group "mortgage-rules-0026"
    salience 5
when
    $o : FraudAccount0013(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0026 Standard"
    ruleflow-group "mortgage-rules-0026"
    salience 1
when
    $o : FraudAccount0013(amount <= 800, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

