package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsPayment0032;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0056 High Value"
    ruleflow-group "treasury-rules-0056"
    salience 10
when
    $o : PaymentsPayment0032(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0056 Low Score"
    ruleflow-group "treasury-rules-0056"
    salience 5
when
    $o : PaymentsPayment0032(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0056 Standard"
    ruleflow-group "treasury-rules-0056"
    salience 1
when
    $o : PaymentsPayment0032(amount <= 3750, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

