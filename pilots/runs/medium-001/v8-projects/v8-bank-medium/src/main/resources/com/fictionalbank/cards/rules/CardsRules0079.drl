package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudApplicant0048;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0079 High Value"
    ruleflow-group "cards-rules-0079"
    salience 10
when
    $o : FraudApplicant0048(amount > 4600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0079 Low Score"
    ruleflow-group "cards-rules-0079"
    salience 5
when
    $o : FraudApplicant0048(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0079 Standard"
    ruleflow-group "cards-rules-0079"
    salience 1
when
    $o : FraudApplicant0048(amount <= 4600, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

