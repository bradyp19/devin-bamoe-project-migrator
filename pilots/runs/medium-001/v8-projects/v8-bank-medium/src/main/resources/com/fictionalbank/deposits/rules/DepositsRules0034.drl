package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudParty0023;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0034 High Value"
    ruleflow-group "deposits-rules-0034"
    salience 10
when
    $o : FraudParty0023(amount > 2650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0034 Low Score"
    ruleflow-group "deposits-rules-0034"
    salience 5
when
    $o : FraudParty0023(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0034 Standard"
    ruleflow-group "deposits-rules-0034"
    salience 1
when
    $o : FraudParty0023(amount <= 2650, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

