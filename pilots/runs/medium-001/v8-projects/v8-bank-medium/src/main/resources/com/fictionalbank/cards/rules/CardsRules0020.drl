package com.fictionalbank.cards.rules;

import com.fictionalbank.model.MortgageCard0009;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0020 High Value"
    ruleflow-group "cards-rules-0020"
    salience 10
when
    $o : MortgageCard0009(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0020 Low Score"
    ruleflow-group "cards-rules-0020"
    salience 5
when
    $o : MortgageCard0009(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0020 Standard"
    ruleflow-group "cards-rules-0020"
    salience 1
when
    $o : MortgageCard0009(amount <= 1550, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

