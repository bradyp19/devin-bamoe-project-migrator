package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgagePayment0002;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0005 High Value"
    ruleflow-group "deposits-rules-0005"
    salience 10
when
    $o : MortgagePayment0002(amount > 3600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0005 Low Score"
    ruleflow-group "deposits-rules-0005"
    salience 5
when
    $o : MortgagePayment0002(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0005 Standard"
    ruleflow-group "deposits-rules-0005"
    salience 1
when
    $o : MortgagePayment0002(amount <= 3600, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

