package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudParty0017;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0027 High Value"
    ruleflow-group "fraud-rules-0027"
    salience 10
when
    $o : FraudParty0017(amount > 1600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0027 Low Score"
    ruleflow-group "fraud-rules-0027"
    salience 5
when
    $o : FraudParty0017(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0027 Standard"
    ruleflow-group "fraud-rules-0027"
    salience 1
when
    $o : FraudParty0017(amount <= 1600, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

