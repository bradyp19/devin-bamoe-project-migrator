package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.LoansCard0015;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0021 High Value"
    ruleflow-group "mortgage-rules-0021"
    salience 10
when
    $o : LoansCard0015(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new LoansCard0015());
    update($o);
end

rule "Mortgage R0021 Low Score"
    ruleflow-group "mortgage-rules-0021"
    salience 5
when
    $o : LoansCard0015(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0021 Standard"
    ruleflow-group "mortgage-rules-0021"
    salience 1
when
    $o : LoansCard0015(amount <= 3150, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

