package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycAccount0001;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0009 High Value"
    ruleflow-group "kyc-rules-0009"
    salience 10
when
    $o : KycAccount0001(amount > 1050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0009 Low Score"
    ruleflow-group "kyc-rules-0009"
    salience 5
when
    $o : KycAccount0001(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0009 Standard"
    ruleflow-group "kyc-rules-0009"
    salience 1
when
    $o : KycAccount0001(amount <= 1050, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

