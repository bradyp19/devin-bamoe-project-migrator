<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/treasury/eligibility0014" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0014" name="Treasury Eligibility 0014" namespace="https://fictionalbank.example/dmn/treasury/eligibility0014">
  <dmn:inputData id="_in0014_age" name="Age">
    <dmn:variable id="_in0014_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0014_amount" name="Amount">
    <dmn:variable id="_in0014_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0014" name="Eligible">
    <dmn:variable id="_dec0014_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0014a">
      <dmn:requiredInput href="#_in0014_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0014b">
      <dmn:requiredInput href="#_in0014_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0014" hitPolicy="FIRST">
      <dmn:input id="_dt0014_i1"><dmn:inputExpression id="_dt0014_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0014_i2"><dmn:inputExpression id="_dt0014_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0014_o1"/>
      <dmn:rule id="_dt0014_r1">
        <dmn:inputEntry id="_dt0014_r1a"><dmn:text>&lt; 20</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0014_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0014_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0014_r2">
        <dmn:inputEntry id="_dt0014_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0014_r2b"><dmn:text>&lt;= 5000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0014_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0014_r3">
        <dmn:inputEntry id="_dt0014_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0014_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0014_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
