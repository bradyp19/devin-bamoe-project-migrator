package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsApplicant0060;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0095 High Value"
    ruleflow-group "kyc-rules-0095"
    salience 10
when
    $o : DepositsApplicant0060(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0095 Low Score"
    ruleflow-group "kyc-rules-0095"
    salience 5
when
    $o : DepositsApplicant0060(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0095 Standard"
    ruleflow-group "kyc-rules-0095"
    salience 1
when
    $o : DepositsApplicant0060(amount <= 3150, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

