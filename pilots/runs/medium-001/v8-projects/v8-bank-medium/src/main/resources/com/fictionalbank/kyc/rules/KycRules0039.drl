package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryApplicant0024;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0039 High Value"
    ruleflow-group "kyc-rules-0039"
    salience 10
when
    $o : TreasuryApplicant0024(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0039 Low Score"
    ruleflow-group "kyc-rules-0039"
    salience 5
when
    $o : TreasuryApplicant0024(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0039 Standard"
    ruleflow-group "kyc-rules-0039"
    salience 1
when
    $o : TreasuryApplicant0024(amount <= 3500, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

