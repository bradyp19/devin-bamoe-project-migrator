package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycCase0040;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0065 High Value"
    ruleflow-group "kyc-rules-0065"
    salience 10
when
    $o : KycCase0040(amount > 4150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0065 Low Score"
    ruleflow-group "kyc-rules-0065"
    salience 5
when
    $o : KycCase0040(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0065 Standard"
    ruleflow-group "kyc-rules-0065"
    salience 1
when
    $o : KycCase0040(amount <= 4150, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

