package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudCard0021;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0032 High Value"
    ruleflow-group "fraud-rules-0032"
    salience 10
when
    $o : FraudCard0021(amount > 2650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0032 Low Score"
    ruleflow-group "fraud-rules-0032"
    salience 5
when
    $o : FraudCard0021(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0032 Standard"
    ruleflow-group "fraud-rules-0032"
    salience 1
when
    $o : FraudCard0021(amount <= 2650, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

