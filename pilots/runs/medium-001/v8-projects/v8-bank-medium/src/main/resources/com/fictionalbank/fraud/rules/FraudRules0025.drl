package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansCard0015;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0025 High Value"
    ruleflow-group "fraud-rules-0025"
    salience 10
when
    $o : LoansCard0015(amount > 650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0025 Low Score"
    ruleflow-group "fraud-rules-0025"
    salience 5
when
    $o : LoansCard0015(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0025 Standard"
    ruleflow-group "fraud-rules-0025"
    salience 1
when
    $o : LoansCard0015(amount <= 650, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

