package com.fictionalbank.cards.rules;

import com.fictionalbank.model.LoansApplicant0054;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0088 High Value"
    ruleflow-group "cards-rules-0088"
    salience 10
when
    $o : LoansApplicant0054(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0088 Low Score"
    ruleflow-group "cards-rules-0088"
    salience 5
when
    $o : LoansApplicant0054(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0088 Standard"
    ruleflow-group "cards-rules-0088"
    salience 1
when
    $o : LoansApplicant0054(amount <= 700, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

