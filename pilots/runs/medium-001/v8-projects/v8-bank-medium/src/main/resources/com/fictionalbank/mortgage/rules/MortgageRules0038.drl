package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudCard0021;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0038 High Value"
    ruleflow-group "mortgage-rules-0038"
    salience 10
when
    $o : FraudCard0021(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0038 Low Score"
    ruleflow-group "mortgage-rules-0038"
    salience 5
when
    $o : FraudCard0021(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0038 Standard"
    ruleflow-group "mortgage-rules-0038"
    salience 1
when
    $o : FraudCard0021(amount <= 1550, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

