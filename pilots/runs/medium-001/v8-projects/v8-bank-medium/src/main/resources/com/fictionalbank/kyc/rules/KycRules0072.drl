package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudPayment0044;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0072 High Value"
    ruleflow-group "kyc-rules-0072"
    salience 10
when
    $o : FraudPayment0044(amount > 4250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0072 Low Score"
    ruleflow-group "kyc-rules-0072"
    salience 5
when
    $o : FraudPayment0044(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0072 Standard"
    ruleflow-group "kyc-rules-0072"
    salience 1
when
    $o : FraudPayment0044(amount <= 4250, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

