package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudParty0023;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0035 High Value"
    ruleflow-group "mortgage-rules-0035"
    salience 10
when
    $o : FraudParty0023(amount > 1450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0035 Low Score"
    ruleflow-group "mortgage-rules-0035"
    salience 5
when
    $o : FraudParty0023(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0035 Standard"
    ruleflow-group "mortgage-rules-0035"
    salience 1
when
    $o : FraudParty0023(amount <= 1450, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

