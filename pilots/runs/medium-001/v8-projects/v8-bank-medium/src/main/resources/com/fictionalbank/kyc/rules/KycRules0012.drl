package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryPayment0008;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0012 High Value"
    ruleflow-group "kyc-rules-0012"
    salience 10
when
    $o : TreasuryPayment0008(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0012 Low Score"
    ruleflow-group "kyc-rules-0012"
    salience 5
when
    $o : TreasuryPayment0008(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0012 Standard"
    ruleflow-group "kyc-rules-0012"
    salience 1
when
    $o : TreasuryPayment0008(amount <= 4900, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

