package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryCard0051;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0090 High Value"
    ruleflow-group "kyc-rules-0090"
    salience 10
when
    $o : TreasuryCard0051(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0090 Low Score"
    ruleflow-group "kyc-rules-0090"
    salience 5
when
    $o : TreasuryCard0051(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0090 Standard"
    ruleflow-group "kyc-rules-0090"
    salience 1
when
    $o : TreasuryCard0051(amount <= 3500, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

