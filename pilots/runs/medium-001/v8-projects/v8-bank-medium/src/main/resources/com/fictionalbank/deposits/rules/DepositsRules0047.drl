package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.PaymentsApplicant0030;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0047 High Value"
    ruleflow-group "deposits-rules-0047"
    salience 10
when
    $o : PaymentsApplicant0030(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0047 Low Score"
    ruleflow-group "deposits-rules-0047"
    salience 5
when
    $o : PaymentsApplicant0030(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0047 Standard"
    ruleflow-group "deposits-rules-0047"
    salience 1
when
    $o : PaymentsApplicant0030(amount <= 700, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

