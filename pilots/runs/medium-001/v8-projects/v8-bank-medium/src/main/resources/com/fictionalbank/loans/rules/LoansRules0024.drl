package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansCard0015;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0024 High Value"
    ruleflow-group "loans-rules-0024"
    salience 10
when
    $o : LoansCard0015(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0024 Low Score"
    ruleflow-group "loans-rules-0024"
    salience 5
when
    $o : LoansCard0015(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0024 Standard"
    ruleflow-group "loans-rules-0024"
    salience 1
when
    $o : LoansCard0015(amount <= 700, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

