package com.fictionalbank.loans.rules;

import com.fictionalbank.model.FraudAccount0025;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0043 High Value"
    ruleflow-group "loans-rules-0043"
    salience 10
when
    $o : FraudAccount0025(amount > 4100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0043 Low Score"
    ruleflow-group "loans-rules-0043"
    salience 5
when
    $o : FraudAccount0025(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0043 Standard"
    ruleflow-group "loans-rules-0043"
    salience 1
when
    $o : FraudAccount0025(amount <= 4100, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

