package com.fictionalbank.cards.rules;

import com.fictionalbank.model.TreasuryCase0016;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0022 High Value"
    ruleflow-group "cards-rules-0022"
    salience 10
when
    $o : TreasuryCase0016(amount > 2050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0022 Low Score"
    ruleflow-group "cards-rules-0022"
    salience 5
when
    $o : TreasuryCase0016(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0022 Standard"
    ruleflow-group "cards-rules-0022"
    salience 1
when
    $o : TreasuryCase0016(amount <= 2050, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

