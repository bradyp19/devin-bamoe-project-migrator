package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryCard0039;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0064 High Value"
    ruleflow-group "payments-rules-0064"
    salience 10
when
    $o : TreasuryCard0039(amount > 1200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0064 Low Score"
    ruleflow-group "payments-rules-0064"
    salience 5
when
    $o : TreasuryCard0039(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0064 Standard"
    ruleflow-group "payments-rules-0064"
    salience 1
when
    $o : TreasuryCard0039(amount <= 1200, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

