package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryCard0051;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0082 High Value"
    ruleflow-group "payments-rules-0082"
    salience 10
when
    $o : TreasuryCard0051(amount > 2750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0082 Low Score"
    ruleflow-group "payments-rules-0082"
    salience 5
when
    $o : TreasuryCard0051(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0082 Standard"
    ruleflow-group "payments-rules-0082"
    salience 1
when
    $o : TreasuryCard0051(amount <= 2750, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

