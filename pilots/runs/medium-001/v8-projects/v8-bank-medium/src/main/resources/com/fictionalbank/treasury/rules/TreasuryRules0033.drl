package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.FraudParty0023;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0033 High Value"
    ruleflow-group "treasury-rules-0033"
    salience 10
when
    $o : FraudParty0023(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0033 Low Score"
    ruleflow-group "treasury-rules-0033"
    salience 5
when
    $o : FraudParty0023(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0033 Standard"
    ruleflow-group "treasury-rules-0033"
    salience 1
when
    $o : FraudParty0023(amount <= 3750, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

