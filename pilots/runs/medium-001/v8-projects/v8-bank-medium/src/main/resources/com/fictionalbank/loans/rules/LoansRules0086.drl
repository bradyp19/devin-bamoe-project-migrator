package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryCard0051;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0086 High Value"
    ruleflow-group "loans-rules-0086"
    salience 10
when
    $o : TreasuryCard0051(amount > 2700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0086 Low Score"
    ruleflow-group "loans-rules-0086"
    salience 5
when
    $o : TreasuryCard0051(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0086 Standard"
    ruleflow-group "loans-rules-0086"
    salience 1
when
    $o : TreasuryCard0051(amount <= 2700, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

