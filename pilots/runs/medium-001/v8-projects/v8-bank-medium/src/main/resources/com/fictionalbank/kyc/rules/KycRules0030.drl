package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.LoansCard0015;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0030 High Value"
    ruleflow-group "kyc-rules-0030"
    salience 10
when
    $o : LoansCard0015(amount > 2850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0030 Low Score"
    ruleflow-group "kyc-rules-0030"
    salience 5
when
    $o : LoansCard0015(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0030 Standard"
    ruleflow-group "kyc-rules-0030"
    salience 1
when
    $o : LoansCard0015(amount <= 2850, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

