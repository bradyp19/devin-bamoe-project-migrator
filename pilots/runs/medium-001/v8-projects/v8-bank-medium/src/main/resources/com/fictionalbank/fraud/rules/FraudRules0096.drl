package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCase0058;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0096 High Value"
    ruleflow-group "fraud-rules-0096"
    salience 10
when
    $o : TreasuryCase0058(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0096 Low Score"
    ruleflow-group "fraud-rules-0096"
    salience 5
when
    $o : TreasuryCase0058(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0096 Standard"
    ruleflow-group "fraud-rules-0096"
    salience 1
when
    $o : TreasuryCase0058(amount <= 3750, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

