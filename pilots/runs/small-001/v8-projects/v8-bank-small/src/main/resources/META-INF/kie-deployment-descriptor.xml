<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<deployment-descriptor xsi:schemaLocation="http://www.jboss.org/jbpm deployment-descriptor.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <persistence-unit>org.jbpm.domain</persistence-unit>
  <audit-persistence-unit>org.jbpm.domain</audit-persistence-unit>
  <audit-mode>JPA</audit-mode>
  <persistence-mode>JPA</persistence-mode>
  <runtime-strategy>PER_PROCESS_INSTANCE</runtime-strategy>
  <event-listeners>
    <event-listener>
      <resolver>reflection</resolver>
      <identifier>com.fictionalbank.listener.ProcessAuditListener0001</identifier>
      <parameters/>
    </event-listener>
  </event-listeners>
  <task-event-listeners>
    <task-event-listener>
      <resolver>reflection</resolver>
      <identifier>com.fictionalbank.listener.TaskAuditListener0002</identifier>
      <parameters/>
    </task-event-listener>
  </task-event-listeners>
  <work-item-handlers>
    <work-item-handler>
      <resolver>mvel</resolver>
      <identifier>new com.fictionalbank.handler.SanctionsScreen0001WorkItemHandler()</identifier>
      <parameters/>
      <name>SanctionsScreen0001</name>
    </work-item-handler>
    <work-item-handler>
      <resolver>mvel</resolver>
      <identifier>new com.fictionalbank.handler.LedgerPosting0002WorkItemHandler()</identifier>
      <parameters/>
      <name>LedgerPosting0002</name>
    </work-item-handler>
  </work-item-handlers>
  <required-roles/>
  <limit-serialization-classes>true</limit-serialization-classes>
</deployment-descriptor>
