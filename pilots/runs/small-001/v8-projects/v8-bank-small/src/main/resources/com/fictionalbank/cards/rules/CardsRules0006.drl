package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycCase0004;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0006 High Value"
    ruleflow-group "cards-rules-0006"
    salience 10
when
    $o : KycCase0004(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0006 Low Score"
    ruleflow-group "cards-rules-0006"
    salience 5
when
    $o : KycCase0004(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0006 Standard"
    ruleflow-group "cards-rules-0006"
    salience 1
when
    $o : KycCase0004(amount <= 3050, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

