package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.KycParty0005;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0004 High Value"
    ruleflow-group "mortgage-rules-0004"
    salience 10
when
    $o : KycParty0005(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0004 Low Score"
    ruleflow-group "mortgage-rules-0004"
    salience 5
when
    $o : KycParty0005(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0004 Standard"
    ruleflow-group "mortgage-rules-0004"
    salience 1
when
    $o : KycParty0005(amount <= 2550, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

