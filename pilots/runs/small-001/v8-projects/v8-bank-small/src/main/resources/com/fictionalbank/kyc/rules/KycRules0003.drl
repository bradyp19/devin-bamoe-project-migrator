package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.LoansApplicant0006;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0003 High Value"
    ruleflow-group "kyc-rules-0003"
    salience 10
when
    $o : LoansApplicant0006(amount > 4200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0003 Low Score"
    ruleflow-group "kyc-rules-0003"
    salience 5
when
    $o : LoansApplicant0006(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0003 Standard"
    ruleflow-group "kyc-rules-0003"
    salience 1
when
    $o : LoansApplicant0006(amount <= 4200, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

