package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryAccount0001;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0010 High Value"
    ruleflow-group "mortgage-rules-0010"
    salience 10
when
    $o : TreasuryAccount0001(amount > 4750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0010 Low Score"
    ruleflow-group "mortgage-rules-0010"
    salience 5
when
    $o : TreasuryAccount0001(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0010 Standard"
    ruleflow-group "mortgage-rules-0010"
    salience 1
when
    $o : TreasuryAccount0001(amount <= 4750, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

