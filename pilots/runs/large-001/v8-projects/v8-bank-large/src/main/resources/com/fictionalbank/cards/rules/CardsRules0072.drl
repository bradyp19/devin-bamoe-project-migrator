package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsPayment0044;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0072 High Value"
    ruleflow-group "cards-rules-0072"
    salience 10
when
    $o : DepositsPayment0044(amount > 1900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0072 Low Score"
    ruleflow-group "cards-rules-0072"
    salience 5
when
    $o : DepositsPayment0044(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0072 Standard"
    ruleflow-group "cards-rules-0072"
    salience 1
when
    $o : DepositsPayment0044(amount <= 1900, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

