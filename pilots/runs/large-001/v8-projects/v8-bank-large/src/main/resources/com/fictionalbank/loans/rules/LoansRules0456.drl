package com.fictionalbank.loans.rules;

import com.fictionalbank.model.FraudCard0273;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0456 High Value"
    ruleflow-group "loans-rules-0456"
    salience 10
when
    $o : FraudCard0273(amount > 4500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0456 Low Score"
    ruleflow-group "loans-rules-0456"
    salience 5
when
    $o : FraudCard0273(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0456 Standard"
    ruleflow-group "loans-rules-0456"
    salience 1
when
    $o : FraudCard0273(amount <= 4500, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

