package com.fictionalbank.cards.rules;

import com.fictionalbank.model.CardsAccount0181;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0309 High Value"
    ruleflow-group "cards-rules-0309"
    salience 10
when
    $o : CardsAccount0181(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0309 Low Score"
    ruleflow-group "cards-rules-0309"
    salience 5
when
    $o : CardsAccount0181(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0309 Standard"
    ruleflow-group "cards-rules-0309"
    salience 1
when
    $o : CardsAccount0181(amount <= 4950, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

