package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsParty0161;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0264 High Value"
    ruleflow-group "fraud-rules-0264"
    salience 10
when
    $o : PaymentsParty0161(amount > 3200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0264 Low Score"
    ruleflow-group "fraud-rules-0264"
    salience 5
when
    $o : PaymentsParty0161(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0264 Standard"
    ruleflow-group "fraud-rules-0264"
    salience 1
when
    $o : PaymentsParty0161(amount <= 3200, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

