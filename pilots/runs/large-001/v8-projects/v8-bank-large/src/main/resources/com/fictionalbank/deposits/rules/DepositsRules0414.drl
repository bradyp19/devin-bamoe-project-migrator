package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsCard0249;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0414 High Value"
    ruleflow-group "deposits-rules-0414"
    salience 10
when
    $o : DepositsCard0249(amount > 2750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0414 Low Score"
    ruleflow-group "deposits-rules-0414"
    salience 5
when
    $o : DepositsCard0249(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0414 Standard"
    ruleflow-group "deposits-rules-0414"
    salience 1
when
    $o : DepositsCard0249(amount <= 2750, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

