package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsCard0117;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0194 High Value"
    ruleflow-group "loans-rules-0194"
    salience 10
when
    $o : PaymentsCard0117(amount > 4650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0194 Low Score"
    ruleflow-group "loans-rules-0194"
    salience 5
when
    $o : PaymentsCard0117(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0194 Standard"
    ruleflow-group "loans-rules-0194"
    salience 1
when
    $o : PaymentsCard0117(amount <= 4650, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

