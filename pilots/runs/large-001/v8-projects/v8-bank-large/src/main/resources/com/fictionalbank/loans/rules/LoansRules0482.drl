package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsApplicant0294;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0482 High Value"
    ruleflow-group "loans-rules-0482"
    salience 10
when
    $o : PaymentsApplicant0294(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0482 Low Score"
    ruleflow-group "loans-rules-0482"
    salience 5
when
    $o : PaymentsApplicant0294(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0482 Standard"
    ruleflow-group "loans-rules-0482"
    salience 1
when
    $o : PaymentsApplicant0294(amount <= 2950, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

