package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansParty0005;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0005 High Value"
    ruleflow-group "treasury-rules-0005"
    salience 10
when
    $o : LoansParty0005(amount > 1300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0005 Low Score"
    ruleflow-group "treasury-rules-0005"
    salience 5
when
    $o : LoansParty0005(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0005 Standard"
    ruleflow-group "treasury-rules-0005"
    salience 1
when
    $o : LoansParty0005(amount <= 1300, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

