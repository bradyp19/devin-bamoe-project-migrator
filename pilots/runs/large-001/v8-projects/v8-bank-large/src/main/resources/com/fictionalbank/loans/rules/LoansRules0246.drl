package com.fictionalbank.loans.rules;

import com.fictionalbank.model.CardsCase0148;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0246 High Value"
    ruleflow-group "loans-rules-0246"
    salience 10
when
    $o : CardsCase0148(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0246 Low Score"
    ruleflow-group "loans-rules-0246"
    salience 5
when
    $o : CardsCase0148(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0246 Standard"
    ruleflow-group "loans-rules-0246"
    salience 1
when
    $o : CardsCase0148(amount <= 3650, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

