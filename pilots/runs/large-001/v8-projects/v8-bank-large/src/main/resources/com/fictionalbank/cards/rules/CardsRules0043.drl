package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudCase0028;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0043 High Value"
    ruleflow-group "cards-rules-0043"
    salience 10
when
    $o : FraudCase0028(amount > 4100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0043 Low Score"
    ruleflow-group "cards-rules-0043"
    salience 5
when
    $o : FraudCase0028(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0043 Standard"
    ruleflow-group "cards-rules-0043"
    salience 1
when
    $o : FraudCase0028(amount <= 4100, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

