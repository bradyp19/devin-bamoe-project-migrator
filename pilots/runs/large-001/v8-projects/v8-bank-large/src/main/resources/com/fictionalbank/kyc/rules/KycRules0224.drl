package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.MortgageCase0136;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0224 High Value"
    ruleflow-group "kyc-rules-0224"
    salience 10
when
    $o : MortgageCase0136(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0224 Low Score"
    ruleflow-group "kyc-rules-0224"
    salience 5
when
    $o : MortgageCase0136(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0224 Standard"
    ruleflow-group "kyc-rules-0224"
    salience 1
when
    $o : MortgageCase0136(amount <= 4350, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

