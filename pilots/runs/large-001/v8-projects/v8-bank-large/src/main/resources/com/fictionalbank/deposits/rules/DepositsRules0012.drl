package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryCase0010;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0012 High Value"
    ruleflow-group "deposits-rules-0012"
    salience 10
when
    $o : TreasuryCase0010(amount > 4050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0012 Low Score"
    ruleflow-group "deposits-rules-0012"
    salience 5
when
    $o : TreasuryCase0010(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0012 Standard"
    ruleflow-group "deposits-rules-0012"
    salience 1
when
    $o : TreasuryCase0010(amount <= 4050, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

