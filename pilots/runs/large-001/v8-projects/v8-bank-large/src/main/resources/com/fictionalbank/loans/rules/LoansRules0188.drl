package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsApplicant0114;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0188 High Value"
    ruleflow-group "loans-rules-0188"
    salience 10
when
    $o : DepositsApplicant0114(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0188 Low Score"
    ruleflow-group "loans-rules-0188"
    salience 5
when
    $o : DepositsApplicant0114(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0188 Standard"
    ruleflow-group "loans-rules-0188"
    salience 1
when
    $o : DepositsApplicant0114(amount <= 800, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

