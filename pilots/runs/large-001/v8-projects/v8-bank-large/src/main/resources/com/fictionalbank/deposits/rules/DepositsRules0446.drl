package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudApplicant0270;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0446 High Value"
    ruleflow-group "deposits-rules-0446"
    salience 10
when
    $o : FraudApplicant0270(amount > 4500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0446 Low Score"
    ruleflow-group "deposits-rules-0446"
    salience 5
when
    $o : FraudApplicant0270(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0446 Standard"
    ruleflow-group "deposits-rules-0446"
    salience 1
when
    $o : FraudApplicant0270(amount <= 4500, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

