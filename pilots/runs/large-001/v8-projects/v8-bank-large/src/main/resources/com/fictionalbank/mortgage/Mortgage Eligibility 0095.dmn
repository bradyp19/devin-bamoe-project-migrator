<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="https://fictionalbank.example/dmn/mortgage/eligibility0095" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0095" name="Mortgage Eligibility 0095" namespace="https://fictionalbank.example/dmn/mortgage/eligibility0095">
  <dmn:inputData id="_in0095_age" name="Age">
    <dmn:variable id="_in0095_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0095_amount" name="Amount">
    <dmn:variable id="_in0095_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0095" name="Eligible">
    <dmn:variable id="_dec0095_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0095a">
      <dmn:requiredInput href="#_in0095_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0095b">
      <dmn:requiredInput href="#_in0095_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0095" hitPolicy="FIRST">
      <dmn:input id="_dt0095_i1"><dmn:inputExpression id="_dt0095_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0095_i2"><dmn:inputExpression id="_dt0095_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0095_o1"/>
      <dmn:rule id="_dt0095_r1">
        <dmn:inputEntry id="_dt0095_r1a"><dmn:text>&lt; 23</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0095_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0095_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0095_r2">
        <dmn:inputEntry id="_dt0095_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0095_r2b"><dmn:text>&lt;= 15500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0095_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0095_r3">
        <dmn:inputEntry id="_dt0095_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0095_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0095_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
