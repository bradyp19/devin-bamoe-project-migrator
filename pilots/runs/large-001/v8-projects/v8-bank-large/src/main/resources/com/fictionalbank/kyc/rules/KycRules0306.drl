package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsApplicant0186;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0306 High Value"
    ruleflow-group "kyc-rules-0306"
    salience 10
when
    $o : DepositsApplicant0186(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0306 Low Score"
    ruleflow-group "kyc-rules-0306"
    salience 5
when
    $o : DepositsApplicant0186(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0306 Standard"
    ruleflow-group "kyc-rules-0306"
    salience 1
when
    $o : DepositsApplicant0186(amount <= 2150, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

