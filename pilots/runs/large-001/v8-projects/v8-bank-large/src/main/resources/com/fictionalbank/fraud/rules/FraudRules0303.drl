package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudCase0184;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0303 High Value"
    ruleflow-group "fraud-rules-0303"
    salience 10
when
    $o : FraudCase0184(amount > 3800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0303 Low Score"
    ruleflow-group "fraud-rules-0303"
    salience 5
when
    $o : FraudCase0184(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0303 Standard"
    ruleflow-group "fraud-rules-0303"
    salience 1
when
    $o : FraudCase0184(amount <= 3800, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

