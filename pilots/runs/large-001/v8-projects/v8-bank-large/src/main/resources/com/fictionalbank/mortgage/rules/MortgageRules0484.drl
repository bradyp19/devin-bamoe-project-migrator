package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.MortgageAccount0289;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0484 High Value"
    ruleflow-group "mortgage-rules-0484"
    salience 10
when
    $o : MortgageAccount0289(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0484 Low Score"
    ruleflow-group "mortgage-rules-0484"
    salience 5
when
    $o : MortgageAccount0289(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0484 Standard"
    ruleflow-group "mortgage-rules-0484"
    salience 1
when
    $o : MortgageAccount0289(amount <= 3150, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

