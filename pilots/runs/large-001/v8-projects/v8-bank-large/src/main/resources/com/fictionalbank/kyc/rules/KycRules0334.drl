package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycCard0201;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0334 High Value"
    ruleflow-group "kyc-rules-0334"
    salience 10
when
    $o : KycCard0201(amount > 2250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0334 Low Score"
    ruleflow-group "kyc-rules-0334"
    salience 5
when
    $o : KycCard0201(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0334 Standard"
    ruleflow-group "kyc-rules-0334"
    salience 1
when
    $o : KycCard0201(amount <= 2250, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

