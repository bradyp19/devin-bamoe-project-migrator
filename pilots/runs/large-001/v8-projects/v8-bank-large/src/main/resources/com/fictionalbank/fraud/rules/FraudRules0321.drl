package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCase0196;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0321 High Value"
    ruleflow-group "fraud-rules-0321"
    salience 10
when
    $o : TreasuryCase0196(amount > 2700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new TreasuryCase0196());
    update($o);
end

rule "Fraud R0321 Low Score"
    ruleflow-group "fraud-rules-0321"
    salience 5
when
    $o : TreasuryCase0196(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0321 Standard"
    ruleflow-group "fraud-rules-0321"
    salience 1
when
    $o : TreasuryCase0196(amount <= 2700, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

