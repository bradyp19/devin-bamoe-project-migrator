package com.fictionalbank.payments.rules;

import com.fictionalbank.model.LoansCard0111;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0189 High Value"
    ruleflow-group "payments-rules-0189"
    salience 10
when
    $o : LoansCard0111(amount > 2400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0189 Low Score"
    ruleflow-group "payments-rules-0189"
    salience 5
when
    $o : LoansCard0111(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0189 Standard"
    ruleflow-group "payments-rules-0189"
    salience 1
when
    $o : LoansCard0111(amount <= 2400, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

