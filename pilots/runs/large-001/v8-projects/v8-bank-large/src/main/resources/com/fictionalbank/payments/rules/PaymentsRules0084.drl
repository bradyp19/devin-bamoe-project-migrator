package com.fictionalbank.payments.rules;

import com.fictionalbank.model.PaymentsApplicant0054;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0084 High Value"
    ruleflow-group "payments-rules-0084"
    salience 10
when
    $o : PaymentsApplicant0054(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0084 Low Score"
    ruleflow-group "payments-rules-0084"
    salience 5
when
    $o : PaymentsApplicant0054(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0084 Standard"
    ruleflow-group "payments-rules-0084"
    salience 1
when
    $o : PaymentsApplicant0054(amount <= 2150, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

