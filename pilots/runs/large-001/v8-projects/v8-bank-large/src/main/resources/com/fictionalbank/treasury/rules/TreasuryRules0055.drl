package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsAccount0031;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0055 High Value"
    ruleflow-group "treasury-rules-0055"
    salience 10
when
    $o : PaymentsAccount0031(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0055 Low Score"
    ruleflow-group "treasury-rules-0055"
    salience 5
when
    $o : PaymentsAccount0031(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0055 Standard"
    ruleflow-group "treasury-rules-0055"
    salience 1
when
    $o : PaymentsAccount0031(amount <= 950, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

