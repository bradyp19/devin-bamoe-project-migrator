package com.fictionalbank.payments.rules;

import com.fictionalbank.model.PaymentsCase0298;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0491 High Value"
    ruleflow-group "payments-rules-0491"
    salience 10
when
    $o : PaymentsCase0298(amount > 2300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new PaymentsCase0298());
    update($o);
end

rule "Payments R0491 Low Score"
    ruleflow-group "payments-rules-0491"
    salience 5
when
    $o : PaymentsCase0298(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0491 Standard"
    ruleflow-group "payments-rules-0491"
    salience 1
when
    $o : PaymentsCase0298(amount <= 2300, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

