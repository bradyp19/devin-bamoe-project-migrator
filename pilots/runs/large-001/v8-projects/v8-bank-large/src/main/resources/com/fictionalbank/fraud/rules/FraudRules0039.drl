package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCase0022;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0039 High Value"
    ruleflow-group "fraud-rules-0039"
    salience 10
when
    $o : TreasuryCase0022(amount > 1700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0039 Low Score"
    ruleflow-group "fraud-rules-0039"
    salience 5
when
    $o : TreasuryCase0022(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0039 Standard"
    ruleflow-group "fraud-rules-0039"
    salience 1
when
    $o : TreasuryCase0022(amount <= 1700, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

