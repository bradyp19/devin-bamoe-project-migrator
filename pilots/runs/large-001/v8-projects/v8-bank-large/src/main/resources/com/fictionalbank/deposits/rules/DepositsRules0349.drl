package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycAccount0205;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0349 High Value"
    ruleflow-group "deposits-rules-0349"
    salience 10
when
    $o : KycAccount0205(amount > 600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0349 Low Score"
    ruleflow-group "deposits-rules-0349"
    salience 5
when
    $o : KycAccount0205(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0349 Standard"
    ruleflow-group "deposits-rules-0349"
    salience 1
when
    $o : KycAccount0205(amount <= 600, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

