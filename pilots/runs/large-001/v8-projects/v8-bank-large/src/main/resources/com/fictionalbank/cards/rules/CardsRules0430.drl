package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsApplicant0258;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0430 High Value"
    ruleflow-group "cards-rules-0430"
    salience 10
when
    $o : PaymentsApplicant0258(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0430 Low Score"
    ruleflow-group "cards-rules-0430"
    salience 5
when
    $o : PaymentsApplicant0258(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0430 Standard"
    ruleflow-group "cards-rules-0430"
    salience 1
when
    $o : PaymentsApplicant0258(amount <= 3500, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

