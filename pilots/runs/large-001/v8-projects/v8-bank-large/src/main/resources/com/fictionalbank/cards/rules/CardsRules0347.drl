package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudApplicant0210;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0347 High Value"
    ruleflow-group "cards-rules-0347"
    salience 10
when
    $o : FraudApplicant0210(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0347 Low Score"
    ruleflow-group "cards-rules-0347"
    salience 5
when
    $o : FraudApplicant0210(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0347 Standard"
    ruleflow-group "cards-rules-0347"
    salience 1
when
    $o : FraudApplicant0210(amount <= 1550, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

