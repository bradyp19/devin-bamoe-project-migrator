package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsCase0124;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0205 High Value"
    ruleflow-group "mortgage-rules-0205"
    salience 10
when
    $o : CardsCase0124(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0205 Low Score"
    ruleflow-group "mortgage-rules-0205"
    salience 5
when
    $o : CardsCase0124(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0205 Standard"
    ruleflow-group "mortgage-rules-0205"
    salience 1
when
    $o : CardsCase0124(amount <= 2900, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

