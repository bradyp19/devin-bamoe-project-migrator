package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.DepositsPayment0014;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0025 High Value"
    ruleflow-group "treasury-rules-0025"
    salience 10
when
    $o : DepositsPayment0014(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0025 Low Score"
    ruleflow-group "treasury-rules-0025"
    salience 5
when
    $o : DepositsPayment0014(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0025 Standard"
    ruleflow-group "treasury-rules-0025"
    salience 1
when
    $o : DepositsPayment0014(amount <= 3050, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

