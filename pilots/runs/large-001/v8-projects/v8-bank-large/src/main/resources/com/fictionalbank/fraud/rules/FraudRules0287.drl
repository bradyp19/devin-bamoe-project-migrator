package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsAccount0169;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0287 High Value"
    ruleflow-group "fraud-rules-0287"
    salience 10
when
    $o : PaymentsAccount0169(amount > 1600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0287 Low Score"
    ruleflow-group "fraud-rules-0287"
    salience 5
when
    $o : PaymentsAccount0169(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0287 Standard"
    ruleflow-group "fraud-rules-0287"
    salience 1
when
    $o : PaymentsAccount0169(amount <= 1600, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

