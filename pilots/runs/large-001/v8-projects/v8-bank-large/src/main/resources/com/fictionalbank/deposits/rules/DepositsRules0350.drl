package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudPayment0206;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0350 High Value"
    ruleflow-group "deposits-rules-0350"
    salience 10
when
    $o : FraudPayment0206(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0350 Low Score"
    ruleflow-group "deposits-rules-0350"
    salience 5
when
    $o : FraudPayment0206(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0350 Standard"
    ruleflow-group "deposits-rules-0350"
    salience 1
when
    $o : FraudPayment0206(amount <= 4350, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

