package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansApplicant0042;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0067 High Value"
    ruleflow-group "fraud-rules-0067"
    salience 10
when
    $o : LoansApplicant0042(amount > 1650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0067 Low Score"
    ruleflow-group "fraud-rules-0067"
    salience 5
when
    $o : LoansApplicant0042(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0067 Standard"
    ruleflow-group "fraud-rules-0067"
    salience 1
when
    $o : LoansApplicant0042(amount <= 1650, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

