package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsCase0112;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0184 High Value"
    ruleflow-group "fraud-rules-0184"
    salience 10
when
    $o : PaymentsCase0112(amount > 3400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0184 Low Score"
    ruleflow-group "fraud-rules-0184"
    salience 5
when
    $o : PaymentsCase0112(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0184 Standard"
    ruleflow-group "fraud-rules-0184"
    salience 1
when
    $o : PaymentsCase0112(amount <= 3400, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

