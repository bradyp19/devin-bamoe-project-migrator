package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgageParty0047;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0080 High Value"
    ruleflow-group "deposits-rules-0080"
    salience 10
when
    $o : MortgageParty0047(amount > 2850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0080 Low Score"
    ruleflow-group "deposits-rules-0080"
    salience 5
when
    $o : MortgageParty0047(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0080 Standard"
    ruleflow-group "deposits-rules-0080"
    salience 1
when
    $o : MortgageParty0047(amount <= 2850, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

