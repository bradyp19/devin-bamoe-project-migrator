package com.fictionalbank.loans.rules;

import com.fictionalbank.model.CardsPayment0212;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0352 High Value"
    ruleflow-group "loans-rules-0352"
    salience 10
when
    $o : CardsPayment0212(amount > 3550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0352 Low Score"
    ruleflow-group "loans-rules-0352"
    salience 5
when
    $o : CardsPayment0212(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0352 Standard"
    ruleflow-group "loans-rules-0352"
    salience 1
when
    $o : CardsPayment0212(amount <= 3550, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

