package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsApplicant0162;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0263 High Value"
    ruleflow-group "deposits-rules-0263"
    salience 10
when
    $o : DepositsApplicant0162(amount > 1600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0263 Low Score"
    ruleflow-group "deposits-rules-0263"
    salience 5
when
    $o : DepositsApplicant0162(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0263 Standard"
    ruleflow-group "deposits-rules-0263"
    salience 1
when
    $o : DepositsApplicant0162(amount <= 1600, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

