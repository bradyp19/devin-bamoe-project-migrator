package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudParty0071;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0111 High Value"
    ruleflow-group "kyc-rules-0111"
    salience 10
when
    $o : FraudParty0071(amount > 2500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new FraudParty0071());
    update($o);
end

rule "Kyc R0111 Low Score"
    ruleflow-group "kyc-rules-0111"
    salience 5
when
    $o : FraudParty0071(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0111 Standard"
    ruleflow-group "kyc-rules-0111"
    salience 1
when
    $o : FraudParty0071(amount <= 2500, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

