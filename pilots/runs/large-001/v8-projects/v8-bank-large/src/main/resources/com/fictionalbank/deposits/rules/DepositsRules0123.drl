package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsApplicant0078;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0123 High Value"
    ruleflow-group "deposits-rules-0123"
    salience 10
when
    $o : DepositsApplicant0078(amount > 600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0123 Low Score"
    ruleflow-group "deposits-rules-0123"
    salience 5
when
    $o : DepositsApplicant0078(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0123 Standard"
    ruleflow-group "deposits-rules-0123"
    salience 1
when
    $o : DepositsApplicant0078(amount <= 600, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

