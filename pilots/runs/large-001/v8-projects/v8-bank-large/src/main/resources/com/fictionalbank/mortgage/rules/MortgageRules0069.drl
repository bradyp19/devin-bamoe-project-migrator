package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryCard0039;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0069 High Value"
    ruleflow-group "mortgage-rules-0069"
    salience 10
when
    $o : TreasuryCard0039(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0069 Low Score"
    ruleflow-group "mortgage-rules-0069"
    salience 5
when
    $o : TreasuryCard0039(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0069 Standard"
    ruleflow-group "mortgage-rules-0069"
    salience 1
when
    $o : TreasuryCard0039(amount <= 3950, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

