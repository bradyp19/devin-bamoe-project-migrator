package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryAccount0097;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0162 High Value"
    ruleflow-group "mortgage-rules-0162"
    salience 10
when
    $o : TreasuryAccount0097(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0162 Low Score"
    ruleflow-group "mortgage-rules-0162"
    salience 5
when
    $o : TreasuryAccount0097(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0162 Standard"
    ruleflow-group "mortgage-rules-0162"
    salience 1
when
    $o : TreasuryAccount0097(amount <= 2550, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

