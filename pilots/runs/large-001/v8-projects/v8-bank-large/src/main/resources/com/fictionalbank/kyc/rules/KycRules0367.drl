package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsAccount0217;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0367 High Value"
    ruleflow-group "kyc-rules-0367"
    salience 10
when
    $o : CardsAccount0217(amount > 500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0367 Low Score"
    ruleflow-group "kyc-rules-0367"
    salience 5
when
    $o : CardsAccount0217(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0367 Standard"
    ruleflow-group "kyc-rules-0367"
    salience 1
when
    $o : CardsAccount0217(amount <= 500, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

