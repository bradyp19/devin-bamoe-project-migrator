package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.DepositsAccount0235;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0399 High Value"
    ruleflow-group "fraud-rules-0399"
    salience 10
when
    $o : DepositsAccount0235(amount > 1050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0399 Low Score"
    ruleflow-group "fraud-rules-0399"
    salience 5
when
    $o : DepositsAccount0235(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0399 Standard"
    ruleflow-group "fraud-rules-0399"
    salience 1
when
    $o : DepositsAccount0235(amount <= 1050, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

