<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="https://fictionalbank.example/dmn/kyc/eligibility0185" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0185" name="Kyc Eligibility 0185" namespace="https://fictionalbank.example/dmn/kyc/eligibility0185">
  <dmn:inputData id="_in0185_age" name="Age">
    <dmn:variable id="_in0185_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0185_amount" name="Amount">
    <dmn:variable id="_in0185_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0185" name="Eligible">
    <dmn:variable id="_dec0185_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0185a">
      <dmn:requiredInput href="#_in0185_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0185b">
      <dmn:requiredInput href="#_in0185_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0185" hitPolicy="FIRST">
      <dmn:input id="_dt0185_i1"><dmn:inputExpression id="_dt0185_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0185_i2"><dmn:inputExpression id="_dt0185_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0185_o1"/>
      <dmn:rule id="_dt0185_r1">
        <dmn:inputEntry id="_dt0185_r1a"><dmn:text>&lt; 23</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0185_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0185_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0185_r2">
        <dmn:inputEntry id="_dt0185_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0185_r2b"><dmn:text>&lt;= 19500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0185_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0185_r3">
        <dmn:inputEntry id="_dt0185_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0185_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0185_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
