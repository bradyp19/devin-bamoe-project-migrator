package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryAccount0271;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0460 High Value"
    ruleflow-group "loans-rules-0460"
    salience 10
when
    $o : TreasuryAccount0271(amount > 2450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0460 Low Score"
    ruleflow-group "loans-rules-0460"
    salience 5
when
    $o : TreasuryAccount0271(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0460 Standard"
    ruleflow-group "loans-rules-0460"
    salience 1
when
    $o : TreasuryAccount0271(amount <= 2450, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

