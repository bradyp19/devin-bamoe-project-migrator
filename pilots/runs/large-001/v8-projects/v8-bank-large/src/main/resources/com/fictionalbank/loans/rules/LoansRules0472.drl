package com.fictionalbank.loans.rules;

import com.fictionalbank.model.MortgageAccount0283;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0472 High Value"
    ruleflow-group "loans-rules-0472"
    salience 10
when
    $o : MortgageAccount0283(amount > 1700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0472 Low Score"
    ruleflow-group "loans-rules-0472"
    salience 5
when
    $o : MortgageAccount0283(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0472 Standard"
    ruleflow-group "loans-rules-0472"
    salience 1
when
    $o : MortgageAccount0283(amount <= 1700, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

