package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycAccount0175;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0300 High Value"
    ruleflow-group "deposits-rules-0300"
    salience 10
when
    $o : KycAccount0175(amount > 3300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0300 Low Score"
    ruleflow-group "deposits-rules-0300"
    salience 5
when
    $o : KycAccount0175(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0300 Standard"
    ruleflow-group "deposits-rules-0300"
    salience 1
when
    $o : KycAccount0175(amount <= 3300, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

