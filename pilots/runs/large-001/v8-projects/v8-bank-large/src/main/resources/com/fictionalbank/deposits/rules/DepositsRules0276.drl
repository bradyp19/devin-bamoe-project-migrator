package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCase0166;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0276 High Value"
    ruleflow-group "deposits-rules-0276"
    salience 10
when
    $o : FraudCase0166(amount > 850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0276 Low Score"
    ruleflow-group "deposits-rules-0276"
    salience 5
when
    $o : FraudCase0166(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0276 Standard"
    ruleflow-group "deposits-rules-0276"
    salience 1
when
    $o : FraudCase0166(amount <= 850, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

