package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudParty0029;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0047 High Value"
    ruleflow-group "fraud-rules-0047"
    salience 10
when
    $o : FraudParty0029(amount > 900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0047 Low Score"
    ruleflow-group "fraud-rules-0047"
    salience 5
when
    $o : FraudParty0029(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0047 Standard"
    ruleflow-group "fraud-rules-0047"
    salience 1
when
    $o : FraudParty0029(amount <= 900, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

