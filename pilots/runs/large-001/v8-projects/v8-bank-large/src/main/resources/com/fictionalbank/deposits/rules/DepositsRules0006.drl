package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudApplicant0006;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0006 High Value"
    ruleflow-group "deposits-rules-0006"
    salience 10
when
    $o : FraudApplicant0006(amount > 3550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0006 Low Score"
    ruleflow-group "deposits-rules-0006"
    salience 5
when
    $o : FraudApplicant0006(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0006 Standard"
    ruleflow-group "deposits-rules-0006"
    salience 1
when
    $o : FraudApplicant0006(amount <= 3550, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

