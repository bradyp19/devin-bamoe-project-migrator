package com.fictionalbank.cards.rules;

import com.fictionalbank.model.TreasuryCase0052;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0089 High Value"
    ruleflow-group "cards-rules-0089"
    salience 10
when
    $o : TreasuryCase0052(amount > 1400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0089 Low Score"
    ruleflow-group "cards-rules-0089"
    salience 5
when
    $o : TreasuryCase0052(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0089 Standard"
    ruleflow-group "cards-rules-0089"
    salience 1
when
    $o : TreasuryCase0052(amount <= 1400, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

