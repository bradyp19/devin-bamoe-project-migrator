package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudAccount0229;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0390 High Value"
    ruleflow-group "cards-rules-0390"
    salience 10
when
    $o : FraudAccount0229(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0390 Low Score"
    ruleflow-group "cards-rules-0390"
    salience 5
when
    $o : FraudAccount0229(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0390 Standard"
    ruleflow-group "cards-rules-0390"
    salience 1
when
    $o : FraudAccount0229(amount <= 3750, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

