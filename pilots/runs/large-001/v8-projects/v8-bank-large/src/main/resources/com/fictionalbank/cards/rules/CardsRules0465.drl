package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsApplicant0282;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0465 High Value"
    ruleflow-group "cards-rules-0465"
    salience 10
when
    $o : DepositsApplicant0282(amount > 550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0465 Low Score"
    ruleflow-group "cards-rules-0465"
    salience 5
when
    $o : DepositsApplicant0282(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0465 Standard"
    ruleflow-group "cards-rules-0465"
    salience 1
when
    $o : DepositsApplicant0282(amount <= 550, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

