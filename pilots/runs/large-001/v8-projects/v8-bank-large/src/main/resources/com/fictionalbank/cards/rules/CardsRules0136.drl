package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudApplicant0084;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0136 High Value"
    ruleflow-group "cards-rules-0136"
    salience 10
when
    $o : FraudApplicant0084(amount > 3000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0136 Low Score"
    ruleflow-group "cards-rules-0136"
    salience 5
when
    $o : FraudApplicant0084(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0136 Standard"
    ruleflow-group "cards-rules-0136"
    salience 1
when
    $o : FraudApplicant0084(amount <= 3000, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

