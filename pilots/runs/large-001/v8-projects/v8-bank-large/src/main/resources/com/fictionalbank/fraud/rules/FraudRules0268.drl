package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.MortgageCard0159;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0268 High Value"
    ruleflow-group "fraud-rules-0268"
    salience 10
when
    $o : MortgageCard0159(amount > 3700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0268 Low Score"
    ruleflow-group "fraud-rules-0268"
    salience 5
when
    $o : MortgageCard0159(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0268 Standard"
    ruleflow-group "fraud-rules-0268"
    salience 1
when
    $o : MortgageCard0159(amount <= 3700, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

