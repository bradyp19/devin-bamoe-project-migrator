package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.LoansApplicant0198;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0327 High Value"
    ruleflow-group "deposits-rules-0327"
    salience 10
when
    $o : LoansApplicant0198(amount > 2750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0327 Low Score"
    ruleflow-group "deposits-rules-0327"
    salience 5
when
    $o : LoansApplicant0198(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0327 Standard"
    ruleflow-group "deposits-rules-0327"
    salience 1
when
    $o : LoansApplicant0198(amount <= 2750, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

