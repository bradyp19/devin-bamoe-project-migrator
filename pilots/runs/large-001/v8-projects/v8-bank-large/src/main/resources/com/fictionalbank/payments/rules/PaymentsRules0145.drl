package com.fictionalbank.payments.rules;

import com.fictionalbank.model.PaymentsAccount0085;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0145 High Value"
    ruleflow-group "payments-rules-0145"
    salience 10
when
    $o : PaymentsAccount0085(amount > 600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0145 Low Score"
    ruleflow-group "payments-rules-0145"
    salience 5
when
    $o : PaymentsAccount0085(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0145 Standard"
    ruleflow-group "payments-rules-0145"
    salience 1
when
    $o : PaymentsAccount0085(amount <= 600, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

