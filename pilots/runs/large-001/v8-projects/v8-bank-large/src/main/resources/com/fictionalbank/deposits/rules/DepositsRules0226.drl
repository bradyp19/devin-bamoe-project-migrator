package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgageCase0136;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0226 High Value"
    ruleflow-group "deposits-rules-0226"
    salience 10
when
    $o : MortgageCase0136(amount > 1150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0226 Low Score"
    ruleflow-group "deposits-rules-0226"
    salience 5
when
    $o : MortgageCase0136(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0226 Standard"
    ruleflow-group "deposits-rules-0226"
    salience 1
when
    $o : MortgageCase0136(amount <= 1150, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

