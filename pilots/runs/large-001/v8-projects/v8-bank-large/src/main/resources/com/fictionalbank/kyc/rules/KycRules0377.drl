package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.LoansAccount0223;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0377 High Value"
    ruleflow-group "kyc-rules-0377"
    salience 10
when
    $o : LoansAccount0223(amount > 2100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0377 Low Score"
    ruleflow-group "kyc-rules-0377"
    salience 5
when
    $o : LoansAccount0223(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0377 Standard"
    ruleflow-group "kyc-rules-0377"
    salience 1
when
    $o : LoansAccount0223(amount <= 2100, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

