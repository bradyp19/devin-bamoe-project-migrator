package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsCase0124;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0202 High Value"
    ruleflow-group "mortgage-rules-0202"
    salience 10
when
    $o : CardsCase0124(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0202 Low Score"
    ruleflow-group "mortgage-rules-0202"
    salience 5
when
    $o : CardsCase0124(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0202 Standard"
    ruleflow-group "mortgage-rules-0202"
    salience 1
when
    $o : CardsCase0124(amount <= 800, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

