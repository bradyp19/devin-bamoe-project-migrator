package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudCard0009;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0013 High Value"
    ruleflow-group "cards-rules-0013"
    salience 10
when
    $o : FraudCard0009(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0013 Low Score"
    ruleflow-group "cards-rules-0013"
    salience 5
when
    $o : FraudCard0009(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0013 Standard"
    ruleflow-group "cards-rules-0013"
    salience 1
when
    $o : FraudCard0009(amount <= 4350, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

