package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsCard0015;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0027 High Value"
    ruleflow-group "kyc-rules-0027"
    salience 10
when
    $o : PaymentsCard0015(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0027 Low Score"
    ruleflow-group "kyc-rules-0027"
    salience 5
when
    $o : PaymentsCard0015(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0027 Standard"
    ruleflow-group "kyc-rules-0027"
    salience 1
when
    $o : PaymentsCard0015(amount <= 3950, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

