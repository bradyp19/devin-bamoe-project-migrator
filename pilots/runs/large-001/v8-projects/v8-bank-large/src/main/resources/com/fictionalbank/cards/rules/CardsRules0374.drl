package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsCase0226;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0374 High Value"
    ruleflow-group "cards-rules-0374"
    salience 10
when
    $o : PaymentsCase0226(amount > 3400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0374 Low Score"
    ruleflow-group "cards-rules-0374"
    salience 5
when
    $o : PaymentsCase0226(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0374 Standard"
    ruleflow-group "cards-rules-0374"
    salience 1
when
    $o : PaymentsCase0226(amount <= 3400, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

