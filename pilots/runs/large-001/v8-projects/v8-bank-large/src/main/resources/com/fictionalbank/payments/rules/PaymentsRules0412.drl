package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsCard0249;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0412 High Value"
    ruleflow-group "payments-rules-0412"
    salience 10
when
    $o : DepositsCard0249(amount > 900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0412 Low Score"
    ruleflow-group "payments-rules-0412"
    salience 5
when
    $o : DepositsCard0249(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0412 Standard"
    ruleflow-group "payments-rules-0412"
    salience 1
when
    $o : DepositsCard0249(amount <= 900, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

