package com.fictionalbank.cards.rules;

import com.fictionalbank.model.CardsApplicant0018;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0028 High Value"
    ruleflow-group "cards-rules-0028"
    salience 10
when
    $o : CardsApplicant0018(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0028 Low Score"
    ruleflow-group "cards-rules-0028"
    salience 5
when
    $o : CardsApplicant0018(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0028 Standard"
    ruleflow-group "cards-rules-0028"
    salience 1
when
    $o : CardsApplicant0018(amount <= 950, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

