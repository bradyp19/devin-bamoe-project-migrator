package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycCard0261;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0436 High Value"
    ruleflow-group "deposits-rules-0436"
    salience 10
when
    $o : KycCard0261(amount > 3550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0436 Low Score"
    ruleflow-group "deposits-rules-0436"
    salience 5
when
    $o : KycCard0261(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0436 Standard"
    ruleflow-group "deposits-rules-0436"
    salience 1
when
    $o : KycCard0261(amount <= 3550, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

