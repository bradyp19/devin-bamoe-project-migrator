package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryCase0196;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0323 High Value"
    ruleflow-group "mortgage-rules-0323"
    salience 10
when
    $o : TreasuryCase0196(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0323 Low Score"
    ruleflow-group "mortgage-rules-0323"
    salience 5
when
    $o : TreasuryCase0196(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0323 Standard"
    ruleflow-group "mortgage-rules-0323"
    salience 1
when
    $o : TreasuryCase0196(amount <= 3950, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

