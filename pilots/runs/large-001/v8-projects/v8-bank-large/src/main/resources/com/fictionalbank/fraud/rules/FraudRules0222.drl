package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudCard0135;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0222 High Value"
    ruleflow-group "fraud-rules-0222"
    salience 10
when
    $o : FraudCard0135(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0222 Low Score"
    ruleflow-group "fraud-rules-0222"
    salience 5
when
    $o : FraudCard0135(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0222 Standard"
    ruleflow-group "fraud-rules-0222"
    salience 1
when
    $o : FraudCard0135(amount <= 3750, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

