package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsCase0250;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0418 High Value"
    ruleflow-group "deposits-rules-0418"
    salience 10
when
    $o : DepositsCase0250(amount > 3850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0418 Low Score"
    ruleflow-group "deposits-rules-0418"
    salience 5
when
    $o : DepositsCase0250(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0418 Standard"
    ruleflow-group "deposits-rules-0418"
    salience 1
when
    $o : DepositsCase0250(amount <= 3850, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

