package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.MortgageCase0100;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0169 High Value"
    ruleflow-group "treasury-rules-0169"
    salience 10
when
    $o : MortgageCase0100(amount > 1050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0169 Low Score"
    ruleflow-group "treasury-rules-0169"
    salience 5
when
    $o : MortgageCase0100(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0169 Standard"
    ruleflow-group "treasury-rules-0169"
    salience 1
when
    $o : MortgageCase0100(amount <= 1050, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

