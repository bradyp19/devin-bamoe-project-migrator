package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsParty0215;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0355 High Value"
    ruleflow-group "kyc-rules-0355"
    salience 10
when
    $o : DepositsParty0215(amount > 3900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0355 Low Score"
    ruleflow-group "kyc-rules-0355"
    salience 5
when
    $o : DepositsParty0215(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0355 Standard"
    ruleflow-group "kyc-rules-0355"
    salience 1
when
    $o : DepositsParty0215(amount <= 3900, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

