package com.fictionalbank.payments.rules;

import com.fictionalbank.model.PaymentsPayment0152;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0255 High Value"
    ruleflow-group "payments-rules-0255"
    salience 10
when
    $o : PaymentsPayment0152(amount > 4300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0255 Low Score"
    ruleflow-group "payments-rules-0255"
    salience 5
when
    $o : PaymentsPayment0152(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0255 Standard"
    ruleflow-group "payments-rules-0255"
    salience 1
when
    $o : PaymentsPayment0152(amount <= 4300, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

