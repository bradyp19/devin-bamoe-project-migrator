package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.MortgageApplicant0030;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0044 High Value"
    ruleflow-group "treasury-rules-0044"
    salience 10
when
    $o : MortgageApplicant0030(amount > 2600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0044 Low Score"
    ruleflow-group "treasury-rules-0044"
    salience 5
when
    $o : MortgageApplicant0030(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0044 Standard"
    ruleflow-group "treasury-rules-0044"
    salience 1
when
    $o : MortgageApplicant0030(amount <= 2600, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

