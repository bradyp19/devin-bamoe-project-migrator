package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsCard0279;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0462 High Value"
    ruleflow-group "treasury-rules-0462"
    salience 10
when
    $o : PaymentsCard0279(amount > 2100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0462 Low Score"
    ruleflow-group "treasury-rules-0462"
    salience 5
when
    $o : PaymentsCard0279(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0462 Standard"
    ruleflow-group "treasury-rules-0462"
    salience 1
when
    $o : PaymentsCard0279(amount <= 2100, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

