package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsCard0165;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0280 High Value"
    ruleflow-group "fraud-rules-0280"
    salience 10
when
    $o : PaymentsCard0165(amount > 500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0280 Low Score"
    ruleflow-group "fraud-rules-0280"
    salience 5
when
    $o : PaymentsCard0165(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0280 Standard"
    ruleflow-group "fraud-rules-0280"
    salience 1
when
    $o : PaymentsCard0165(amount <= 500, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

