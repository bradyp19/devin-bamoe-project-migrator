package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCard0243;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0402 High Value"
    ruleflow-group "deposits-rules-0402"
    salience 10
when
    $o : FraudCard0243(amount > 1950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0402 Low Score"
    ruleflow-group "deposits-rules-0402"
    salience 5
when
    $o : FraudCard0243(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0402 Standard"
    ruleflow-group "deposits-rules-0402"
    salience 1
when
    $o : FraudCard0243(amount <= 1950, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

