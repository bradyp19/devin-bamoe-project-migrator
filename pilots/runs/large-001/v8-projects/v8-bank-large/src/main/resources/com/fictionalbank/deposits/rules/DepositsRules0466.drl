package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsApplicant0282;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0466 High Value"
    ruleflow-group "deposits-rules-0466"
    salience 10
when
    $o : DepositsApplicant0282(amount > 650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0466 Low Score"
    ruleflow-group "deposits-rules-0466"
    salience 5
when
    $o : DepositsApplicant0282(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0466 Standard"
    ruleflow-group "deposits-rules-0466"
    salience 1
when
    $o : DepositsApplicant0282(amount <= 650, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

