package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.MortgageAccount0295;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0500 High Value"
    ruleflow-group "treasury-rules-0500"
    salience 10
when
    $o : MortgageAccount0295(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0500 Low Score"
    ruleflow-group "treasury-rules-0500"
    salience 5
when
    $o : MortgageAccount0295(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0500 Standard"
    ruleflow-group "treasury-rules-0500"
    salience 1
when
    $o : MortgageAccount0295(amount <= 3150, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

