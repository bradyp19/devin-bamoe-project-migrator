package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.MortgageAccount0289;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0487 High Value"
    ruleflow-group "kyc-rules-0487"
    salience 10
when
    $o : MortgageAccount0289(amount > 3300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0487 Low Score"
    ruleflow-group "kyc-rules-0487"
    salience 5
when
    $o : MortgageAccount0289(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0487 Standard"
    ruleflow-group "kyc-rules-0487"
    salience 1
when
    $o : MortgageAccount0289(amount <= 3300, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

