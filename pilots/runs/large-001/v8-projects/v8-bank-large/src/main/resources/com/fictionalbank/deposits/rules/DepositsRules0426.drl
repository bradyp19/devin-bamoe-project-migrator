package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycPayment0254;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0426 High Value"
    ruleflow-group "deposits-rules-0426"
    salience 10
when
    $o : KycPayment0254(amount > 4100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0426 Low Score"
    ruleflow-group "deposits-rules-0426"
    salience 5
when
    $o : KycPayment0254(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0426 Standard"
    ruleflow-group "deposits-rules-0426"
    salience 1
when
    $o : KycPayment0254(amount <= 4100, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

