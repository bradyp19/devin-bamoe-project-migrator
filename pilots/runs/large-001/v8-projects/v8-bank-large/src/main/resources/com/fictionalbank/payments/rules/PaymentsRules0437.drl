package com.fictionalbank.payments.rules;

import com.fictionalbank.model.CardsPayment0260;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0437 High Value"
    ruleflow-group "payments-rules-0437"
    salience 10
when
    $o : CardsPayment0260(amount > 4300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0437 Low Score"
    ruleflow-group "payments-rules-0437"
    salience 5
when
    $o : CardsPayment0260(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0437 Standard"
    ruleflow-group "payments-rules-0437"
    salience 1
when
    $o : CardsPayment0260(amount <= 4300, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

