package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsPayment0200;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0339 High Value"
    ruleflow-group "mortgage-rules-0339"
    salience 10
when
    $o : DepositsPayment0200(amount > 1950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0339 Low Score"
    ruleflow-group "mortgage-rules-0339"
    salience 5
when
    $o : DepositsPayment0200(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0339 Standard"
    ruleflow-group "mortgage-rules-0339"
    salience 1
when
    $o : DepositsPayment0200(amount <= 1950, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

