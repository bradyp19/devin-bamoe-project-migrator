<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/cards/eligibility0007" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0007" name="Cards Eligibility 0007" namespace="https://fictionalbank.example/dmn/cards/eligibility0007">
  <dmn:inputData id="_in0007_age" name="Age">
    <dmn:variable id="_in0007_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0007_amount" name="Amount">
    <dmn:variable id="_in0007_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0007" name="Eligible">
    <dmn:variable id="_dec0007_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0007a">
      <dmn:requiredInput href="#_in0007_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0007b">
      <dmn:requiredInput href="#_in0007_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0007" hitPolicy="FIRST">
      <dmn:input id="_dt0007_i1"><dmn:inputExpression id="_dt0007_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0007_i2"><dmn:inputExpression id="_dt0007_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0007_o1"/>
      <dmn:rule id="_dt0007_r1">
        <dmn:inputEntry id="_dt0007_r1a"><dmn:text>&lt; 18</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0007_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0007_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0007_r2">
        <dmn:inputEntry id="_dt0007_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0007_r2b"><dmn:text>&lt;= 3000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0007_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0007_r3">
        <dmn:inputEntry id="_dt0007_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0007_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0007_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
