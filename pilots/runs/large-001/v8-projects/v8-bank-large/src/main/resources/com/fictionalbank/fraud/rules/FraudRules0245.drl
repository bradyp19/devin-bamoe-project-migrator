package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycApplicant0150;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0245 High Value"
    ruleflow-group "fraud-rules-0245"
    salience 10
when
    $o : KycApplicant0150(amount > 2400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0245 Low Score"
    ruleflow-group "fraud-rules-0245"
    salience 5
when
    $o : KycApplicant0150(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0245 Standard"
    ruleflow-group "fraud-rules-0245"
    salience 1
when
    $o : KycApplicant0150(amount <= 2400, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

