package com.fictionalbank.payments.rules;

import com.fictionalbank.model.PaymentsCard0087;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0141 High Value"
    ruleflow-group "payments-rules-0141"
    salience 10
when
    $o : PaymentsCard0087(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new PaymentsCard0087());
    update($o);
end

rule "Payments R0141 Low Score"
    ruleflow-group "payments-rules-0141"
    salience 5
when
    $o : PaymentsCard0087(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0141 Standard"
    ruleflow-group "payments-rules-0141"
    salience 1
when
    $o : PaymentsCard0087(amount <= 1000, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

