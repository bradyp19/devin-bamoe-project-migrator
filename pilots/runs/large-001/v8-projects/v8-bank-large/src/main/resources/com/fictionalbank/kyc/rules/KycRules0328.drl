package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsPayment0194;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0328 High Value"
    ruleflow-group "kyc-rules-0328"
    salience 10
when
    $o : CardsPayment0194(amount > 4450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0328 Low Score"
    ruleflow-group "kyc-rules-0328"
    salience 5
when
    $o : CardsPayment0194(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0328 Standard"
    ruleflow-group "kyc-rules-0328"
    salience 1
when
    $o : CardsPayment0194(amount <= 4450, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

