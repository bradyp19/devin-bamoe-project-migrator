package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsCase0202;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0340 High Value"
    ruleflow-group "fraud-rules-0340"
    salience 10
when
    $o : PaymentsCase0202(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0340 Low Score"
    ruleflow-group "fraud-rules-0340"
    salience 5
when
    $o : PaymentsCase0202(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0340 Standard"
    ruleflow-group "fraud-rules-0340"
    salience 1
when
    $o : PaymentsCase0202(amount <= 1000, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

