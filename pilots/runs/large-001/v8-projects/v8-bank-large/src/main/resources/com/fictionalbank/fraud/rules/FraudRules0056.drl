package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansParty0035;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0056 High Value"
    ruleflow-group "fraud-rules-0056"
    salience 10
when
    $o : LoansParty0035(amount > 2850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0056 Low Score"
    ruleflow-group "fraud-rules-0056"
    salience 5
when
    $o : LoansParty0035(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0056 Standard"
    ruleflow-group "fraud-rules-0056"
    salience 1
when
    $o : LoansParty0035(amount <= 2850, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

