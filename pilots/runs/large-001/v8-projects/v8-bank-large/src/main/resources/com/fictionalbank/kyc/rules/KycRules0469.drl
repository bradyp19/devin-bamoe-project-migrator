package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryAccount0277;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0469 High Value"
    ruleflow-group "kyc-rules-0469"
    salience 10
when
    $o : TreasuryAccount0277(amount > 4750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0469 Low Score"
    ruleflow-group "kyc-rules-0469"
    salience 5
when
    $o : TreasuryAccount0277(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0469 Standard"
    ruleflow-group "kyc-rules-0469"
    salience 1
when
    $o : TreasuryAccount0277(amount <= 4750, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

