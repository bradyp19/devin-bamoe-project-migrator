package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudCase0046;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0077 High Value"
    ruleflow-group "cards-rules-0077"
    salience 10
when
    $o : FraudCase0046(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0077 Low Score"
    ruleflow-group "cards-rules-0077"
    salience 5
when
    $o : FraudCase0046(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0077 Standard"
    ruleflow-group "cards-rules-0077"
    salience 1
when
    $o : FraudCase0046(amount <= 4900, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

