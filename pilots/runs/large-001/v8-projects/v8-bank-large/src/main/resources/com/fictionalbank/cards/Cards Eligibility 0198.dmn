<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/cards/eligibility0198" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0198" name="Cards Eligibility 0198" namespace="https://fictionalbank.example/dmn/cards/eligibility0198">
  <dmn:inputData id="_in0198_age" name="Age">
    <dmn:variable id="_in0198_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0198_amount" name="Amount">
    <dmn:variable id="_in0198_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0198" name="Eligible">
    <dmn:variable id="_dec0198_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0198a">
      <dmn:requiredInput href="#_in0198_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0198b">
      <dmn:requiredInput href="#_in0198_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0198" hitPolicy="FIRST">
      <dmn:input id="_dt0198_i1"><dmn:inputExpression id="_dt0198_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0198_i2"><dmn:inputExpression id="_dt0198_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0198_o1"/>
      <dmn:rule id="_dt0198_r1">
        <dmn:inputEntry id="_dt0198_r1a"><dmn:text>&lt; 20</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0198_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0198_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0198_r2">
        <dmn:inputEntry id="_dt0198_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0198_r2b"><dmn:text>&lt;= 16000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0198_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0198_r3">
        <dmn:inputEntry id="_dt0198_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0198_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0198_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
