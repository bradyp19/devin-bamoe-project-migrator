package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsCard0099;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0167 High Value"
    ruleflow-group "kyc-rules-0167"
    salience 10
when
    $o : PaymentsCard0099(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0167 Low Score"
    ruleflow-group "kyc-rules-0167"
    salience 5
when
    $o : PaymentsCard0099(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0167 Standard"
    ruleflow-group "kyc-rules-0167"
    salience 1
when
    $o : PaymentsCard0099(amount <= 2200, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

