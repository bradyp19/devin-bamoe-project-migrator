package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsAccount0169;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0284 High Value"
    ruleflow-group "kyc-rules-0284"
    salience 10
when
    $o : PaymentsAccount0169(amount > 1950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0284 Low Score"
    ruleflow-group "kyc-rules-0284"
    salience 5
when
    $o : PaymentsAccount0169(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0284 Standard"
    ruleflow-group "kyc-rules-0284"
    salience 1
when
    $o : PaymentsAccount0169(amount <= 1950, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

