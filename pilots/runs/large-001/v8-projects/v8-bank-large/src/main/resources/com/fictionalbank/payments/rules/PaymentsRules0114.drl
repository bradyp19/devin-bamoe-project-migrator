package com.fictionalbank.payments.rules;

import com.fictionalbank.model.LoansCase0070;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0114 High Value"
    ruleflow-group "payments-rules-0114"
    salience 10
when
    $o : LoansCase0070(amount > 1700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0114 Low Score"
    ruleflow-group "payments-rules-0114"
    salience 5
when
    $o : LoansCase0070(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0114 Standard"
    ruleflow-group "payments-rules-0114"
    salience 1
when
    $o : LoansCase0070(amount <= 1700, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

