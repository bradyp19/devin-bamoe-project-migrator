package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.DepositsCase0214;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0357 High Value"
    ruleflow-group "treasury-rules-0357"
    salience 10
when
    $o : DepositsCase0214(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0357 Low Score"
    ruleflow-group "treasury-rules-0357"
    salience 5
when
    $o : DepositsCase0214(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0357 Standard"
    ruleflow-group "treasury-rules-0357"
    salience 1
when
    $o : DepositsCase0214(amount <= 2150, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

