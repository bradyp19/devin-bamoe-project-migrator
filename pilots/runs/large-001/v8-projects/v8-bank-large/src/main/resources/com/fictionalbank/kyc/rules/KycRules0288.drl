package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycApplicant0174;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0288 High Value"
    ruleflow-group "kyc-rules-0288"
    salience 10
when
    $o : KycApplicant0174(amount > 1050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0288 Low Score"
    ruleflow-group "kyc-rules-0288"
    salience 5
when
    $o : KycApplicant0174(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0288 Standard"
    ruleflow-group "kyc-rules-0288"
    salience 1
when
    $o : KycApplicant0174(amount <= 1050, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

