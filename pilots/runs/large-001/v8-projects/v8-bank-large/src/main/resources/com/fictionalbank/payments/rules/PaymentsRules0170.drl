package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryParty0101;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0170 High Value"
    ruleflow-group "payments-rules-0170"
    salience 10
when
    $o : TreasuryParty0101(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0170 Low Score"
    ruleflow-group "payments-rules-0170"
    salience 5
when
    $o : TreasuryParty0101(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0170 Standard"
    ruleflow-group "payments-rules-0170"
    salience 1
when
    $o : TreasuryParty0101(amount <= 4350, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

