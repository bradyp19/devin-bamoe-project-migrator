package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgageParty0281;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0464 High Value"
    ruleflow-group "deposits-rules-0464"
    salience 10
when
    $o : MortgageParty0281(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0464 Low Score"
    ruleflow-group "deposits-rules-0464"
    salience 5
when
    $o : MortgageParty0281(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0464 Standard"
    ruleflow-group "deposits-rules-0464"
    salience 1
when
    $o : MortgageParty0281(amount <= 3650, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

