package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsApplicant0168;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0278 High Value"
    ruleflow-group "treasury-rules-0278"
    salience 10
when
    $o : PaymentsApplicant0168(amount > 3200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0278 Low Score"
    ruleflow-group "treasury-rules-0278"
    salience 5
when
    $o : PaymentsApplicant0168(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0278 Standard"
    ruleflow-group "treasury-rules-0278"
    salience 1
when
    $o : PaymentsApplicant0168(amount <= 3200, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

