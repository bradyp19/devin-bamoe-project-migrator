package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsPayment0158;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0267 High Value"
    ruleflow-group "loans-rules-0267"
    salience 10
when
    $o : PaymentsPayment0158(amount > 550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0267 Low Score"
    ruleflow-group "loans-rules-0267"
    salience 5
when
    $o : PaymentsPayment0158(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0267 Standard"
    ruleflow-group "loans-rules-0267"
    salience 1
when
    $o : PaymentsPayment0158(amount <= 550, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

