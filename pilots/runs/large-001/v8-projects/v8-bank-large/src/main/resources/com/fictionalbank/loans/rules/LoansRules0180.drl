package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansAccount0103;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0180 High Value"
    ruleflow-group "loans-rules-0180"
    salience 10
when
    $o : LoansAccount0103(amount > 4600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0180 Low Score"
    ruleflow-group "loans-rules-0180"
    salience 5
when
    $o : LoansAccount0103(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0180 Standard"
    ruleflow-group "loans-rules-0180"
    salience 1
when
    $o : LoansAccount0103(amount <= 4600, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

