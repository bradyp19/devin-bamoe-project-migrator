package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.MortgageCase0094;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0152 High Value"
    ruleflow-group "mortgage-rules-0152"
    salience 10
when
    $o : MortgageCase0094(amount > 3550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0152 Low Score"
    ruleflow-group "mortgage-rules-0152"
    salience 5
when
    $o : MortgageCase0094(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0152 Standard"
    ruleflow-group "mortgage-rules-0152"
    salience 1
when
    $o : MortgageCase0094(amount <= 3550, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

