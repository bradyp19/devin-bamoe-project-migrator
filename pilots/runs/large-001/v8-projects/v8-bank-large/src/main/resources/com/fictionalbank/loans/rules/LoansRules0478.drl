package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsParty0287;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0478 High Value"
    ruleflow-group "loans-rules-0478"
    salience 10
when
    $o : DepositsParty0287(amount > 4050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0478 Low Score"
    ruleflow-group "loans-rules-0478"
    salience 5
when
    $o : DepositsParty0287(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0478 Standard"
    ruleflow-group "loans-rules-0478"
    salience 1
when
    $o : DepositsParty0287(amount <= 4050, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

