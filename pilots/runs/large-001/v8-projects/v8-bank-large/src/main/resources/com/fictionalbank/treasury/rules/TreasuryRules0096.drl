package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsCase0058;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0096 High Value"
    ruleflow-group "treasury-rules-0096"
    salience 10
when
    $o : PaymentsCase0058(amount > 1400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0096 Low Score"
    ruleflow-group "treasury-rules-0096"
    salience 5
when
    $o : PaymentsCase0058(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0096 Standard"
    ruleflow-group "treasury-rules-0096"
    salience 1
when
    $o : PaymentsCase0058(amount <= 1400, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

