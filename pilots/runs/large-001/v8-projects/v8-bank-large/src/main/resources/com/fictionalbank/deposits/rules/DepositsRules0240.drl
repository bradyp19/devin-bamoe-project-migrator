package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycApplicant0144;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0240 High Value"
    ruleflow-group "deposits-rules-0240"
    salience 10
when
    $o : KycApplicant0144(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0240 Low Score"
    ruleflow-group "deposits-rules-0240"
    salience 5
when
    $o : KycApplicant0144(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0240 Standard"
    ruleflow-group "deposits-rules-0240"
    salience 1
when
    $o : KycApplicant0144(amount <= 1000, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

