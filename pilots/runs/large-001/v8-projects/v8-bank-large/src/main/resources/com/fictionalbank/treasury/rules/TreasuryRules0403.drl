package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsCase0244;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0403 High Value"
    ruleflow-group "treasury-rules-0403"
    salience 10
when
    $o : PaymentsCase0244(amount > 3800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0403 Low Score"
    ruleflow-group "treasury-rules-0403"
    salience 5
when
    $o : PaymentsCase0244(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0403 Standard"
    ruleflow-group "treasury-rules-0403"
    salience 1
when
    $o : PaymentsCase0244(amount <= 3800, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

