package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsAccount0235;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0397 High Value"
    ruleflow-group "kyc-rules-0397"
    salience 10
when
    $o : DepositsAccount0235(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0397 Low Score"
    ruleflow-group "kyc-rules-0397"
    salience 5
when
    $o : DepositsAccount0235(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0397 Standard"
    ruleflow-group "kyc-rules-0397"
    salience 1
when
    $o : DepositsAccount0235(amount <= 3750, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

