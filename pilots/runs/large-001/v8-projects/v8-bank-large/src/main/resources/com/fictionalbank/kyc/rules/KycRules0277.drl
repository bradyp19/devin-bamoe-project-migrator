package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudCase0166;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0277 High Value"
    ruleflow-group "kyc-rules-0277"
    salience 10
when
    $o : FraudCase0166(amount > 2650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0277 Low Score"
    ruleflow-group "kyc-rules-0277"
    salience 5
when
    $o : FraudCase0166(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0277 Standard"
    ruleflow-group "kyc-rules-0277"
    salience 1
when
    $o : FraudCase0166(amount <= 2650, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

