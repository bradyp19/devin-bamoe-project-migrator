package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsCard0141;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0235 High Value"
    ruleflow-group "loans-rules-0235"
    salience 10
when
    $o : PaymentsCard0141(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0235 Low Score"
    ruleflow-group "loans-rules-0235"
    salience 5
when
    $o : PaymentsCard0141(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0235 Standard"
    ruleflow-group "loans-rules-0235"
    salience 1
when
    $o : PaymentsCard0141(amount <= 700, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

