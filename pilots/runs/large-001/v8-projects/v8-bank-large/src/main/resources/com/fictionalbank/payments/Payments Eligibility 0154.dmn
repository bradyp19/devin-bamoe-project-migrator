<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/payments/eligibility0154" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0154" name="Payments Eligibility 0154" namespace="https://fictionalbank.example/dmn/payments/eligibility0154">
  <dmn:inputData id="_in0154_age" name="Age">
    <dmn:variable id="_in0154_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0154_amount" name="Amount">
    <dmn:variable id="_in0154_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0154" name="Eligible">
    <dmn:variable id="_dec0154_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0154a">
      <dmn:requiredInput href="#_in0154_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0154b">
      <dmn:requiredInput href="#_in0154_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0154" hitPolicy="FIRST">
      <dmn:input id="_dt0154_i1"><dmn:inputExpression id="_dt0154_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0154_i2"><dmn:inputExpression id="_dt0154_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0154_o1"/>
      <dmn:rule id="_dt0154_r1">
        <dmn:inputEntry id="_dt0154_r1a"><dmn:text>&lt; 22</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0154_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0154_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0154_r2">
        <dmn:inputEntry id="_dt0154_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0154_r2b"><dmn:text>&lt;= 11000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0154_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0154_r3">
        <dmn:inputEntry id="_dt0154_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0154_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0154_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
