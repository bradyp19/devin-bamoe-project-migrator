package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.KycAccount0205;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0344 High Value"
    ruleflow-group "treasury-rules-0344"
    salience 10
when
    $o : KycAccount0205(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0344 Low Score"
    ruleflow-group "treasury-rules-0344"
    salience 5
when
    $o : KycAccount0205(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0344 Standard"
    ruleflow-group "treasury-rules-0344"
    salience 1
when
    $o : KycAccount0205(amount <= 3150, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

