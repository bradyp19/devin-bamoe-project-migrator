package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.TreasuryCase0196;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0329 High Value"
    ruleflow-group "treasury-rules-0329"
    salience 10
when
    $o : TreasuryCase0196(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0329 Low Score"
    ruleflow-group "treasury-rules-0329"
    salience 5
when
    $o : TreasuryCase0196(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0329 Standard"
    ruleflow-group "treasury-rules-0329"
    salience 1
when
    $o : TreasuryCase0196(amount <= 3450, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

