package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudCase0088;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0143 High Value"
    ruleflow-group "mortgage-rules-0143"
    salience 10
when
    $o : FraudCase0088(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0143 Low Score"
    ruleflow-group "mortgage-rules-0143"
    salience 5
when
    $o : FraudCase0088(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0143 Standard"
    ruleflow-group "mortgage-rules-0143"
    salience 1
when
    $o : FraudCase0088(amount <= 2200, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

