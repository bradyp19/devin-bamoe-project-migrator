package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCase0172;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0289 High Value"
    ruleflow-group "fraud-rules-0289"
    salience 10
when
    $o : TreasuryCase0172(amount > 3000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0289 Low Score"
    ruleflow-group "fraud-rules-0289"
    salience 5
when
    $o : TreasuryCase0172(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0289 Standard"
    ruleflow-group "fraud-rules-0289"
    salience 1
when
    $o : TreasuryCase0172(amount <= 3000, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

