package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycAccount0025;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0049 High Value"
    ruleflow-group "deposits-rules-0049"
    salience 10
when
    $o : KycAccount0025(amount > 1750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0049 Low Score"
    ruleflow-group "deposits-rules-0049"
    salience 5
when
    $o : KycAccount0025(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0049 Standard"
    ruleflow-group "deposits-rules-0049"
    salience 1
when
    $o : KycAccount0025(amount <= 1750, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

