package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsApplicant0276;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0455 High Value"
    ruleflow-group "kyc-rules-0455"
    salience 10
when
    $o : PaymentsApplicant0276(amount > 1850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0455 Low Score"
    ruleflow-group "kyc-rules-0455"
    salience 5
when
    $o : PaymentsApplicant0276(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0455 Standard"
    ruleflow-group "kyc-rules-0455"
    salience 1
when
    $o : PaymentsApplicant0276(amount <= 1850, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

