package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.PaymentsParty0257;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0422 High Value"
    ruleflow-group "fraud-rules-0422"
    salience 10
when
    $o : PaymentsParty0257(amount > 3900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0422 Low Score"
    ruleflow-group "fraud-rules-0422"
    salience 5
when
    $o : PaymentsParty0257(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0422 Standard"
    ruleflow-group "fraud-rules-0422"
    salience 1
when
    $o : PaymentsParty0257(amount <= 3900, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

