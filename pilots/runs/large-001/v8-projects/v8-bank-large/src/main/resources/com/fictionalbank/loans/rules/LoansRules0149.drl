package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsCard0087;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0149 High Value"
    ruleflow-group "loans-rules-0149"
    salience 10
when
    $o : PaymentsCard0087(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0149 Low Score"
    ruleflow-group "loans-rules-0149"
    salience 5
when
    $o : PaymentsCard0087(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0149 Standard"
    ruleflow-group "loans-rules-0149"
    salience 1
when
    $o : PaymentsCard0087(amount <= 3650, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

