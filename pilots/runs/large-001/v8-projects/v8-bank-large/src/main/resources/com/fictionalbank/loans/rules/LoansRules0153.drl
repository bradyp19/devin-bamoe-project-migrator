package com.fictionalbank.loans.rules;

import com.fictionalbank.model.MortgageCase0094;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0153 High Value"
    ruleflow-group "loans-rules-0153"
    salience 10
when
    $o : MortgageCase0094(amount > 2350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0153 Low Score"
    ruleflow-group "loans-rules-0153"
    salience 5
when
    $o : MortgageCase0094(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0153 Standard"
    ruleflow-group "loans-rules-0153"
    salience 1
when
    $o : MortgageCase0094(amount <= 2350, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

