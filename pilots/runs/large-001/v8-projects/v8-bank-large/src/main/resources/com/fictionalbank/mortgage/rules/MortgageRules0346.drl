package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudApplicant0210;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0346 High Value"
    ruleflow-group "mortgage-rules-0346"
    salience 10
when
    $o : FraudApplicant0210(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0346 Low Score"
    ruleflow-group "mortgage-rules-0346"
    salience 5
when
    $o : FraudApplicant0210(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0346 Standard"
    ruleflow-group "mortgage-rules-0346"
    salience 1
when
    $o : FraudApplicant0210(amount <= 950, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

