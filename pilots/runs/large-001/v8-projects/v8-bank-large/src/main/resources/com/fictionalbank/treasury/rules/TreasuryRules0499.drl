package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsApplicant0300;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0499 High Value"
    ruleflow-group "treasury-rules-0499"
    salience 10
when
    $o : PaymentsApplicant0300(amount > 3600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0499 Low Score"
    ruleflow-group "treasury-rules-0499"
    salience 5
when
    $o : PaymentsApplicant0300(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0499 Standard"
    ruleflow-group "treasury-rules-0499"
    salience 1
when
    $o : PaymentsApplicant0300(amount <= 3600, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

