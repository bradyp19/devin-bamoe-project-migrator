package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsApplicant0078;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0122 High Value"
    ruleflow-group "payments-rules-0122"
    salience 10
when
    $o : DepositsApplicant0078(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0122 Low Score"
    ruleflow-group "payments-rules-0122"
    salience 5
when
    $o : DepositsApplicant0078(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0122 Standard"
    ruleflow-group "payments-rules-0122"
    salience 1
when
    $o : DepositsApplicant0078(amount <= 2900, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

