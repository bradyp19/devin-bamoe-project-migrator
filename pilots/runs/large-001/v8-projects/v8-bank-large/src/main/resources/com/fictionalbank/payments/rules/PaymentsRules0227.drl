package com.fictionalbank.payments.rules;

import com.fictionalbank.model.MortgageApplicant0138;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0227 High Value"
    ruleflow-group "payments-rules-0227"
    salience 10
when
    $o : MortgageApplicant0138(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0227 Low Score"
    ruleflow-group "payments-rules-0227"
    salience 5
when
    $o : MortgageApplicant0138(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0227 Standard"
    ruleflow-group "payments-rules-0227"
    salience 1
when
    $o : MortgageApplicant0138(amount <= 1800, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

