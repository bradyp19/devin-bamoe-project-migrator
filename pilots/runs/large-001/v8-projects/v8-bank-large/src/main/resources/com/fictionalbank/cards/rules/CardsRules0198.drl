package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudApplicant0120;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0198 High Value"
    ruleflow-group "cards-rules-0198"
    salience 10
when
    $o : FraudApplicant0120(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0198 Low Score"
    ruleflow-group "cards-rules-0198"
    salience 5
when
    $o : FraudApplicant0120(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0198 Standard"
    ruleflow-group "cards-rules-0198"
    salience 1
when
    $o : FraudApplicant0120(amount <= 2550, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

