package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycAccount0265;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0449 High Value"
    ruleflow-group "fraud-rules-0449"
    salience 10
when
    $o : KycAccount0265(amount > 2100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0449 Low Score"
    ruleflow-group "fraud-rules-0449"
    salience 5
when
    $o : KycAccount0265(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0449 Standard"
    ruleflow-group "fraud-rules-0449"
    salience 1
when
    $o : KycAccount0265(amount <= 2100, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

