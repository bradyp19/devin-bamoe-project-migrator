package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudParty0077;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0126 High Value"
    ruleflow-group "kyc-rules-0126"
    salience 10
when
    $o : FraudParty0077(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0126 Low Score"
    ruleflow-group "kyc-rules-0126"
    salience 5
when
    $o : FraudParty0077(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0126 Standard"
    ruleflow-group "kyc-rules-0126"
    salience 1
when
    $o : FraudParty0077(amount <= 800, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

