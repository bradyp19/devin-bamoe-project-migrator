package com.fictionalbank.cards.rules;

import com.fictionalbank.model.CardsAccount0157;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0269 High Value"
    ruleflow-group "cards-rules-0269"
    salience 10
when
    $o : CardsAccount0157(amount > 3300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0269 Low Score"
    ruleflow-group "cards-rules-0269"
    salience 5
when
    $o : CardsAccount0157(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0269 Standard"
    ruleflow-group "cards-rules-0269"
    salience 1
when
    $o : CardsAccount0157(amount <= 3300, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

