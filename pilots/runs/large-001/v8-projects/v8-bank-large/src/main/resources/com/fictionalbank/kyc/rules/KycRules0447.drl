package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycAccount0265;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0447 High Value"
    ruleflow-group "kyc-rules-0447"
    salience 10
when
    $o : KycAccount0265(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0447 Low Score"
    ruleflow-group "kyc-rules-0447"
    salience 5
when
    $o : KycAccount0265(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0447 Standard"
    ruleflow-group "kyc-rules-0447"
    salience 1
when
    $o : KycAccount0265(amount <= 3750, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

