package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansCard0213;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0360 High Value"
    ruleflow-group "fraud-rules-0360"
    salience 10
when
    $o : LoansCard0213(amount > 1850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0360 Low Score"
    ruleflow-group "fraud-rules-0360"
    salience 5
when
    $o : LoansCard0213(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0360 Standard"
    ruleflow-group "fraud-rules-0360"
    salience 1
when
    $o : LoansCard0213(amount <= 1850, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

