package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.LoansAccount0103;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0172 High Value"
    ruleflow-group "deposits-rules-0172"
    salience 10
when
    $o : LoansAccount0103(amount > 2350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0172 Low Score"
    ruleflow-group "deposits-rules-0172"
    salience 5
when
    $o : LoansAccount0103(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0172 Standard"
    ruleflow-group "deposits-rules-0172"
    salience 1
when
    $o : LoansAccount0103(amount <= 2350, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

