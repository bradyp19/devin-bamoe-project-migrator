package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.MortgageCard0123;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0201 High Value"
    ruleflow-group "fraud-rules-0201"
    salience 10
when
    $o : MortgageCard0123(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new MortgageCard0123());
    update($o);
end

rule "Fraud R0201 Low Score"
    ruleflow-group "fraud-rules-0201"
    salience 5
when
    $o : MortgageCard0123(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0201 Standard"
    ruleflow-group "fraud-rules-0201"
    salience 1
when
    $o : MortgageCard0123(amount <= 3050, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

