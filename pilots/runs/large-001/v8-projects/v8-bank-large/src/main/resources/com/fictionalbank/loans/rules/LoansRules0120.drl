package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsPayment0068;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0120 High Value"
    ruleflow-group "loans-rules-0120"
    salience 10
when
    $o : PaymentsPayment0068(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0120 Low Score"
    ruleflow-group "loans-rules-0120"
    salience 5
when
    $o : PaymentsPayment0068(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0120 Standard"
    ruleflow-group "loans-rules-0120"
    salience 1
when
    $o : PaymentsPayment0068(amount <= 3500, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

