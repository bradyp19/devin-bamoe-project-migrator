package com.fictionalbank.payments.rules;

import com.fictionalbank.model.MortgageAccount0289;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0490 High Value"
    ruleflow-group "payments-rules-0490"
    salience 10
when
    $o : MortgageAccount0289(amount > 550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0490 Low Score"
    ruleflow-group "payments-rules-0490"
    salience 5
when
    $o : MortgageAccount0289(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0490 Standard"
    ruleflow-group "payments-rules-0490"
    salience 1
when
    $o : MortgageAccount0289(amount <= 550, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

