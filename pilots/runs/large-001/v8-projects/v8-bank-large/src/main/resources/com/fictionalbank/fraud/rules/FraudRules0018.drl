package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycAccount0007;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0018 High Value"
    ruleflow-group "fraud-rules-0018"
    salience 10
when
    $o : KycAccount0007(amount > 3850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0018 Low Score"
    ruleflow-group "fraud-rules-0018"
    salience 5
when
    $o : KycAccount0007(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0018 Standard"
    ruleflow-group "fraud-rules-0018"
    salience 1
when
    $o : KycAccount0007(amount <= 3850, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

