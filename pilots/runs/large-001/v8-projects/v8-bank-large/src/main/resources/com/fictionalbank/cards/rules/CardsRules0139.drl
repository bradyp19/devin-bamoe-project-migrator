package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudApplicant0084;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0139 High Value"
    ruleflow-group "cards-rules-0139"
    salience 10
when
    $o : FraudApplicant0084(amount > 3850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0139 Low Score"
    ruleflow-group "cards-rules-0139"
    salience 5
when
    $o : FraudApplicant0084(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0139 Standard"
    ruleflow-group "cards-rules-0139"
    salience 1
when
    $o : FraudApplicant0084(amount <= 3850, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

