package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.KycPayment0050;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0085 High Value"
    ruleflow-group "mortgage-rules-0085"
    salience 10
when
    $o : KycPayment0050(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0085 Low Score"
    ruleflow-group "mortgage-rules-0085"
    salience 5
when
    $o : KycPayment0050(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0085 Standard"
    ruleflow-group "mortgage-rules-0085"
    salience 1
when
    $o : KycPayment0050(amount <= 3050, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

