package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCase0268;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0445 High Value"
    ruleflow-group "deposits-rules-0445"
    salience 10
when
    $o : FraudCase0268(amount > 3400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0445 Low Score"
    ruleflow-group "deposits-rules-0445"
    salience 5
when
    $o : FraudCase0268(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0445 Standard"
    ruleflow-group "deposits-rules-0445"
    salience 1
when
    $o : FraudCase0268(amount <= 3400, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

