package com.fictionalbank.cards.rules;

import com.fictionalbank.model.TreasuryCard0105;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0176 High Value"
    ruleflow-group "cards-rules-0176"
    salience 10
when
    $o : TreasuryCard0105(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0176 Low Score"
    ruleflow-group "cards-rules-0176"
    salience 5
when
    $o : TreasuryCard0105(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0176 Standard"
    ruleflow-group "cards-rules-0176"
    salience 1
when
    $o : TreasuryCard0105(amount <= 4350, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

