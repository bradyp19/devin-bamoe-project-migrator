package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansApplicant0252;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0416 High Value"
    ruleflow-group "treasury-rules-0416"
    salience 10
when
    $o : LoansApplicant0252(amount > 3700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0416 Low Score"
    ruleflow-group "treasury-rules-0416"
    salience 5
when
    $o : LoansApplicant0252(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0416 Standard"
    ruleflow-group "treasury-rules-0416"
    salience 1
when
    $o : LoansApplicant0252(amount <= 3700, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

