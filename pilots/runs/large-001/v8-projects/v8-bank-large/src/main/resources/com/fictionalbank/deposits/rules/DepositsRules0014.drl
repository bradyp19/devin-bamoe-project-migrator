package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycAccount0007;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0014 High Value"
    ruleflow-group "deposits-rules-0014"
    salience 10
when
    $o : KycAccount0007(amount > 2350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0014 Low Score"
    ruleflow-group "deposits-rules-0014"
    salience 5
when
    $o : KycAccount0007(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0014 Standard"
    ruleflow-group "deposits-rules-0014"
    salience 1
when
    $o : KycAccount0007(amount <= 2350, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

