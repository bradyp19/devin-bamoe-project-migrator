package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsPayment0128;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0214 High Value"
    ruleflow-group "cards-rules-0214"
    salience 10
when
    $o : DepositsPayment0128(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0214 Low Score"
    ruleflow-group "cards-rules-0214"
    salience 5
when
    $o : DepositsPayment0128(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0214 Standard"
    ruleflow-group "cards-rules-0214"
    salience 1
when
    $o : DepositsPayment0128(amount <= 3050, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

