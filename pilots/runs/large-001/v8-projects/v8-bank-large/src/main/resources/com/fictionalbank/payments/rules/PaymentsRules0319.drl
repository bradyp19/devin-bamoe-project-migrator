package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryCase0190;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0319 High Value"
    ruleflow-group "payments-rules-0319"
    salience 10
when
    $o : TreasuryCase0190(amount > 4600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0319 Low Score"
    ruleflow-group "payments-rules-0319"
    salience 5
when
    $o : TreasuryCase0190(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0319 Standard"
    ruleflow-group "payments-rules-0319"
    salience 1
when
    $o : TreasuryCase0190(amount <= 4600, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

