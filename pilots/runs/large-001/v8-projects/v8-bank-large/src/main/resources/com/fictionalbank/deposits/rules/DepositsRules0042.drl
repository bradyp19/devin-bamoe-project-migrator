package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudParty0029;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0042 High Value"
    ruleflow-group "deposits-rules-0042"
    salience 10
when
    $o : FraudParty0029(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0042 Low Score"
    ruleflow-group "deposits-rules-0042"
    salience 5
when
    $o : FraudParty0029(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0042 Standard"
    ruleflow-group "deposits-rules-0042"
    salience 1
when
    $o : FraudParty0029(amount <= 4900, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

