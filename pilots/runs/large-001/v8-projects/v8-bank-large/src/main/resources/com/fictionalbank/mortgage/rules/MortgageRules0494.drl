package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsPayment0296;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0494 High Value"
    ruleflow-group "mortgage-rules-0494"
    salience 10
when
    $o : DepositsPayment0296(amount > 2850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0494 Low Score"
    ruleflow-group "mortgage-rules-0494"
    salience 5
when
    $o : DepositsPayment0296(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0494 Standard"
    ruleflow-group "mortgage-rules-0494"
    salience 1
when
    $o : DepositsPayment0296(amount <= 2850, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

