package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgageCard0237;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0400 High Value"
    ruleflow-group "deposits-rules-0400"
    salience 10
when
    $o : MortgageCard0237(amount > 4850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0400 Low Score"
    ruleflow-group "deposits-rules-0400"
    salience 5
when
    $o : MortgageCard0237(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0400 Standard"
    ruleflow-group "deposits-rules-0400"
    salience 1
when
    $o : MortgageCard0237(amount <= 4850, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

