package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.TreasuryApplicant0192;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0317 High Value"
    ruleflow-group "treasury-rules-0317"
    salience 10
when
    $o : TreasuryApplicant0192(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0317 Low Score"
    ruleflow-group "treasury-rules-0317"
    salience 5
when
    $o : TreasuryApplicant0192(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0317 Standard"
    ruleflow-group "treasury-rules-0317"
    salience 1
when
    $o : TreasuryApplicant0192(amount <= 3950, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

