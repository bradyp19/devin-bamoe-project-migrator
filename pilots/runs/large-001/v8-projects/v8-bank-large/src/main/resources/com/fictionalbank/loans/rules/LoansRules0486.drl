package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansPayment0290;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0486 High Value"
    ruleflow-group "loans-rules-0486"
    salience 10
when
    $o : LoansPayment0290(amount > 4200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0486 Low Score"
    ruleflow-group "loans-rules-0486"
    salience 5
when
    $o : LoansPayment0290(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0486 Standard"
    ruleflow-group "loans-rules-0486"
    salience 1
when
    $o : LoansPayment0290(amount <= 4200, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

