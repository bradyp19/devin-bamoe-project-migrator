package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryPayment0284;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0480 High Value"
    ruleflow-group "payments-rules-0480"
    salience 10
when
    $o : TreasuryPayment0284(amount > 3100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0480 Low Score"
    ruleflow-group "payments-rules-0480"
    salience 5
when
    $o : TreasuryPayment0284(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0480 Standard"
    ruleflow-group "payments-rules-0480"
    salience 1
when
    $o : TreasuryPayment0284(amount <= 3100, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

