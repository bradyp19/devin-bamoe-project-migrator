package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycAccount0073;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0125 High Value"
    ruleflow-group "fraud-rules-0125"
    salience 10
when
    $o : KycAccount0073(amount > 600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0125 Low Score"
    ruleflow-group "fraud-rules-0125"
    salience 5
when
    $o : KycAccount0073(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0125 Standard"
    ruleflow-group "fraud-rules-0125"
    salience 1
when
    $o : KycAccount0073(amount <= 600, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

