package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryCard0285;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0477 High Value"
    ruleflow-group "payments-rules-0477"
    salience 10
when
    $o : TreasuryCard0285(amount > 4500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0477 Low Score"
    ruleflow-group "payments-rules-0477"
    salience 5
when
    $o : TreasuryCard0285(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0477 Standard"
    ruleflow-group "payments-rules-0477"
    salience 1
when
    $o : TreasuryCard0285(amount <= 4500, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

