package com.fictionalbank.payments.rules;

import com.fictionalbank.model.CardsPayment0212;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0351 High Value"
    ruleflow-group "payments-rules-0351"
    salience 10
when
    $o : CardsPayment0212(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new CardsPayment0212());
    update($o);
end

rule "Payments R0351 Low Score"
    ruleflow-group "payments-rules-0351"
    salience 5
when
    $o : CardsPayment0212(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0351 Standard"
    ruleflow-group "payments-rules-0351"
    salience 1
when
    $o : CardsPayment0212(amount <= 3050, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

