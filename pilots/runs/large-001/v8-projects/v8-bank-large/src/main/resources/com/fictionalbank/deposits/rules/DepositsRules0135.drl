package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryParty0083;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0135 High Value"
    ruleflow-group "deposits-rules-0135"
    salience 10
when
    $o : TreasuryParty0083(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0135 Low Score"
    ruleflow-group "deposits-rules-0135"
    salience 5
when
    $o : TreasuryParty0083(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0135 Standard"
    ruleflow-group "deposits-rules-0135"
    salience 1
when
    $o : TreasuryParty0083(amount <= 2150, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

