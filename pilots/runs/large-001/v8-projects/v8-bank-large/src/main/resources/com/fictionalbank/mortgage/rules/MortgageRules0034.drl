package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.LoansParty0023;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0034 High Value"
    ruleflow-group "mortgage-rules-0034"
    salience 10
when
    $o : LoansParty0023(amount > 4550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0034 Low Score"
    ruleflow-group "mortgage-rules-0034"
    salience 5
when
    $o : LoansParty0023(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0034 Standard"
    ruleflow-group "mortgage-rules-0034"
    salience 1
when
    $o : LoansParty0023(amount <= 4550, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

