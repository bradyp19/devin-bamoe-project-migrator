package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudCard0291;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0489 High Value"
    ruleflow-group "kyc-rules-0489"
    salience 10
when
    $o : FraudCard0291(amount > 4850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0489 Low Score"
    ruleflow-group "kyc-rules-0489"
    salience 5
when
    $o : FraudCard0291(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0489 Standard"
    ruleflow-group "kyc-rules-0489"
    salience 1
when
    $o : FraudCard0291(amount <= 4850, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

