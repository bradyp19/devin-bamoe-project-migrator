package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsPayment0098;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0164 High Value"
    ruleflow-group "mortgage-rules-0164"
    salience 10
when
    $o : DepositsPayment0098(amount > 700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0164 Low Score"
    ruleflow-group "mortgage-rules-0164"
    salience 5
when
    $o : DepositsPayment0098(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0164 Standard"
    ruleflow-group "mortgage-rules-0164"
    salience 1
when
    $o : DepositsPayment0098(amount <= 700, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

