package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsCard0255;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0425 High Value"
    ruleflow-group "deposits-rules-0425"
    salience 10
when
    $o : DepositsCard0255(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0425 Low Score"
    ruleflow-group "deposits-rules-0425"
    salience 5
when
    $o : DepositsCard0255(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0425 Standard"
    ruleflow-group "deposits-rules-0425"
    salience 1
when
    $o : DepositsCard0255(amount <= 800, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

