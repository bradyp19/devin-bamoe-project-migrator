package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudParty0173;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0283 High Value"
    ruleflow-group "deposits-rules-0283"
    salience 10
when
    $o : FraudParty0173(amount > 500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0283 Low Score"
    ruleflow-group "deposits-rules-0283"
    salience 5
when
    $o : FraudParty0173(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0283 Standard"
    ruleflow-group "deposits-rules-0283"
    salience 1
when
    $o : FraudParty0173(amount <= 500, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

