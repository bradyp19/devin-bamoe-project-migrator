package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.TreasuryCard0285;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0471 High Value"
    ruleflow-group "treasury-rules-0471"
    salience 10
when
    $o : TreasuryCard0285(amount > 1350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new TreasuryCard0285());
    update($o);
end

rule "Treasury R0471 Low Score"
    ruleflow-group "treasury-rules-0471"
    salience 5
when
    $o : TreasuryCard0285(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0471 Standard"
    ruleflow-group "treasury-rules-0471"
    salience 1
when
    $o : TreasuryCard0285(amount <= 1350, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

