package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCard0135;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0225 High Value"
    ruleflow-group "deposits-rules-0225"
    salience 10
when
    $o : FraudCard0135(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0225 Low Score"
    ruleflow-group "deposits-rules-0225"
    salience 5
when
    $o : FraudCard0135(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0225 Standard"
    ruleflow-group "deposits-rules-0225"
    salience 1
when
    $o : FraudCard0135(amount <= 2950, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

