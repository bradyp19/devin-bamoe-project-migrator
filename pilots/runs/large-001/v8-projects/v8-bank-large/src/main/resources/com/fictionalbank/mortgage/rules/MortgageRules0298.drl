package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.MortgageCase0178;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0298 High Value"
    ruleflow-group "mortgage-rules-0298"
    salience 10
when
    $o : MortgageCase0178(amount > 1850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0298 Low Score"
    ruleflow-group "mortgage-rules-0298"
    salience 5
when
    $o : MortgageCase0178(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0298 Standard"
    ruleflow-group "mortgage-rules-0298"
    salience 1
when
    $o : MortgageCase0178(amount <= 1850, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

