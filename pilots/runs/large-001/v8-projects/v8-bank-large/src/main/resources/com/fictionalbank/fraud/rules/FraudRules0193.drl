package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.CardsAccount0115;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0193 High Value"
    ruleflow-group "fraud-rules-0193"
    salience 10
when
    $o : CardsAccount0115(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0193 Low Score"
    ruleflow-group "fraud-rules-0193"
    salience 5
when
    $o : CardsAccount0115(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0193 Standard"
    ruleflow-group "fraud-rules-0193"
    salience 1
when
    $o : CardsAccount0115(amount <= 4950, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

