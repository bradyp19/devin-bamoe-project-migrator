package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsCard0057;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0095 High Value"
    ruleflow-group "treasury-rules-0095"
    salience 10
when
    $o : CardsCard0057(amount > 1450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0095 Low Score"
    ruleflow-group "treasury-rules-0095"
    salience 5
when
    $o : CardsCard0057(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0095 Standard"
    ruleflow-group "treasury-rules-0095"
    salience 1
when
    $o : CardsCard0057(amount <= 1450, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

