package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.LoansAccount0133;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0230 High Value"
    ruleflow-group "kyc-rules-0230"
    salience 10
when
    $o : LoansAccount0133(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0230 Low Score"
    ruleflow-group "kyc-rules-0230"
    salience 5
when
    $o : LoansAccount0133(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0230 Standard"
    ruleflow-group "kyc-rules-0230"
    salience 1
when
    $o : LoansAccount0133(amount <= 2900, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

