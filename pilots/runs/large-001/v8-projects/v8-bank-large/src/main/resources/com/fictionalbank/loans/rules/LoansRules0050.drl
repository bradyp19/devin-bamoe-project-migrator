package com.fictionalbank.loans.rules;

import com.fictionalbank.model.FraudCase0028;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0050 High Value"
    ruleflow-group "loans-rules-0050"
    salience 10
when
    $o : FraudCase0028(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0050 Low Score"
    ruleflow-group "loans-rules-0050"
    salience 5
when
    $o : FraudCase0028(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0050 Standard"
    ruleflow-group "loans-rules-0050"
    salience 1
when
    $o : FraudCase0028(amount <= 4950, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

