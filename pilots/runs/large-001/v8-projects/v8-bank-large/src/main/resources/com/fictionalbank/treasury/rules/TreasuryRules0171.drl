package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansAccount0103;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0171 High Value"
    ruleflow-group "treasury-rules-0171"
    salience 10
when
    $o : LoansAccount0103(amount > 4800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new LoansAccount0103());
    update($o);
end

rule "Treasury R0171 Low Score"
    ruleflow-group "treasury-rules-0171"
    salience 5
when
    $o : LoansAccount0103(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0171 Standard"
    ruleflow-group "treasury-rules-0171"
    salience 1
when
    $o : LoansAccount0103(amount <= 4800, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

