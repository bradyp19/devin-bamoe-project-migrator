package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.MortgageCard0153;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0258 High Value"
    ruleflow-group "deposits-rules-0258"
    salience 10
when
    $o : MortgageCard0153(amount > 3050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0258 Low Score"
    ruleflow-group "deposits-rules-0258"
    salience 5
when
    $o : MortgageCard0153(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0258 Standard"
    ruleflow-group "deposits-rules-0258"
    salience 1
when
    $o : MortgageCard0153(amount <= 3050, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

