package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.MortgageCase0160;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0262 High Value"
    ruleflow-group "kyc-rules-0262"
    salience 10
when
    $o : MortgageCase0160(amount > 1150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0262 Low Score"
    ruleflow-group "kyc-rules-0262"
    salience 5
when
    $o : MortgageCase0160(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0262 Standard"
    ruleflow-group "kyc-rules-0262"
    salience 1
when
    $o : MortgageCase0160(amount <= 1150, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

