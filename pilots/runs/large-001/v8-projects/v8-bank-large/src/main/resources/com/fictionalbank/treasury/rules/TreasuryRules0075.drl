package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.FraudCase0046;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0075 High Value"
    ruleflow-group "treasury-rules-0075"
    salience 10
when
    $o : FraudCase0046(amount > 4000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0075 Low Score"
    ruleflow-group "treasury-rules-0075"
    salience 5
when
    $o : FraudCase0046(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0075 Standard"
    ruleflow-group "treasury-rules-0075"
    salience 1
when
    $o : FraudCase0046(amount <= 4000, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

