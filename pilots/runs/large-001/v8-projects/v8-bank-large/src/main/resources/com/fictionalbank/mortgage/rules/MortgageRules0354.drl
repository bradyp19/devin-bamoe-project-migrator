package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.CardsPayment0212;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0354 High Value"
    ruleflow-group "mortgage-rules-0354"
    salience 10
when
    $o : CardsPayment0212(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0354 Low Score"
    ruleflow-group "mortgage-rules-0354"
    salience 5
when
    $o : CardsPayment0212(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0354 Standard"
    ruleflow-group "mortgage-rules-0354"
    salience 1
when
    $o : CardsPayment0212(amount <= 1550, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

