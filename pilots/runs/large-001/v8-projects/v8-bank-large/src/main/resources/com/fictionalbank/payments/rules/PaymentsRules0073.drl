package com.fictionalbank.payments.rules;

import com.fictionalbank.model.LoansAccount0043;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0073 High Value"
    ruleflow-group "payments-rules-0073"
    salience 10
when
    $o : LoansAccount0043(amount > 2450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0073 Low Score"
    ruleflow-group "payments-rules-0073"
    salience 5
when
    $o : LoansAccount0043(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0073 Standard"
    ruleflow-group "payments-rules-0073"
    salience 1
when
    $o : LoansAccount0043(amount <= 2450, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

