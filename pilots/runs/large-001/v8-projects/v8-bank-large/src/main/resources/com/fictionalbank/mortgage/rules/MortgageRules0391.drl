package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsParty0239;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0391 High Value"
    ruleflow-group "mortgage-rules-0391"
    salience 10
when
    $o : DepositsParty0239(amount > 500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new DepositsParty0239());
    update($o);
end

rule "Mortgage R0391 Low Score"
    ruleflow-group "mortgage-rules-0391"
    salience 5
when
    $o : DepositsParty0239(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0391 Standard"
    ruleflow-group "mortgage-rules-0391"
    salience 1
when
    $o : DepositsParty0239(amount <= 500, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

