package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.FraudAccount0247;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0413 High Value"
    ruleflow-group "treasury-rules-0413"
    salience 10
when
    $o : FraudAccount0247(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0413 Low Score"
    ruleflow-group "treasury-rules-0413"
    salience 5
when
    $o : FraudAccount0247(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0413 Standard"
    ruleflow-group "treasury-rules-0413"
    salience 1
when
    $o : FraudAccount0247(amount <= 4900, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

