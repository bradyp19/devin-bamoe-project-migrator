package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.CardsPayment0212;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0356 High Value"
    ruleflow-group "fraud-rules-0356"
    salience 10
when
    $o : CardsPayment0212(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0356 Low Score"
    ruleflow-group "fraud-rules-0356"
    salience 5
when
    $o : CardsPayment0212(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0356 Standard"
    ruleflow-group "fraud-rules-0356"
    salience 1
when
    $o : CardsPayment0212(amount <= 3650, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

