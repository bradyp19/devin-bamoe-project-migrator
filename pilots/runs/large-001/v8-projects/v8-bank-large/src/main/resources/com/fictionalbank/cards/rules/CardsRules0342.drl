package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycAccount0205;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0342 High Value"
    ruleflow-group "cards-rules-0342"
    salience 10
when
    $o : KycAccount0205(amount > 2850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0342 Low Score"
    ruleflow-group "cards-rules-0342"
    salience 5
when
    $o : KycAccount0205(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0342 Standard"
    ruleflow-group "cards-rules-0342"
    salience 1
when
    $o : KycAccount0205(amount <= 2850, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

