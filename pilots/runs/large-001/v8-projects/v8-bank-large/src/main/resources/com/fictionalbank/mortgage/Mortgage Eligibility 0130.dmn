<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="https://fictionalbank.example/dmn/mortgage/eligibility0130" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0130" name="Mortgage Eligibility 0130" namespace="https://fictionalbank.example/dmn/mortgage/eligibility0130">
  <dmn:inputData id="_in0130_age" name="Age">
    <dmn:variable id="_in0130_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0130_amount" name="Amount">
    <dmn:variable id="_in0130_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0130" name="Eligible">
    <dmn:variable id="_dec0130_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0130a">
      <dmn:requiredInput href="#_in0130_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0130b">
      <dmn:requiredInput href="#_in0130_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0130" hitPolicy="FIRST">
      <dmn:input id="_dt0130_i1"><dmn:inputExpression id="_dt0130_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0130_i2"><dmn:inputExpression id="_dt0130_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0130_o1"/>
      <dmn:rule id="_dt0130_r1">
        <dmn:inputEntry id="_dt0130_r1a"><dmn:text>&lt; 24</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0130_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0130_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0130_r2">
        <dmn:inputEntry id="_dt0130_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0130_r2b"><dmn:text>&lt;= 14500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0130_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0130_r3">
        <dmn:inputEntry id="_dt0130_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0130_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0130_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
