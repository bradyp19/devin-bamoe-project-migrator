<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/cards/eligibility0129" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0129" name="Cards Eligibility 0129" namespace="https://fictionalbank.example/dmn/cards/eligibility0129">
  <dmn:inputData id="_in0129_age" name="Age">
    <dmn:variable id="_in0129_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0129_amount" name="Amount">
    <dmn:variable id="_in0129_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0129" name="Eligible">
    <dmn:variable id="_dec0129_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0129a">
      <dmn:requiredInput href="#_in0129_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0129b">
      <dmn:requiredInput href="#_in0129_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0129" hitPolicy="FIRST">
      <dmn:input id="_dt0129_i1"><dmn:inputExpression id="_dt0129_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0129_i2"><dmn:inputExpression id="_dt0129_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0129_o1"/>
      <dmn:rule id="_dt0129_r1">
        <dmn:inputEntry id="_dt0129_r1a"><dmn:text>&lt; 22</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0129_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0129_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0129_r2">
        <dmn:inputEntry id="_dt0129_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0129_r2b"><dmn:text>&lt;= 12000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0129_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0129_r3">
        <dmn:inputEntry id="_dt0129_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0129_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0129_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
