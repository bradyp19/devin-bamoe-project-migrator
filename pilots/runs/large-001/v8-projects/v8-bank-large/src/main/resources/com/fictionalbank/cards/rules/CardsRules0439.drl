package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudAccount0259;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0439 High Value"
    ruleflow-group "cards-rules-0439"
    salience 10
when
    $o : FraudAccount0259(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0439 Low Score"
    ruleflow-group "cards-rules-0439"
    salience 5
when
    $o : FraudAccount0259(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0439 Standard"
    ruleflow-group "cards-rules-0439"
    salience 1
when
    $o : FraudAccount0259(amount <= 4900, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

