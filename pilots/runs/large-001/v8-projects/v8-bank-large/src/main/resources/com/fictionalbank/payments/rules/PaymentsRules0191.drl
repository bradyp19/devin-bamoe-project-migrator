package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsParty0119;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0191 High Value"
    ruleflow-group "payments-rules-0191"
    salience 10
when
    $o : DepositsParty0119(amount > 1150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new DepositsParty0119());
    update($o);
end

rule "Payments R0191 Low Score"
    ruleflow-group "payments-rules-0191"
    salience 5
when
    $o : DepositsParty0119(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0191 Standard"
    ruleflow-group "payments-rules-0191"
    salience 1
when
    $o : DepositsParty0119(amount <= 1150, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

