package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.MortgageApplicant0036;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0051 High Value"
    ruleflow-group "mortgage-rules-0051"
    salience 10
when
    $o : MortgageApplicant0036(amount > 2700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new MortgageApplicant0036());
    update($o);
end

rule "Mortgage R0051 Low Score"
    ruleflow-group "mortgage-rules-0051"
    salience 5
when
    $o : MortgageApplicant0036(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0051 Standard"
    ruleflow-group "mortgage-rules-0051"
    salience 1
when
    $o : MortgageApplicant0036(amount <= 2700, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

