package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsApplicant0240;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0398 High Value"
    ruleflow-group "mortgage-rules-0398"
    salience 10
when
    $o : DepositsApplicant0240(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0398 Low Score"
    ruleflow-group "mortgage-rules-0398"
    salience 5
when
    $o : DepositsApplicant0240(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0398 Standard"
    ruleflow-group "mortgage-rules-0398"
    salience 1
when
    $o : DepositsApplicant0240(amount <= 3750, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

