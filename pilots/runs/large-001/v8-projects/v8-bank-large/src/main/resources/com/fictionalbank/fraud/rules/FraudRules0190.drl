package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansPayment0110;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0190 High Value"
    ruleflow-group "fraud-rules-0190"
    salience 10
when
    $o : LoansPayment0110(amount > 2300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0190 Low Score"
    ruleflow-group "fraud-rules-0190"
    salience 5
when
    $o : LoansPayment0110(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0190 Standard"
    ruleflow-group "fraud-rules-0190"
    salience 1
when
    $o : LoansPayment0110(amount <= 2300, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

