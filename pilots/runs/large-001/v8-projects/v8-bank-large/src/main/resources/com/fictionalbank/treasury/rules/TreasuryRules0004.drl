package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.FraudCard0003;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0004 High Value"
    ruleflow-group "treasury-rules-0004"
    salience 10
when
    $o : FraudCard0003(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0004 Low Score"
    ruleflow-group "treasury-rules-0004"
    salience 5
when
    $o : FraudCard0003(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0004 Standard"
    ruleflow-group "treasury-rules-0004"
    salience 1
when
    $o : FraudCard0003(amount <= 1800, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

