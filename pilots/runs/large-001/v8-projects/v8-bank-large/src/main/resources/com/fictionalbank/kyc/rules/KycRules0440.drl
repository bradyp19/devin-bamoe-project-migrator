package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.KycCard0261;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0440 High Value"
    ruleflow-group "kyc-rules-0440"
    salience 10
when
    $o : KycCard0261(amount > 1250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0440 Low Score"
    ruleflow-group "kyc-rules-0440"
    salience 5
when
    $o : KycCard0261(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0440 Standard"
    ruleflow-group "kyc-rules-0440"
    salience 1
when
    $o : KycCard0261(amount <= 1250, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

