package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsPayment0014;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0026 High Value"
    ruleflow-group "loans-rules-0026"
    salience 10
when
    $o : DepositsPayment0014(amount > 2800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0026 Low Score"
    ruleflow-group "loans-rules-0026"
    salience 5
when
    $o : DepositsPayment0014(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0026 Standard"
    ruleflow-group "loans-rules-0026"
    salience 1
when
    $o : DepositsPayment0014(amount <= 2800, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

