package com.fictionalbank.payments.rules;

import com.fictionalbank.model.MortgageAccount0079;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0134 High Value"
    ruleflow-group "payments-rules-0134"
    salience 10
when
    $o : MortgageAccount0079(amount > 2150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0134 Low Score"
    ruleflow-group "payments-rules-0134"
    salience 5
when
    $o : MortgageAccount0079(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0134 Standard"
    ruleflow-group "payments-rules-0134"
    salience 1
when
    $o : MortgageAccount0079(amount <= 2150, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

