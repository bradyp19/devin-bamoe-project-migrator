package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryCase0196;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0324 High Value"
    ruleflow-group "deposits-rules-0324"
    salience 10
when
    $o : TreasuryCase0196(amount > 3850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0324 Low Score"
    ruleflow-group "deposits-rules-0324"
    salience 5
when
    $o : TreasuryCase0196(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0324 Standard"
    ruleflow-group "deposits-rules-0324"
    salience 1
when
    $o : TreasuryCase0196(amount <= 3850, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

