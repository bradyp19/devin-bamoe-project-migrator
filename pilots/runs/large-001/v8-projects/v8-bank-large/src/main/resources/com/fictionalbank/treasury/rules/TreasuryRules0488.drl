package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.FraudCard0291;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0488 High Value"
    ruleflow-group "treasury-rules-0488"
    salience 10
when
    $o : FraudCard0291(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0488 Low Score"
    ruleflow-group "treasury-rules-0488"
    salience 5
when
    $o : FraudCard0291(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0488 Standard"
    ruleflow-group "treasury-rules-0488"
    salience 1
when
    $o : FraudCard0291(amount <= 4950, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

