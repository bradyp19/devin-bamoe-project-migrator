package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.CardsPayment0104;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0178 High Value"
    ruleflow-group "fraud-rules-0178"
    salience 10
when
    $o : CardsPayment0104(amount > 4900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0178 Low Score"
    ruleflow-group "fraud-rules-0178"
    salience 5
when
    $o : CardsPayment0104(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0178 Standard"
    ruleflow-group "fraud-rules-0178"
    salience 1
when
    $o : CardsPayment0104(amount <= 4900, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

