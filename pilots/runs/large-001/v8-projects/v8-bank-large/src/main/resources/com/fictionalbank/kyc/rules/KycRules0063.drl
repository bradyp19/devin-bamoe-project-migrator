package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryCard0039;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0063 High Value"
    ruleflow-group "kyc-rules-0063"
    salience 10
when
    $o : TreasuryCard0039(amount > 1150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0063 Low Score"
    ruleflow-group "kyc-rules-0063"
    salience 5
when
    $o : TreasuryCard0039(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0063 Standard"
    ruleflow-group "kyc-rules-0063"
    salience 1
when
    $o : TreasuryCard0039(amount <= 1150, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

