package com.fictionalbank.loans.rules;

import com.fictionalbank.model.KycPayment0146;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0250 High Value"
    ruleflow-group "loans-rules-0250"
    salience 10
when
    $o : KycPayment0146(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0250 Low Score"
    ruleflow-group "loans-rules-0250"
    salience 5
when
    $o : KycPayment0146(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0250 Standard"
    ruleflow-group "loans-rules-0250"
    salience 1
when
    $o : KycPayment0146(amount <= 4350, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

