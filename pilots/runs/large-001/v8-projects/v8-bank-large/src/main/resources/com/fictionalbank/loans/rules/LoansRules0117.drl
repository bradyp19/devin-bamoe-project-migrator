package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsAccount0067;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0117 High Value"
    ruleflow-group "loans-rules-0117"
    salience 10
when
    $o : DepositsAccount0067(amount > 4450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0117 Low Score"
    ruleflow-group "loans-rules-0117"
    salience 5
when
    $o : DepositsAccount0067(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0117 Standard"
    ruleflow-group "loans-rules-0117"
    salience 1
when
    $o : DepositsAccount0067(amount <= 4450, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

