package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsParty0125;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0208 High Value"
    ruleflow-group "kyc-rules-0208"
    salience 10
when
    $o : DepositsParty0125(amount > 4700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0208 Low Score"
    ruleflow-group "kyc-rules-0208"
    salience 5
when
    $o : DepositsParty0125(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0208 Standard"
    ruleflow-group "kyc-rules-0208"
    salience 1
when
    $o : DepositsParty0125(amount <= 4700, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

