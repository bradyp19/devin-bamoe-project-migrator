package com.fictionalbank.payments.rules;

import com.fictionalbank.model.FraudCase0088;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0146 High Value"
    ruleflow-group "payments-rules-0146"
    salience 10
when
    $o : FraudCase0088(amount > 4300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0146 Low Score"
    ruleflow-group "payments-rules-0146"
    salience 5
when
    $o : FraudCase0088(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0146 Standard"
    ruleflow-group "payments-rules-0146"
    salience 1
when
    $o : FraudCase0088(amount <= 4300, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

