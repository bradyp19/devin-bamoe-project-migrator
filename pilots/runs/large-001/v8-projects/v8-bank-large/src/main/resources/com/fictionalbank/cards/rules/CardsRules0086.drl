package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsApplicant0054;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0086 High Value"
    ruleflow-group "cards-rules-0086"
    salience 10
when
    $o : PaymentsApplicant0054(amount > 4850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0086 Low Score"
    ruleflow-group "cards-rules-0086"
    salience 5
when
    $o : PaymentsApplicant0054(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0086 Standard"
    ruleflow-group "cards-rules-0086"
    salience 1
when
    $o : PaymentsApplicant0054(amount <= 4850, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

