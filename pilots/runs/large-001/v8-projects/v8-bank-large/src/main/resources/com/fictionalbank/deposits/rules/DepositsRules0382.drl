package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryApplicant0234;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0382 High Value"
    ruleflow-group "deposits-rules-0382"
    salience 10
when
    $o : TreasuryApplicant0234(amount > 2600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0382 Low Score"
    ruleflow-group "deposits-rules-0382"
    salience 5
when
    $o : TreasuryApplicant0234(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0382 Standard"
    ruleflow-group "deposits-rules-0382"
    salience 1
when
    $o : TreasuryApplicant0234(amount <= 2600, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

