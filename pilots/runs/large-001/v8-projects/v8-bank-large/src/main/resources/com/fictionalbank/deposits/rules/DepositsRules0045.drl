package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.PaymentsPayment0026;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0045 High Value"
    ruleflow-group "deposits-rules-0045"
    salience 10
when
    $o : PaymentsPayment0026(amount > 4450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0045 Low Score"
    ruleflow-group "deposits-rules-0045"
    salience 5
when
    $o : PaymentsPayment0026(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0045 Standard"
    ruleflow-group "deposits-rules-0045"
    salience 1
when
    $o : PaymentsPayment0026(amount <= 4450, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

