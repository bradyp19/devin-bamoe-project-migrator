package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansCase0070;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0113 High Value"
    ruleflow-group "loans-rules-0113"
    salience 10
when
    $o : LoansCase0070(amount > 2250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0113 Low Score"
    ruleflow-group "loans-rules-0113"
    salience 5
when
    $o : LoansCase0070(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0113 Standard"
    ruleflow-group "loans-rules-0113"
    salience 1
when
    $o : LoansCase0070(amount <= 2250, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

