package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsCard0231;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0383 High Value"
    ruleflow-group "cards-rules-0383"
    salience 10
when
    $o : PaymentsCard0231(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0383 Low Score"
    ruleflow-group "cards-rules-0383"
    salience 5
when
    $o : PaymentsCard0231(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0383 Standard"
    ruleflow-group "cards-rules-0383"
    salience 1
when
    $o : PaymentsCard0231(amount <= 3500, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

