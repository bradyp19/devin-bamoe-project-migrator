package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycApplicant0222;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0366 High Value"
    ruleflow-group "deposits-rules-0366"
    salience 10
when
    $o : KycApplicant0222(amount > 2050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0366 Low Score"
    ruleflow-group "deposits-rules-0366"
    salience 5
when
    $o : KycApplicant0222(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0366 Standard"
    ruleflow-group "deposits-rules-0366"
    salience 1
when
    $o : KycApplicant0222(amount <= 2050, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

