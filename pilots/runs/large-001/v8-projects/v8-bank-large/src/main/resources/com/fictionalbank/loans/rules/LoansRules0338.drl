package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsPayment0200;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0338 High Value"
    ruleflow-group "loans-rules-0338"
    salience 10
when
    $o : DepositsPayment0200(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0338 Low Score"
    ruleflow-group "loans-rules-0338"
    salience 5
when
    $o : DepositsPayment0200(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0338 Standard"
    ruleflow-group "loans-rules-0338"
    salience 1
when
    $o : DepositsPayment0200(amount <= 1000, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

