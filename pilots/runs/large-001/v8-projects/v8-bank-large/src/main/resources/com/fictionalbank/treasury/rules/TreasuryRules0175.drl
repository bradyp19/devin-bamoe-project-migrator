package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.TreasuryApplicant0108;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0175 High Value"
    ruleflow-group "treasury-rules-0175"
    salience 10
when
    $o : TreasuryApplicant0108(amount > 4000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0175 Low Score"
    ruleflow-group "treasury-rules-0175"
    salience 5
when
    $o : TreasuryApplicant0108(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0175 Standard"
    ruleflow-group "treasury-rules-0175"
    salience 1
when
    $o : TreasuryApplicant0108(amount <= 4000, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

