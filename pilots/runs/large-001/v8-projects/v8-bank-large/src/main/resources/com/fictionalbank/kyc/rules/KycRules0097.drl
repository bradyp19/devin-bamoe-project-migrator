package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryAccount0055;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0097 High Value"
    ruleflow-group "kyc-rules-0097"
    salience 10
when
    $o : TreasuryAccount0055(amount > 900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0097 Low Score"
    ruleflow-group "kyc-rules-0097"
    salience 5
when
    $o : TreasuryAccount0055(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0097 Standard"
    ruleflow-group "kyc-rules-0097"
    salience 1
when
    $o : TreasuryAccount0055(amount <= 900, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

