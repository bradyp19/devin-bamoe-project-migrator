package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.KycAccount0175;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0294 High Value"
    ruleflow-group "treasury-rules-0294"
    salience 10
when
    $o : KycAccount0175(amount > 4200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0294 Low Score"
    ruleflow-group "treasury-rules-0294"
    salience 5
when
    $o : KycAccount0175(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0294 Standard"
    ruleflow-group "treasury-rules-0294"
    salience 1
when
    $o : KycAccount0175(amount <= 4200, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

