package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.KycAccount0205;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0341 High Value"
    ruleflow-group "treasury-rules-0341"
    salience 10
when
    $o : KycAccount0205(amount > 4800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new KycAccount0205());
    update($o);
end

rule "Treasury R0341 Low Score"
    ruleflow-group "treasury-rules-0341"
    salience 5
when
    $o : KycAccount0205(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0341 Standard"
    ruleflow-group "treasury-rules-0341"
    salience 1
when
    $o : KycAccount0205(amount <= 4800, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

