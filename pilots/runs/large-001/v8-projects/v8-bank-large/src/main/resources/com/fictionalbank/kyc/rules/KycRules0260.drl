package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsPayment0152;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0260 High Value"
    ruleflow-group "kyc-rules-0260"
    salience 10
when
    $o : PaymentsPayment0152(amount > 4000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0260 Low Score"
    ruleflow-group "kyc-rules-0260"
    salience 5
when
    $o : PaymentsPayment0152(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0260 Standard"
    ruleflow-group "kyc-rules-0260"
    salience 1
when
    $o : PaymentsPayment0152(amount <= 4000, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

