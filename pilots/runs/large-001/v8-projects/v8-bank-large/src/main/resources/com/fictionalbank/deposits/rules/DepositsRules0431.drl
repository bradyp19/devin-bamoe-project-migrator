package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycCard0261;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0431 High Value"
    ruleflow-group "deposits-rules-0431"
    salience 10
when
    $o : KycCard0261(amount > 1250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new KycCard0261());
    update($o);
end

rule "Deposits R0431 Low Score"
    ruleflow-group "deposits-rules-0431"
    salience 5
when
    $o : KycCard0261(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0431 Standard"
    ruleflow-group "deposits-rules-0431"
    salience 1
when
    $o : KycCard0261(amount <= 1250, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

