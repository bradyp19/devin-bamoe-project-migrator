package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsPayment0218;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0365 High Value"
    ruleflow-group "payments-rules-0365"
    salience 10
when
    $o : DepositsPayment0218(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0365 Low Score"
    ruleflow-group "payments-rules-0365"
    salience 5
when
    $o : DepositsPayment0218(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0365 Standard"
    ruleflow-group "payments-rules-0365"
    salience 1
when
    $o : DepositsPayment0218(amount <= 1550, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

