package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.FraudApplicant0270;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0442 High Value"
    ruleflow-group "kyc-rules-0442"
    salience 10
when
    $o : FraudApplicant0270(amount > 850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0442 Low Score"
    ruleflow-group "kyc-rules-0442"
    salience 5
when
    $o : FraudApplicant0270(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0442 Standard"
    ruleflow-group "kyc-rules-0442"
    salience 1
when
    $o : FraudApplicant0270(amount <= 850, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

