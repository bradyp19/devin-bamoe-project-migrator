package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.PaymentsParty0245;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0408 High Value"
    ruleflow-group "treasury-rules-0408"
    salience 10
when
    $o : PaymentsParty0245(amount > 4300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0408 Low Score"
    ruleflow-group "treasury-rules-0408"
    salience 5
when
    $o : PaymentsParty0245(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0408 Standard"
    ruleflow-group "treasury-rules-0408"
    salience 1
when
    $o : PaymentsParty0245(amount <= 4300, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

