package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.CardsPayment0056;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0094 High Value"
    ruleflow-group "fraud-rules-0094"
    salience 10
when
    $o : CardsPayment0056(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0094 Low Score"
    ruleflow-group "fraud-rules-0094"
    salience 5
when
    $o : CardsPayment0056(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0094 Standard"
    ruleflow-group "fraud-rules-0094"
    salience 1
when
    $o : CardsPayment0056(amount <= 1800, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

