package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsParty0257;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0423 High Value"
    ruleflow-group "loans-rules-0423"
    salience 10
when
    $o : PaymentsParty0257(amount > 2800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0423 Low Score"
    ruleflow-group "loans-rules-0423"
    salience 5
when
    $o : PaymentsParty0257(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0423 Standard"
    ruleflow-group "loans-rules-0423"
    salience 1
when
    $o : PaymentsParty0257(amount <= 2800, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

