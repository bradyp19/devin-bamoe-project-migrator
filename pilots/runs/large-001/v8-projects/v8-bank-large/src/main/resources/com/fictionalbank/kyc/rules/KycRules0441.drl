package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.MortgageParty0269;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0441 High Value"
    ruleflow-group "kyc-rules-0441"
    salience 10
when
    $o : MortgageParty0269(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new MortgageParty0269());
    update($o);
end

rule "Kyc R0441 Low Score"
    ruleflow-group "kyc-rules-0441"
    salience 5
when
    $o : MortgageParty0269(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0441 Standard"
    ruleflow-group "kyc-rules-0441"
    salience 1
when
    $o : MortgageParty0269(amount <= 4350, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

