package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryApplicant0096;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0154 High Value"
    ruleflow-group "loans-rules-0154"
    salience 10
when
    $o : TreasuryApplicant0096(amount > 650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0154 Low Score"
    ruleflow-group "loans-rules-0154"
    salience 5
when
    $o : TreasuryApplicant0096(score < 710, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0154 Standard"
    ruleflow-group "loans-rules-0154"
    salience 1
when
    $o : TreasuryApplicant0096(amount <= 650, score >= 710, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

