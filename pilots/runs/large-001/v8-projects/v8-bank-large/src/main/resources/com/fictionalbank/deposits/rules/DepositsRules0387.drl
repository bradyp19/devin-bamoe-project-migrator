package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudAccount0229;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0387 High Value"
    ruleflow-group "deposits-rules-0387"
    salience 10
when
    $o : FraudAccount0229(amount > 4550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0387 Low Score"
    ruleflow-group "deposits-rules-0387"
    salience 5
when
    $o : FraudAccount0229(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0387 Standard"
    ruleflow-group "deposits-rules-0387"
    salience 1
when
    $o : FraudAccount0229(amount <= 4550, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

