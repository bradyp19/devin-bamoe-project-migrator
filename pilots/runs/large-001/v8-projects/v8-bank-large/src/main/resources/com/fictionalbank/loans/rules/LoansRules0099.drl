package com.fictionalbank.loans.rules;

import com.fictionalbank.model.MortgageApplicant0060;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0099 High Value"
    ruleflow-group "loans-rules-0099"
    salience 10
when
    $o : MortgageApplicant0060(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0099 Low Score"
    ruleflow-group "loans-rules-0099"
    salience 5
when
    $o : MortgageApplicant0060(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0099 Standard"
    ruleflow-group "loans-rules-0099"
    salience 1
when
    $o : MortgageApplicant0060(amount <= 3450, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

