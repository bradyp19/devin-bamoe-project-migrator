package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.DepositsPayment0062;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0103 High Value"
    ruleflow-group "mortgage-rules-0103"
    salience 10
when
    $o : DepositsPayment0062(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0103 Low Score"
    ruleflow-group "mortgage-rules-0103"
    salience 5
when
    $o : DepositsPayment0062(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0103 Standard"
    ruleflow-group "mortgage-rules-0103"
    salience 1
when
    $o : DepositsPayment0062(amount <= 2900, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

