package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudCase0184;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0304 High Value"
    ruleflow-group "cards-rules-0304"
    salience 10
when
    $o : FraudCase0184(amount > 1250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0304 Low Score"
    ruleflow-group "cards-rules-0304"
    salience 5
when
    $o : FraudCase0184(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0304 Standard"
    ruleflow-group "cards-rules-0304"
    salience 1
when
    $o : FraudCase0184(amount <= 1250, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

