package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsApplicant0090;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0147 High Value"
    ruleflow-group "treasury-rules-0147"
    salience 10
when
    $o : CardsApplicant0090(amount > 2450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0147 Low Score"
    ruleflow-group "treasury-rules-0147"
    salience 5
when
    $o : CardsApplicant0090(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0147 Standard"
    ruleflow-group "treasury-rules-0147"
    salience 1
when
    $o : CardsApplicant0090(amount <= 2450, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

