package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansPayment0290;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0483 High Value"
    ruleflow-group "treasury-rules-0483"
    salience 10
when
    $o : LoansPayment0290(amount > 2450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0483 Low Score"
    ruleflow-group "treasury-rules-0483"
    salience 5
when
    $o : LoansPayment0290(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0483 Standard"
    ruleflow-group "treasury-rules-0483"
    salience 1
when
    $o : LoansPayment0290(amount <= 2450, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

