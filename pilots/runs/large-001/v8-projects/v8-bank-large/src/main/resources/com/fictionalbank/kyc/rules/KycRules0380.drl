package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsPayment0224;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0380 High Value"
    ruleflow-group "kyc-rules-0380"
    salience 10
when
    $o : CardsPayment0224(amount > 4700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0380 Low Score"
    ruleflow-group "kyc-rules-0380"
    salience 5
when
    $o : CardsPayment0224(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0380 Standard"
    ruleflow-group "kyc-rules-0380"
    salience 1
when
    $o : CardsPayment0224(amount <= 4700, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

