package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.DepositsCard0225;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0376 High Value"
    ruleflow-group "treasury-rules-0376"
    salience 10
when
    $o : DepositsCard0225(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0376 Low Score"
    ruleflow-group "treasury-rules-0376"
    salience 5
when
    $o : DepositsCard0225(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0376 Standard"
    ruleflow-group "treasury-rules-0376"
    salience 1
when
    $o : DepositsCard0225(amount <= 3650, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

