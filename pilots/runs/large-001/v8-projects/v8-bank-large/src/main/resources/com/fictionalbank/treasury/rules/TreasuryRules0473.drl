package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.TreasuryPayment0284;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0473 High Value"
    ruleflow-group "treasury-rules-0473"
    salience 10
when
    $o : TreasuryPayment0284(amount > 4200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0473 Low Score"
    ruleflow-group "treasury-rules-0473"
    salience 5
when
    $o : TreasuryPayment0284(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0473 Standard"
    ruleflow-group "treasury-rules-0473"
    salience 1
when
    $o : TreasuryPayment0284(amount <= 4200, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

