package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycCase0274;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0453 High Value"
    ruleflow-group "cards-rules-0453"
    salience 10
when
    $o : KycCase0274(amount > 3500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0453 Low Score"
    ruleflow-group "cards-rules-0453"
    salience 5
when
    $o : KycCase0274(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0453 Standard"
    ruleflow-group "cards-rules-0453"
    salience 1
when
    $o : KycCase0274(amount <= 3500, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

