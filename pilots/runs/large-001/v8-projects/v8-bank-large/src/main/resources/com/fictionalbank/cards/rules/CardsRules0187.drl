package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsApplicant0114;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0187 High Value"
    ruleflow-group "cards-rules-0187"
    salience 10
when
    $o : DepositsApplicant0114(amount > 1500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0187 Low Score"
    ruleflow-group "cards-rules-0187"
    salience 5
when
    $o : DepositsApplicant0114(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0187 Standard"
    ruleflow-group "cards-rules-0187"
    salience 1
when
    $o : DepositsApplicant0114(amount <= 1500, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

