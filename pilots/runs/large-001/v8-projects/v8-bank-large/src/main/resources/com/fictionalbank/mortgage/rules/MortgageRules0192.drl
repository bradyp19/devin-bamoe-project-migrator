package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryPayment0116;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0192 High Value"
    ruleflow-group "mortgage-rules-0192"
    salience 10
when
    $o : TreasuryPayment0116(amount > 2050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0192 Low Score"
    ruleflow-group "mortgage-rules-0192"
    salience 5
when
    $o : TreasuryPayment0116(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0192 Standard"
    ruleflow-group "mortgage-rules-0192"
    salience 1
when
    $o : TreasuryPayment0116(amount <= 2050, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

