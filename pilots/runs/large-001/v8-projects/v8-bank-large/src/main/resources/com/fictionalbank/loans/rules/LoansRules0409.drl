package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryPayment0242;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0409 High Value"
    ruleflow-group "loans-rules-0409"
    salience 10
when
    $o : TreasuryPayment0242(amount > 1200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0409 Low Score"
    ruleflow-group "loans-rules-0409"
    salience 5
when
    $o : TreasuryPayment0242(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0409 Standard"
    ruleflow-group "loans-rules-0409"
    salience 1
when
    $o : TreasuryPayment0242(amount <= 1200, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

