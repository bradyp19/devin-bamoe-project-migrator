package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryParty0059;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0092 High Value"
    ruleflow-group "fraud-rules-0092"
    salience 10
when
    $o : TreasuryParty0059(amount > 4500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0092 Low Score"
    ruleflow-group "fraud-rules-0092"
    salience 5
when
    $o : TreasuryParty0059(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0092 Standard"
    ruleflow-group "fraud-rules-0092"
    salience 1
when
    $o : TreasuryParty0059(amount <= 4500, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

