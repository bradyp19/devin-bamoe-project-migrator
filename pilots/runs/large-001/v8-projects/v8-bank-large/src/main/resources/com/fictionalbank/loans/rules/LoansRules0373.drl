package com.fictionalbank.loans.rules;

import com.fictionalbank.model.PaymentsCase0226;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0373 High Value"
    ruleflow-group "loans-rules-0373"
    salience 10
when
    $o : PaymentsCase0226(amount > 1450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0373 Low Score"
    ruleflow-group "loans-rules-0373"
    salience 5
when
    $o : PaymentsCase0226(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0373 Standard"
    ruleflow-group "loans-rules-0373"
    salience 1
when
    $o : PaymentsCase0226(amount <= 1450, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

