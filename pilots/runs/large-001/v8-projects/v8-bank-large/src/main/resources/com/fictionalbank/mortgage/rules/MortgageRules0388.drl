package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryApplicant0234;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0388 High Value"
    ruleflow-group "mortgage-rules-0388"
    salience 10
when
    $o : TreasuryApplicant0234(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0388 Low Score"
    ruleflow-group "mortgage-rules-0388"
    salience 5
when
    $o : TreasuryApplicant0234(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0388 Standard"
    ruleflow-group "mortgage-rules-0388"
    salience 1
when
    $o : TreasuryApplicant0234(amount <= 3950, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

