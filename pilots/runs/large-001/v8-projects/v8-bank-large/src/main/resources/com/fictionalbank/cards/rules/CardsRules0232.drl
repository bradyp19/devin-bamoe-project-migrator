package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycPayment0140;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0232 High Value"
    ruleflow-group "cards-rules-0232"
    salience 10
when
    $o : KycPayment0140(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0232 Low Score"
    ruleflow-group "cards-rules-0232"
    salience 5
when
    $o : KycPayment0140(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0232 Standard"
    ruleflow-group "cards-rules-0232"
    salience 1
when
    $o : KycPayment0140(amount <= 2550, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

