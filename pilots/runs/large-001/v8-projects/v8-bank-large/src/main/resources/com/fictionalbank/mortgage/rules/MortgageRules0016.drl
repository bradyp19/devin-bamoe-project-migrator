package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.FraudCard0009;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0016 High Value"
    ruleflow-group "mortgage-rules-0016"
    salience 10
when
    $o : FraudCard0009(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0016 Low Score"
    ruleflow-group "mortgage-rules-0016"
    salience 5
when
    $o : FraudCard0009(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0016 Standard"
    ruleflow-group "mortgage-rules-0016"
    salience 1
when
    $o : FraudCard0009(amount <= 3450, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

