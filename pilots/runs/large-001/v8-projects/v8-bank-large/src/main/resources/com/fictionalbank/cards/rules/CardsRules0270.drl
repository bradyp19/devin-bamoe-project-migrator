package com.fictionalbank.cards.rules;

import com.fictionalbank.model.MortgageCase0160;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0270 High Value"
    ruleflow-group "cards-rules-0270"
    salience 10
when
    $o : MortgageCase0160(amount > 4650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0270 Low Score"
    ruleflow-group "cards-rules-0270"
    salience 5
when
    $o : MortgageCase0160(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0270 Standard"
    ruleflow-group "cards-rules-0270"
    salience 1
when
    $o : MortgageCase0160(amount <= 4650, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

