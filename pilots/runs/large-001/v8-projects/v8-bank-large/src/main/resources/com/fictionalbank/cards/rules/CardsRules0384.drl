package com.fictionalbank.cards.rules;

import com.fictionalbank.model.FraudAccount0229;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0384 High Value"
    ruleflow-group "cards-rules-0384"
    salience 10
when
    $o : FraudAccount0229(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0384 Low Score"
    ruleflow-group "cards-rules-0384"
    salience 5
when
    $o : FraudAccount0229(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0384 Standard"
    ruleflow-group "cards-rules-0384"
    salience 1
when
    $o : FraudAccount0229(amount <= 2950, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

