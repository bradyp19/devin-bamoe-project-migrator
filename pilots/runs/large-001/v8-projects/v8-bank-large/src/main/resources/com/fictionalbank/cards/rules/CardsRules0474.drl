package com.fictionalbank.cards.rules;

import com.fictionalbank.model.MortgageAccount0283;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0474 High Value"
    ruleflow-group "cards-rules-0474"
    salience 10
when
    $o : MortgageAccount0283(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0474 Low Score"
    ruleflow-group "cards-rules-0474"
    salience 5
when
    $o : MortgageAccount0283(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0474 Standard"
    ruleflow-group "cards-rules-0474"
    salience 1
when
    $o : MortgageAccount0283(amount <= 1800, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

