package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycApplicant0222;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0364 High Value"
    ruleflow-group "deposits-rules-0364"
    salience 10
when
    $o : KycApplicant0222(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0364 Low Score"
    ruleflow-group "deposits-rules-0364"
    salience 5
when
    $o : KycApplicant0222(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0364 Standard"
    ruleflow-group "deposits-rules-0364"
    salience 1
when
    $o : KycApplicant0222(amount <= 800, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

