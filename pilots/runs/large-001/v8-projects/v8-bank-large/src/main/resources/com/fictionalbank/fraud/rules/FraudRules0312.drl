package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.TreasuryCase0190;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0312 High Value"
    ruleflow-group "fraud-rules-0312"
    salience 10
when
    $o : TreasuryCase0190(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0312 Low Score"
    ruleflow-group "fraud-rules-0312"
    salience 5
when
    $o : TreasuryCase0190(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0312 Standard"
    ruleflow-group "fraud-rules-0312"
    salience 1
when
    $o : TreasuryCase0190(amount <= 3450, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

