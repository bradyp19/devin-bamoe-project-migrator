package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCard0273;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0459 High Value"
    ruleflow-group "deposits-rules-0459"
    salience 10
when
    $o : FraudCard0273(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0459 Low Score"
    ruleflow-group "deposits-rules-0459"
    salience 5
when
    $o : FraudCard0273(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0459 Standard"
    ruleflow-group "deposits-rules-0459"
    salience 1
when
    $o : FraudCard0273(amount <= 1800, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

