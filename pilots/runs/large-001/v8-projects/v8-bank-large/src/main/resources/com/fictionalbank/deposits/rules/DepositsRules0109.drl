package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudApplicant0066;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0109 High Value"
    ruleflow-group "deposits-rules-0109"
    salience 10
when
    $o : FraudApplicant0066(amount > 4950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0109 Low Score"
    ruleflow-group "deposits-rules-0109"
    salience 5
when
    $o : FraudApplicant0066(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0109 Standard"
    ruleflow-group "deposits-rules-0109"
    salience 1
when
    $o : FraudApplicant0066(amount <= 4950, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

