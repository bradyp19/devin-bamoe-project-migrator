package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.PaymentsAccount0031;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0057 High Value"
    ruleflow-group "mortgage-rules-0057"
    salience 10
when
    $o : PaymentsAccount0031(amount > 2900, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0057 Low Score"
    ruleflow-group "mortgage-rules-0057"
    salience 5
when
    $o : PaymentsAccount0031(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0057 Standard"
    ruleflow-group "mortgage-rules-0057"
    salience 1
when
    $o : PaymentsAccount0031(amount <= 2900, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

