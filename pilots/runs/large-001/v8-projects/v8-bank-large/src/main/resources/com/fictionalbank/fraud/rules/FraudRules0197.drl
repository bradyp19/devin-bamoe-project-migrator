package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudApplicant0120;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0197 High Value"
    ruleflow-group "fraud-rules-0197"
    salience 10
when
    $o : FraudApplicant0120(amount > 4800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0197 Low Score"
    ruleflow-group "fraud-rules-0197"
    salience 5
when
    $o : FraudApplicant0120(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0197 Standard"
    ruleflow-group "fraud-rules-0197"
    salience 1
when
    $o : FraudApplicant0120(amount <= 4800, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

