package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycAccount0205;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0345 High Value"
    ruleflow-group "fraud-rules-0345"
    salience 10
when
    $o : KycAccount0205(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0345 Low Score"
    ruleflow-group "fraud-rules-0345"
    salience 5
when
    $o : KycAccount0205(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0345 Standard"
    ruleflow-group "fraud-rules-0345"
    salience 1
when
    $o : KycAccount0205(amount <= 2200, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

