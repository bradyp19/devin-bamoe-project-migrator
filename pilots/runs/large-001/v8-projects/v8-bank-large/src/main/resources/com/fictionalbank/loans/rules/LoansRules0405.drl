package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsApplicant0246;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0405 High Value"
    ruleflow-group "loans-rules-0405"
    salience 10
when
    $o : DepositsApplicant0246(amount > 800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0405 Low Score"
    ruleflow-group "loans-rules-0405"
    salience 5
when
    $o : DepositsApplicant0246(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0405 Standard"
    ruleflow-group "loans-rules-0405"
    salience 1
when
    $o : DepositsApplicant0246(amount <= 800, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

