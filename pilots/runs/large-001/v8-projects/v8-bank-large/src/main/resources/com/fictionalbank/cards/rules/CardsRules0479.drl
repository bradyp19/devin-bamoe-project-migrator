package com.fictionalbank.cards.rules;

import com.fictionalbank.model.LoansApplicant0288;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0479 High Value"
    ruleflow-group "cards-rules-0479"
    salience 10
when
    $o : LoansApplicant0288(amount > 4300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0479 Low Score"
    ruleflow-group "cards-rules-0479"
    salience 5
when
    $o : LoansApplicant0288(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0479 Standard"
    ruleflow-group "cards-rules-0479"
    salience 1
when
    $o : LoansApplicant0288(amount <= 4300, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

