package com.fictionalbank.cards.rules;

import com.fictionalbank.model.DepositsApplicant0072;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0119 High Value"
    ruleflow-group "cards-rules-0119"
    salience 10
when
    $o : DepositsApplicant0072(amount > 2200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0119 Low Score"
    ruleflow-group "cards-rules-0119"
    salience 5
when
    $o : DepositsApplicant0072(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0119 Standard"
    ruleflow-group "cards-rules-0119"
    salience 1
when
    $o : DepositsApplicant0072(amount <= 2200, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

