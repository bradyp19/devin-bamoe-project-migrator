package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.FraudCard0129;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0213 High Value"
    ruleflow-group "deposits-rules-0213"
    salience 10
when
    $o : FraudCard0129(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0213 Low Score"
    ruleflow-group "deposits-rules-0213"
    salience 5
when
    $o : FraudCard0129(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0213 Standard"
    ruleflow-group "deposits-rules-0213"
    salience 1
when
    $o : FraudCard0129(amount <= 1000, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

