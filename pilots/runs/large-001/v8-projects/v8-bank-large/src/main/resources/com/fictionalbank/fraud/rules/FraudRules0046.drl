package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.KycAccount0025;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0046 High Value"
    ruleflow-group "fraud-rules-0046"
    salience 10
when
    $o : KycAccount0025(amount > 3150, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0046 Low Score"
    ruleflow-group "fraud-rules-0046"
    salience 5
when
    $o : KycAccount0025(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0046 Standard"
    ruleflow-group "fraud-rules-0046"
    salience 1
when
    $o : KycAccount0025(amount <= 3150, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

