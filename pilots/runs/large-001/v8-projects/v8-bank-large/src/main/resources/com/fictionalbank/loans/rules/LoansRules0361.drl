package com.fictionalbank.loans.rules;

import com.fictionalbank.model.CardsAccount0217;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0361 High Value"
    ruleflow-group "loans-rules-0361"
    salience 10
when
    $o : CardsAccount0217(amount > 1800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new CardsAccount0217());
    update($o);
end

rule "Loans R0361 Low Score"
    ruleflow-group "loans-rules-0361"
    salience 5
when
    $o : CardsAccount0217(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0361 Standard"
    ruleflow-group "loans-rules-0361"
    salience 1
when
    $o : CardsAccount0217(amount <= 1800, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

