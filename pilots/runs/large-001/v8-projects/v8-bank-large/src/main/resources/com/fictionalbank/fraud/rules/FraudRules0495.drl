package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.DepositsPayment0296;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0495 High Value"
    ruleflow-group "fraud-rules-0495"
    salience 10
when
    $o : DepositsPayment0296(amount > 1600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0495 Low Score"
    ruleflow-group "fraud-rules-0495"
    salience 5
when
    $o : DepositsPayment0296(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0495 Standard"
    ruleflow-group "fraud-rules-0495"
    salience 1
when
    $o : DepositsPayment0296(amount <= 1600, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

