package com.fictionalbank.payments.rules;

import com.fictionalbank.model.KycAccount0073;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0128 High Value"
    ruleflow-group "payments-rules-0128"
    salience 10
when
    $o : KycAccount0073(amount > 1700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0128 Low Score"
    ruleflow-group "payments-rules-0128"
    salience 5
when
    $o : KycAccount0073(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0128 Standard"
    ruleflow-group "payments-rules-0128"
    salience 1
when
    $o : KycAccount0073(amount <= 1700, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

