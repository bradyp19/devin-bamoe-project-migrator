package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsPayment0248;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0420 High Value"
    ruleflow-group "kyc-rules-0420"
    salience 10
when
    $o : CardsPayment0248(amount > 3350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0420 Low Score"
    ruleflow-group "kyc-rules-0420"
    salience 5
when
    $o : CardsPayment0248(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0420 Standard"
    ruleflow-group "kyc-rules-0420"
    salience 1
when
    $o : CardsPayment0248(amount <= 3350, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

