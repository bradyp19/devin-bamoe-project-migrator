package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.MortgageAccount0037;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0062 High Value"
    ruleflow-group "fraud-rules-0062"
    salience 10
when
    $o : MortgageAccount0037(amount > 2350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0062 Low Score"
    ruleflow-group "fraud-rules-0062"
    salience 5
when
    $o : MortgageAccount0037(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0062 Standard"
    ruleflow-group "fraud-rules-0062"
    salience 1
when
    $o : MortgageAccount0037(amount <= 2350, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

