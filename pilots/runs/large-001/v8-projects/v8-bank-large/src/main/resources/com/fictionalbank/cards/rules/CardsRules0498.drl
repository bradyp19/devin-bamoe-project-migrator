package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsCase0298;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0498 High Value"
    ruleflow-group "cards-rules-0498"
    salience 10
when
    $o : PaymentsCase0298(amount > 4200, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0498 Low Score"
    ruleflow-group "cards-rules-0498"
    salience 5
when
    $o : PaymentsCase0298(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0498 Standard"
    ruleflow-group "cards-rules-0498"
    salience 1
when
    $o : PaymentsCase0298(amount <= 4200, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

