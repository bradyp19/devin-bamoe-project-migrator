package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsParty0125;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0204 High Value"
    ruleflow-group "payments-rules-0204"
    salience 10
when
    $o : DepositsParty0125(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0204 Low Score"
    ruleflow-group "payments-rules-0204"
    salience 5
when
    $o : DepositsParty0125(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0204 Standard"
    ruleflow-group "payments-rules-0204"
    salience 1
when
    $o : DepositsParty0125(amount <= 2950, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

