package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.LoansCard0021;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0031 High Value"
    ruleflow-group "fraud-rules-0031"
    salience 10
when
    $o : LoansCard0021(amount > 4350, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new LoansCard0021());
    update($o);
end

rule "Fraud R0031 Low Score"
    ruleflow-group "fraud-rules-0031"
    salience 5
when
    $o : LoansCard0021(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0031 Standard"
    ruleflow-group "fraud-rules-0031"
    salience 1
when
    $o : LoansCard0021(amount <= 4350, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

