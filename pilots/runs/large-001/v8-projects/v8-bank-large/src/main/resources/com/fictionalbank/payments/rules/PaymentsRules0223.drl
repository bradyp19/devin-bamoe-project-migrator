package com.fictionalbank.payments.rules;

import com.fictionalbank.model.FraudCard0135;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0223 High Value"
    ruleflow-group "payments-rules-0223"
    salience 10
when
    $o : FraudCard0135(amount > 3100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0223 Low Score"
    ruleflow-group "payments-rules-0223"
    salience 5
when
    $o : FraudCard0135(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0223 Standard"
    ruleflow-group "payments-rules-0223"
    salience 1
when
    $o : FraudCard0135(amount <= 3100, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

