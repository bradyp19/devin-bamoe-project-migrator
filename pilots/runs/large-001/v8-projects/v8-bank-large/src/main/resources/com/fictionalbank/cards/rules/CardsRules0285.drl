package com.fictionalbank.cards.rules;

import com.fictionalbank.model.CardsPayment0170;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0285 High Value"
    ruleflow-group "cards-rules-0285"
    salience 10
when
    $o : CardsPayment0170(amount > 2300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0285 Low Score"
    ruleflow-group "cards-rules-0285"
    salience 5
when
    $o : CardsPayment0170(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0285 Standard"
    ruleflow-group "cards-rules-0285"
    salience 1
when
    $o : CardsPayment0170(amount <= 2300, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

