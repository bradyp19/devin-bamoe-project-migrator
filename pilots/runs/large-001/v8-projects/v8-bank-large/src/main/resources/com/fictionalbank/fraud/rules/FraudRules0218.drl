package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.FraudCard0129;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0218 High Value"
    ruleflow-group "fraud-rules-0218"
    salience 10
when
    $o : FraudCard0129(amount > 2100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0218 Low Score"
    ruleflow-group "fraud-rules-0218"
    salience 5
when
    $o : FraudCard0129(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0218 Standard"
    ruleflow-group "fraud-rules-0218"
    salience 1
when
    $o : FraudCard0129(amount <= 2100, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

