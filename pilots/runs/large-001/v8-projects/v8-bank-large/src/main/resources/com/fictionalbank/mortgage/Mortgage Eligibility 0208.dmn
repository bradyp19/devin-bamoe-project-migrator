<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/mortgage/eligibility0208" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0208" name="Mortgage Eligibility 0208" namespace="https://fictionalbank.example/dmn/mortgage/eligibility0208">
  <dmn:inputData id="_in0208_age" name="Age">
    <dmn:variable id="_in0208_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0208_amount" name="Amount">
    <dmn:variable id="_in0208_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0208" name="Eligible">
    <dmn:variable id="_dec0208_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0208a">
      <dmn:requiredInput href="#_in0208_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0208b">
      <dmn:requiredInput href="#_in0208_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0208" hitPolicy="FIRST">
      <dmn:input id="_dt0208_i1"><dmn:inputExpression id="_dt0208_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0208_i2"><dmn:inputExpression id="_dt0208_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0208_o1"/>
      <dmn:rule id="_dt0208_r1">
        <dmn:inputEntry id="_dt0208_r1a"><dmn:text>&lt; 24</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0208_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0208_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0208_r2">
        <dmn:inputEntry id="_dt0208_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0208_r2b"><dmn:text>&lt;= 15500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0208_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0208_r3">
        <dmn:inputEntry id="_dt0208_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0208_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0208_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
