package com.fictionalbank.loans.rules;

import com.fictionalbank.model.CardsCase0148;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0248 High Value"
    ruleflow-group "loans-rules-0248"
    salience 10
when
    $o : CardsCase0148(amount > 1550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0248 Low Score"
    ruleflow-group "loans-rules-0248"
    salience 5
when
    $o : CardsCase0148(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0248 Standard"
    ruleflow-group "loans-rules-0248"
    salience 1
when
    $o : CardsCase0148(amount <= 1550, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

