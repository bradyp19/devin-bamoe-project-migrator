<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/treasury/eligibility0128" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0128" name="Treasury Eligibility 0128" namespace="https://fictionalbank.example/dmn/treasury/eligibility0128">
  <dmn:inputData id="_in0128_age" name="Age">
    <dmn:variable id="_in0128_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0128_amount" name="Amount">
    <dmn:variable id="_in0128_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0128" name="Eligible">
    <dmn:variable id="_dec0128_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0128a">
      <dmn:requiredInput href="#_in0128_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0128b">
      <dmn:requiredInput href="#_in0128_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0128" hitPolicy="FIRST">
      <dmn:input id="_dt0128_i1"><dmn:inputExpression id="_dt0128_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0128_i2"><dmn:inputExpression id="_dt0128_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0128_o1"/>
      <dmn:rule id="_dt0128_r1">
        <dmn:inputEntry id="_dt0128_r1a"><dmn:text>&lt; 19</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0128_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0128_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0128_r2">
        <dmn:inputEntry id="_dt0128_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0128_r2b"><dmn:text>&lt;= 17000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0128_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0128_r3">
        <dmn:inputEntry id="_dt0128_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0128_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0128_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
