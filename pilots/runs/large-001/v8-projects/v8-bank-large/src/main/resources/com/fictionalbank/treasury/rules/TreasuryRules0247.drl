package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.KycPayment0146;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0247 High Value"
    ruleflow-group "treasury-rules-0247"
    salience 10
when
    $o : KycPayment0146(amount > 2250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0247 Low Score"
    ruleflow-group "treasury-rules-0247"
    salience 5
when
    $o : KycPayment0146(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0247 Standard"
    ruleflow-group "treasury-rules-0247"
    salience 1
when
    $o : KycPayment0146(amount <= 2250, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

