package com.fictionalbank.cards.rules;

import com.fictionalbank.model.TreasuryCase0076;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0121 High Value"
    ruleflow-group "cards-rules-0121"
    salience 10
when
    $o : TreasuryCase0076(amount > 3700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new TreasuryCase0076());
    update($o);
end

rule "Cards R0121 Low Score"
    ruleflow-group "cards-rules-0121"
    salience 5
when
    $o : TreasuryCase0076(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0121 Standard"
    ruleflow-group "cards-rules-0121"
    salience 1
when
    $o : TreasuryCase0076(amount <= 3700, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

