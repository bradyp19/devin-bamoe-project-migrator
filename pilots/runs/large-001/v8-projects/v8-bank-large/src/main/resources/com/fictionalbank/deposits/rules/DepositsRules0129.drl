package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsApplicant0078;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0129 High Value"
    ruleflow-group "deposits-rules-0129"
    salience 10
when
    $o : DepositsApplicant0078(amount > 4700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0129 Low Score"
    ruleflow-group "deposits-rules-0129"
    salience 5
when
    $o : DepositsApplicant0078(score < 690, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0129 Standard"
    ruleflow-group "deposits-rules-0129"
    salience 1
when
    $o : DepositsApplicant0078(amount <= 4700, score >= 690, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

