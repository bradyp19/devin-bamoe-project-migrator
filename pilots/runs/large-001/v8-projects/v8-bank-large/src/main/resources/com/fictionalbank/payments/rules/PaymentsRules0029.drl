package com.fictionalbank.payments.rules;

import com.fictionalbank.model.CardsApplicant0018;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0029 High Value"
    ruleflow-group "payments-rules-0029"
    salience 10
when
    $o : CardsApplicant0018(amount > 1250, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0029 Low Score"
    ruleflow-group "payments-rules-0029"
    salience 5
when
    $o : CardsApplicant0018(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0029 Standard"
    ruleflow-group "payments-rules-0029"
    salience 1
when
    $o : CardsApplicant0018(amount <= 1250, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

