package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.CardsCase0148;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0242 High Value"
    ruleflow-group "deposits-rules-0242"
    salience 10
when
    $o : CardsCase0148(amount > 4050, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0242 Low Score"
    ruleflow-group "deposits-rules-0242"
    salience 5
when
    $o : CardsCase0148(score < 610, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0242 Standard"
    ruleflow-group "deposits-rules-0242"
    salience 1
when
    $o : CardsCase0148(amount <= 4050, score >= 610, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

