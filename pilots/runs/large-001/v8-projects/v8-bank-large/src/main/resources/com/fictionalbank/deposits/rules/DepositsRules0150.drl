package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.PaymentsCard0087;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0150 High Value"
    ruleflow-group "deposits-rules-0150"
    salience 10
when
    $o : PaymentsCard0087(amount > 1850, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0150 Low Score"
    ruleflow-group "deposits-rules-0150"
    salience 5
when
    $o : PaymentsCard0087(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0150 Standard"
    ruleflow-group "deposits-rules-0150"
    salience 1
when
    $o : PaymentsCard0087(amount <= 1850, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

