package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.TreasuryParty0089;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0144 High Value"
    ruleflow-group "kyc-rules-0144"
    salience 10
when
    $o : TreasuryParty0089(amount > 3400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0144 Low Score"
    ruleflow-group "kyc-rules-0144"
    salience 5
when
    $o : TreasuryParty0089(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0144 Standard"
    ruleflow-group "kyc-rules-0144"
    salience 1
when
    $o : TreasuryParty0089(amount <= 3400, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

