package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.TreasuryApplicant0192;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0314 High Value"
    ruleflow-group "mortgage-rules-0314"
    salience 10
when
    $o : TreasuryApplicant0192(amount > 2450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0314 Low Score"
    ruleflow-group "mortgage-rules-0314"
    salience 5
when
    $o : TreasuryApplicant0192(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0314 Standard"
    ruleflow-group "mortgage-rules-0314"
    salience 1
when
    $o : TreasuryApplicant0192(amount <= 2450, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

