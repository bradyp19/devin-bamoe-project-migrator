package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryParty0041;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0061 High Value"
    ruleflow-group "deposits-rules-0061"
    salience 10
when
    $o : TreasuryParty0041(amount > 2650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new TreasuryParty0041());
    update($o);
end

rule "Deposits R0061 Low Score"
    ruleflow-group "deposits-rules-0061"
    salience 5
when
    $o : TreasuryParty0041(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0061 Standard"
    ruleflow-group "deposits-rules-0061"
    salience 1
when
    $o : TreasuryParty0041(amount <= 2650, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

