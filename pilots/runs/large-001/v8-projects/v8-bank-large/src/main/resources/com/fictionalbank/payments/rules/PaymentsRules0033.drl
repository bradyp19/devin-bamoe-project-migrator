package com.fictionalbank.payments.rules;

import com.fictionalbank.model.FraudApplicant0024;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0033 High Value"
    ruleflow-group "payments-rules-0033"
    salience 10
when
    $o : FraudApplicant0024(amount > 3450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0033 Low Score"
    ruleflow-group "payments-rules-0033"
    salience 5
when
    $o : FraudApplicant0024(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0033 Standard"
    ruleflow-group "payments-rules-0033"
    salience 1
when
    $o : FraudApplicant0024(amount <= 3450, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

