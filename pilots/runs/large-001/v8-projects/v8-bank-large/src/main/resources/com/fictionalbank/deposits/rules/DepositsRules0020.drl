package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsApplicant0012;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0020 High Value"
    ruleflow-group "deposits-rules-0020"
    salience 10
when
    $o : DepositsApplicant0012(amount > 550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0020 Low Score"
    ruleflow-group "deposits-rules-0020"
    salience 5
when
    $o : DepositsApplicant0012(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0020 Standard"
    ruleflow-group "deposits-rules-0020"
    salience 1
when
    $o : DepositsApplicant0012(amount <= 550, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

