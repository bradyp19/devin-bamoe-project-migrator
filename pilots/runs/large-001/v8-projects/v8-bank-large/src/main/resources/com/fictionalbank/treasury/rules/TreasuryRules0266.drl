package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsAccount0157;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0266 High Value"
    ruleflow-group "treasury-rules-0266"
    salience 10
when
    $o : CardsAccount0157(amount > 4500, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0266 Low Score"
    ruleflow-group "treasury-rules-0266"
    salience 5
when
    $o : CardsAccount0157(score < 680, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0266 Standard"
    ruleflow-group "treasury-rules-0266"
    salience 1
when
    $o : CardsAccount0157(amount <= 4500, score >= 680, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

