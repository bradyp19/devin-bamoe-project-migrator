package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.CardsCase0154;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0257 High Value"
    ruleflow-group "kyc-rules-0257"
    salience 10
when
    $o : CardsCase0154(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0257 Low Score"
    ruleflow-group "kyc-rules-0257"
    salience 5
when
    $o : CardsCase0154(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0257 Standard"
    ruleflow-group "kyc-rules-0257"
    salience 1
when
    $o : CardsCase0154(amount <= 3650, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

