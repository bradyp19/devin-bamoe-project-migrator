package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.KycPayment0140;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0231 High Value"
    ruleflow-group "deposits-rules-0231"
    salience 10
when
    $o : KycPayment0140(amount > 2100, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new KycPayment0140());
    update($o);
end

rule "Deposits R0231 Low Score"
    ruleflow-group "deposits-rules-0231"
    salience 5
when
    $o : KycPayment0140(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0231 Standard"
    ruleflow-group "deposits-rules-0231"
    salience 1
when
    $o : KycPayment0140(amount <= 2100, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

