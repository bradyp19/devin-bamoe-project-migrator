package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.TreasuryApplicant0096;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0151 High Value"
    ruleflow-group "deposits-rules-0151"
    salience 10
when
    $o : TreasuryApplicant0096(amount > 3700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new TreasuryApplicant0096());
    update($o);
end

rule "Deposits R0151 Low Score"
    ruleflow-group "deposits-rules-0151"
    salience 5
when
    $o : TreasuryApplicant0096(score < 670, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0151 Standard"
    ruleflow-group "deposits-rules-0151"
    salience 1
when
    $o : TreasuryApplicant0096(amount <= 3700, score >= 670, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

