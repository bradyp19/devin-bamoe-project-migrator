package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansPayment0266;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0450 High Value"
    ruleflow-group "loans-rules-0450"
    salience 10
when
    $o : LoansPayment0266(amount > 4600, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0450 Low Score"
    ruleflow-group "loans-rules-0450"
    salience 5
when
    $o : LoansPayment0266(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0450 Standard"
    ruleflow-group "loans-rules-0450"
    salience 1
when
    $o : LoansPayment0266(amount <= 4600, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

