<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/payments/eligibility0189" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0189" name="Payments Eligibility 0189" namespace="https://fictionalbank.example/dmn/payments/eligibility0189">
  <dmn:inputData id="_in0189_age" name="Age">
    <dmn:variable id="_in0189_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0189_amount" name="Amount">
    <dmn:variable id="_in0189_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0189" name="Eligible">
    <dmn:variable id="_dec0189_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0189a">
      <dmn:requiredInput href="#_in0189_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0189b">
      <dmn:requiredInput href="#_in0189_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0189" hitPolicy="FIRST">
      <dmn:input id="_dt0189_i1"><dmn:inputExpression id="_dt0189_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0189_i2"><dmn:inputExpression id="_dt0189_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0189_o1"/>
      <dmn:rule id="_dt0189_r1">
        <dmn:inputEntry id="_dt0189_r1a"><dmn:text>&lt; 20</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0189_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0189_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0189_r2">
        <dmn:inputEntry id="_dt0189_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0189_r2b"><dmn:text>&lt;= 2500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0189_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0189_r3">
        <dmn:inputEntry id="_dt0189_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0189_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0189_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
