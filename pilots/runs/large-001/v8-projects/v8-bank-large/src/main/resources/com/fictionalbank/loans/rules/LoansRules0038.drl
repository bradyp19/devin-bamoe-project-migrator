package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansParty0023;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0038 High Value"
    ruleflow-group "loans-rules-0038"
    salience 10
when
    $o : LoansParty0023(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0038 Low Score"
    ruleflow-group "loans-rules-0038"
    salience 5
when
    $o : LoansParty0023(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0038 Standard"
    ruleflow-group "loans-rules-0038"
    salience 1
when
    $o : LoansParty0023(amount <= 950, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

