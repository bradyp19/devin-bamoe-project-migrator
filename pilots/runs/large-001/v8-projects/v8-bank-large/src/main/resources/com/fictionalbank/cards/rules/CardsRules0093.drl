package com.fictionalbank.cards.rules;

import com.fictionalbank.model.PaymentsCase0058;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0093 High Value"
    ruleflow-group "cards-rules-0093"
    salience 10
when
    $o : PaymentsCase0058(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0093 Low Score"
    ruleflow-group "cards-rules-0093"
    salience 5
when
    $o : PaymentsCase0058(score < 630, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0093 Standard"
    ruleflow-group "cards-rules-0093"
    salience 1
when
    $o : PaymentsCase0058(amount <= 2550, score >= 630, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

