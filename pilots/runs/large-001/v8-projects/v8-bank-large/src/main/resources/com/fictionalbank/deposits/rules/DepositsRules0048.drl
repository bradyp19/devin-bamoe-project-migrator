package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.PaymentsPayment0026;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0048 High Value"
    ruleflow-group "deposits-rules-0048"
    salience 10
when
    $o : PaymentsPayment0026(amount > 2750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0048 Low Score"
    ruleflow-group "deposits-rules-0048"
    salience 5
when
    $o : PaymentsPayment0026(score < 600, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0048 Standard"
    ruleflow-group "deposits-rules-0048"
    salience 1
when
    $o : PaymentsPayment0026(amount <= 2750, score >= 600, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

