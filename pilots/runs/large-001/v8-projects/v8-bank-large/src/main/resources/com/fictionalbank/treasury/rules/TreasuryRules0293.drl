package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansApplicant0180;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0293 High Value"
    ruleflow-group "treasury-rules-0293"
    salience 10
when
    $o : LoansApplicant0180(amount > 950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0293 Low Score"
    ruleflow-group "treasury-rules-0293"
    salience 5
when
    $o : LoansApplicant0180(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0293 Standard"
    ruleflow-group "treasury-rules-0293"
    salience 1
when
    $o : LoansApplicant0180(amount <= 950, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

