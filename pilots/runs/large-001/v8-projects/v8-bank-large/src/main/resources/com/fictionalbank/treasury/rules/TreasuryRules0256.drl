package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.MortgageCard0153;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0256 High Value"
    ruleflow-group "treasury-rules-0256"
    salience 10
when
    $o : MortgageCard0153(amount > 1000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0256 Low Score"
    ruleflow-group "treasury-rules-0256"
    salience 5
when
    $o : MortgageCard0153(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0256 Standard"
    ruleflow-group "treasury-rules-0256"
    salience 1
when
    $o : MortgageCard0153(amount <= 1000, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

