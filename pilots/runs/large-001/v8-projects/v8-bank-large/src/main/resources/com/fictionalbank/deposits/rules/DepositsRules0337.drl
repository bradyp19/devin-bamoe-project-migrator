package com.fictionalbank.deposits.rules;

import com.fictionalbank.model.DepositsPayment0200;

// Fictional deposits rules (synthetic pilot fixture)

rule "Deposits R0337 High Value"
    ruleflow-group "deposits-rules-0337"
    salience 10
when
    $o : DepositsPayment0200(amount > 2950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Deposits R0337 Low Score"
    ruleflow-group "deposits-rules-0337"
    salience 5
when
    $o : DepositsPayment0200(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Deposits R0337 Standard"
    ruleflow-group "deposits-rules-0337"
    salience 1
when
    $o : DepositsPayment0200(amount <= 2950, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

