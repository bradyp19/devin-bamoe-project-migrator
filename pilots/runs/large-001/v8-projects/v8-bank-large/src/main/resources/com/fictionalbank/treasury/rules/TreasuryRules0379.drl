package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsPayment0224;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0379 High Value"
    ruleflow-group "treasury-rules-0379"
    salience 10
when
    $o : CardsPayment0224(amount > 3650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0379 Low Score"
    ruleflow-group "treasury-rules-0379"
    salience 5
when
    $o : CardsPayment0224(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0379 Standard"
    ruleflow-group "treasury-rules-0379"
    salience 1
when
    $o : CardsPayment0224(amount <= 3650, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

