    <bpmn2:businessRuleTask id="Decide" name="Evaluate eligibility" implementation="http://www.jboss.org/drools/dmn"><bpmn2:incoming>F_Init_Decide</bpmn2:incoming><bpmn2:outgoing>F_Decide_End</bpmn2:outgoing><bpmn2:ioSpecification id="IO_Decide"><bpmn2:dataInput id="Decide_namespace" name="namespace"/><bpmn2:dataInput id="Decide_model" name="model"/><bpmn2:dataInput id="Decide_decision" name="decision"/><bpmn2:inputSet id="IS_Decide"><bpmn2:dataInputRefs>Decide_namespace</bpmn2:dataInputRefs><bpmn2:dataInputRefs>Decide_model</bpmn2:dataInputRefs><bpmn2:dataInputRefs>Decide_decision</bpmn2:dataInputRefs></bpmn2:inputSet></bpmn2:ioSpecification><bpmn2:dataInputAssociation id="DIA_Decide_namespace"><bpmn2:targetRef>Decide_namespace</bpmn2:targetRef><bpmn2:assignment id="A_Decide_namespace"><bpmn2:from xsi:type="bpmn2:tFormalExpression">https://fictionalbank.example/dmn/fraud/eligibility0006</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Decide_namespace</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation><bpmn2:dataInputAssociation id="DIA_Decide_model"><bpmn2:targetRef>Decide_model</bpmn2:targetRef><bpmn2:assignment id="A_Decide_model"><bpmn2:from xsi:type="bpmn2:tFormalExpression">Fraud Eligibility 0006</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Decide_model</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation><bpmn2:dataInputAssociation id="DIA_Decide_decision"><bpmn2:targetRef>Decide_decision</bpmn2:targetRef><bpmn2:assignment id="A_Decide_decision"><bpmn2:from xsi:type="bpmn2:tFormalExpression">Eligible</bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression">Decide_decision</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation></bpmn2:businessRuleTask>
    <bpmn2:endEvent id="End" name="End"><bpmn2:incoming>F_Decide_End</bpmn2:incoming></bpmn2:endEvent>
    <bpmn2:sequenceFlow id="F_Start_Init" sourceRef="Start" targetRef="Init"></bpmn2:sequenceFlow>
