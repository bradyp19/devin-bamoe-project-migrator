  <bpmn2:itemDefinition id="_statusItem" structureRef="String"/>
  <bpmn2:process id="loansDecisionTask0027" name="Loans decision task 0027" isExecutable="true" drools:packageName="com.fictionalbank.loans" drools:version="1.0">
    <bpmn2:property id="subject" itemSubjectRef="_subjectItem" name="subject"/>
