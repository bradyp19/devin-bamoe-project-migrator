package com.fictionalbank.loans.rules;

import com.fictionalbank.model.DepositsPayment0128;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0211 High Value"
    ruleflow-group "loans-rules-0211"
    salience 10
when
    $o : DepositsPayment0128(amount > 2800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new DepositsPayment0128());
    update($o);
end

rule "Loans R0211 Low Score"
    ruleflow-group "loans-rules-0211"
    salience 5
when
    $o : DepositsPayment0128(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0211 Standard"
    ruleflow-group "loans-rules-0211"
    salience 1
when
    $o : DepositsPayment0128(amount <= 2800, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

