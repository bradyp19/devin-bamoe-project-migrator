package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.PaymentsApplicant0054;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0083 High Value"
    ruleflow-group "kyc-rules-0083"
    salience 10
when
    $o : PaymentsApplicant0054(amount > 2800, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0083 Low Score"
    ruleflow-group "kyc-rules-0083"
    salience 5
when
    $o : PaymentsApplicant0054(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0083 Standard"
    ruleflow-group "kyc-rules-0083"
    salience 1
when
    $o : PaymentsApplicant0054(amount <= 2800, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

