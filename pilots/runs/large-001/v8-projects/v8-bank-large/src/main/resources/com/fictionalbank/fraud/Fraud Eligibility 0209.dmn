<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/fraud/eligibility0209" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0209" name="Fraud Eligibility 0209" namespace="https://fictionalbank.example/dmn/fraud/eligibility0209">
  <dmn:inputData id="_in0209_age" name="Age">
    <dmn:variable id="_in0209_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0209_amount" name="Amount">
    <dmn:variable id="_in0209_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0209" name="Eligible">
    <dmn:variable id="_dec0209_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0209a">
      <dmn:requiredInput href="#_in0209_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0209b">
      <dmn:requiredInput href="#_in0209_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0209" hitPolicy="FIRST">
      <dmn:input id="_dt0209_i1"><dmn:inputExpression id="_dt0209_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0209_i2"><dmn:inputExpression id="_dt0209_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0209_o1"/>
      <dmn:rule id="_dt0209_r1">
        <dmn:inputEntry id="_dt0209_r1a"><dmn:text>&lt; 18</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0209_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0209_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0209_r2">
        <dmn:inputEntry id="_dt0209_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0209_r2b"><dmn:text>&lt;= 2500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0209_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0209_r3">
        <dmn:inputEntry id="_dt0209_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0209_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0209_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
