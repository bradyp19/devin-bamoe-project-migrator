package com.fictionalbank.payments.rules;

import com.fictionalbank.model.TreasuryParty0083;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0133 High Value"
    ruleflow-group "payments-rules-0133"
    salience 10
when
    $o : TreasuryParty0083(amount > 3300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0133 Low Score"
    ruleflow-group "payments-rules-0133"
    salience 5
when
    $o : TreasuryParty0083(score < 620, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0133 Standard"
    ruleflow-group "payments-rules-0133"
    salience 1
when
    $o : TreasuryParty0083(amount <= 3300, score >= 620, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

