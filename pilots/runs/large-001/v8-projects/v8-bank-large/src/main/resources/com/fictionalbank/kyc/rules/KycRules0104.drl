package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsAccount0061;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0104 High Value"
    ruleflow-group "kyc-rules-0104"
    salience 10
when
    $o : DepositsAccount0061(amount > 3300, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0104 Low Score"
    ruleflow-group "kyc-rules-0104"
    salience 5
when
    $o : DepositsAccount0061(score < 660, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0104 Standard"
    ruleflow-group "kyc-rules-0104"
    salience 1
when
    $o : DepositsAccount0061(amount <= 3300, score >= 660, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

