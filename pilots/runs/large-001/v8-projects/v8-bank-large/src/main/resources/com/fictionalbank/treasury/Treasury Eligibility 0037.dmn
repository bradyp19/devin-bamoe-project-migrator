<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns="https://fictionalbank.example/dmn/treasury/eligibility0037" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0037" name="Treasury Eligibility 0037" namespace="https://fictionalbank.example/dmn/treasury/eligibility0037">
  <dmn:inputData id="_in0037_age" name="Age">
    <dmn:variable id="_in0037_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0037_amount" name="Amount">
    <dmn:variable id="_in0037_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0037" name="Eligible">
    <dmn:variable id="_dec0037_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0037a">
      <dmn:requiredInput href="#_in0037_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0037b">
      <dmn:requiredInput href="#_in0037_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0037" hitPolicy="FIRST">
      <dmn:input id="_dt0037_i1"><dmn:inputExpression id="_dt0037_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0037_i2"><dmn:inputExpression id="_dt0037_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0037_o1"/>
      <dmn:rule id="_dt0037_r1">
        <dmn:inputEntry id="_dt0037_r1a"><dmn:text>&lt; 24</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0037_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0037_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0037_r2">
        <dmn:inputEntry id="_dt0037_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0037_r2b"><dmn:text>&lt;= 18500</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0037_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0037_r3">
        <dmn:inputEntry id="_dt0037_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0037_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0037_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
