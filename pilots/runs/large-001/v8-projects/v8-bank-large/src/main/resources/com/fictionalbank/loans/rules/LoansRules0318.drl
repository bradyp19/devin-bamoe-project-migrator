package com.fictionalbank.loans.rules;

import com.fictionalbank.model.TreasuryPayment0188;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0318 High Value"
    ruleflow-group "loans-rules-0318"
    salience 10
when
    $o : TreasuryPayment0188(amount > 3000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0318 Low Score"
    ruleflow-group "loans-rules-0318"
    salience 5
when
    $o : TreasuryPayment0188(score < 650, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0318 Standard"
    ruleflow-group "loans-rules-0318"
    salience 1
when
    $o : TreasuryPayment0188(amount <= 3000, score >= 650, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

