package com.fictionalbank.loans.rules;

import com.fictionalbank.model.LoansParty0035;

// Fictional loans rules (synthetic pilot fixture)

rule "Loans R0060 High Value"
    ruleflow-group "loans-rules-0060"
    salience 10
when
    $o : LoansParty0035(amount > 2700, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Loans R0060 Low Score"
    ruleflow-group "loans-rules-0060"
    salience 5
when
    $o : LoansParty0035(score < 590, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Loans R0060 Standard"
    ruleflow-group "loans-rules-0060"
    salience 1
when
    $o : LoansParty0035(amount <= 2700, score >= 590, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

