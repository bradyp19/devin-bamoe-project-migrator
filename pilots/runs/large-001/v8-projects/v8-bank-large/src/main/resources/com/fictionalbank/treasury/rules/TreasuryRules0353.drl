package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsApplicant0216;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0353 High Value"
    ruleflow-group "treasury-rules-0353"
    salience 10
when
    $o : CardsApplicant0216(amount > 2400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0353 Low Score"
    ruleflow-group "treasury-rules-0353"
    salience 5
when
    $o : CardsApplicant0216(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0353 Standard"
    ruleflow-group "treasury-rules-0353"
    salience 1
when
    $o : CardsApplicant0216(amount <= 2400, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

