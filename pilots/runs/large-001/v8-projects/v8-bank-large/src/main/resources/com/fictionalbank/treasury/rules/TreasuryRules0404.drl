package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.DepositsApplicant0246;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0404 High Value"
    ruleflow-group "treasury-rules-0404"
    salience 10
when
    $o : DepositsApplicant0246(amount > 3950, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0404 Low Score"
    ruleflow-group "treasury-rules-0404"
    salience 5
when
    $o : DepositsApplicant0246(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0404 Standard"
    ruleflow-group "treasury-rules-0404"
    salience 1
when
    $o : DepositsApplicant0246(amount <= 3950, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

