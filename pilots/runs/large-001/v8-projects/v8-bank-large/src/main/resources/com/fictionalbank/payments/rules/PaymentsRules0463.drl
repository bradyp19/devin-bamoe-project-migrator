package com.fictionalbank.payments.rules;

import com.fictionalbank.model.DepositsApplicant0282;

// Fictional payments rules (synthetic pilot fixture)

rule "Payments R0463 High Value"
    ruleflow-group "payments-rules-0463"
    salience 10
when
    $o : DepositsApplicant0282(amount > 4450, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Payments R0463 Low Score"
    ruleflow-group "payments-rules-0463"
    salience 5
when
    $o : DepositsApplicant0282(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Payments R0463 Standard"
    ruleflow-group "payments-rules-0463"
    salience 1
when
    $o : DepositsApplicant0282(amount <= 4450, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

