package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.PaymentsCase0112;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0185 High Value"
    ruleflow-group "mortgage-rules-0185"
    salience 10
when
    $o : PaymentsCase0112(amount > 3750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0185 Low Score"
    ruleflow-group "mortgage-rules-0185"
    salience 5
when
    $o : PaymentsCase0112(score < 580, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0185 Standard"
    ruleflow-group "mortgage-rules-0185"
    salience 1
when
    $o : PaymentsCase0112(amount <= 3750, score >= 580, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

