package com.fictionalbank.fraud.rules;

import com.fictionalbank.model.MortgageAccount0013;

// Fictional fraud rules (synthetic pilot fixture)

rule "Fraud R0023 High Value"
    ruleflow-group "fraud-rules-0023"
    salience 10
when
    $o : MortgageAccount0013(amount > 2550, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Fraud R0023 Low Score"
    ruleflow-group "fraud-rules-0023"
    salience 5
when
    $o : MortgageAccount0013(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Fraud R0023 Standard"
    ruleflow-group "fraud-rules-0023"
    salience 1
when
    $o : MortgageAccount0013(amount <= 2550, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

