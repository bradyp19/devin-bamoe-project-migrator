package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.CardsParty0149;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0241 High Value"
    ruleflow-group "treasury-rules-0241"
    salience 10
when
    $o : CardsParty0149(amount > 750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
    insert(new CardsParty0149());
    update($o);
end

rule "Treasury R0241 Low Score"
    ruleflow-group "treasury-rules-0241"
    salience 5
when
    $o : CardsParty0149(score < 570, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0241 Standard"
    ruleflow-group "treasury-rules-0241"
    salience 1
when
    $o : CardsParty0149(amount <= 750, score >= 570, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

