package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.MortgageCase0094;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0159 High Value"
    ruleflow-group "mortgage-rules-0159"
    salience 10
when
    $o : MortgageCase0094(amount > 2000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0159 Low Score"
    ruleflow-group "mortgage-rules-0159"
    salience 5
when
    $o : MortgageCase0094(score < 560, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0159 Standard"
    ruleflow-group "mortgage-rules-0159"
    salience 1
when
    $o : MortgageCase0094(amount <= 2000, score >= 560, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

