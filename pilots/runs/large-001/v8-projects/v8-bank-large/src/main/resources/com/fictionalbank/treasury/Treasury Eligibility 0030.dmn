<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="http://www.omg.org/spec/DMN/20151101/dmn.xsd" xmlns="https://fictionalbank.example/dmn/treasury/eligibility0030" xmlns:feel="http://www.omg.org/spec/FEEL/20140401" id="_def0030" name="Treasury Eligibility 0030" namespace="https://fictionalbank.example/dmn/treasury/eligibility0030">
  <dmn:inputData id="_in0030_age" name="Age">
    <dmn:variable id="_in0030_age_v" name="Age" typeRef="number"/>
  </dmn:inputData>
  <dmn:inputData id="_in0030_amount" name="Amount">
    <dmn:variable id="_in0030_amount_v" name="Amount" typeRef="number"/>
  </dmn:inputData>
  <dmn:decision id="_dec0030" name="Eligible">
    <dmn:variable id="_dec0030_v" name="Eligible" typeRef="boolean"/>
    <dmn:informationRequirement id="_ir0030a">
      <dmn:requiredInput href="#_in0030_age"/>
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ir0030b">
      <dmn:requiredInput href="#_in0030_amount"/>
    </dmn:informationRequirement>
    <dmn:decisionTable id="_dt0030" hitPolicy="FIRST">
      <dmn:input id="_dt0030_i1"><dmn:inputExpression id="_dt0030_e1" typeRef="number"><dmn:text>Age</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="_dt0030_i2"><dmn:inputExpression id="_dt0030_e2" typeRef="number"><dmn:text>Amount</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="_dt0030_o1"/>
      <dmn:rule id="_dt0030_r1">
        <dmn:inputEntry id="_dt0030_r1a"><dmn:text>&lt; 21</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0030_r1b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0030_r1o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0030_r2">
        <dmn:inputEntry id="_dt0030_r2a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0030_r2b"><dmn:text>&lt;= 10000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0030_r2o"><dmn:text>true</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="_dt0030_r3">
        <dmn:inputEntry id="_dt0030_r3a"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="_dt0030_r3b"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="_dt0030_r3o"><dmn:text>false</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
