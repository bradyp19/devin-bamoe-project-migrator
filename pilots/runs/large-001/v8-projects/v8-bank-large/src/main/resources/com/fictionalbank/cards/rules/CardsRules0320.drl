package com.fictionalbank.cards.rules;

import com.fictionalbank.model.KycParty0191;

// Fictional cards rules (synthetic pilot fixture)

rule "Cards R0320 High Value"
    ruleflow-group "cards-rules-0320"
    salience 10
when
    $o : KycParty0191(amount > 1750, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Cards R0320 Low Score"
    ruleflow-group "cards-rules-0320"
    salience 5
when
    $o : KycParty0191(score < 550, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Cards R0320 Standard"
    ruleflow-group "cards-rules-0320"
    salience 1
when
    $o : KycParty0191(amount <= 1750, score >= 550, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

