package com.fictionalbank.treasury.rules;

import com.fictionalbank.model.LoansCase0016;

// Fictional treasury rules (synthetic pilot fixture)

rule "Treasury R0024 High Value"
    ruleflow-group "treasury-rules-0024"
    salience 10
when
    $o : LoansCase0016(amount > 2400, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Treasury R0024 Low Score"
    ruleflow-group "treasury-rules-0024"
    salience 5
when
    $o : LoansCase0016(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Treasury R0024 Standard"
    ruleflow-group "treasury-rules-0024"
    salience 1
when
    $o : LoansCase0016(amount <= 2400, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

