package com.fictionalbank.kyc.rules;

import com.fictionalbank.model.DepositsCard0249;

// Fictional kyc rules (synthetic pilot fixture)

rule "Kyc R0417 High Value"
    ruleflow-group "kyc-rules-0417"
    salience 10
when
    $o : DepositsCard0249(amount > 4000, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Kyc R0417 Low Score"
    ruleflow-group "kyc-rules-0417"
    salience 5
when
    $o : DepositsCard0249(score < 700, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Kyc R0417 Standard"
    ruleflow-group "kyc-rules-0417"
    salience 1
when
    $o : DepositsCard0249(amount <= 4000, score >= 700, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

