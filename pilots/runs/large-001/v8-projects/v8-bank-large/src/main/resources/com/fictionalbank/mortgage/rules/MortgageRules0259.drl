package com.fictionalbank.mortgage.rules;

import com.fictionalbank.model.PaymentsPayment0152;

// Fictional mortgage rules (synthetic pilot fixture)

rule "Mortgage R0259 High Value"
    ruleflow-group "mortgage-rules-0259"
    salience 10
when
    $o : PaymentsPayment0152(amount > 650, status == null)
then
    $o.setStatus("REFER");
    $o.setValidated(true);
end

rule "Mortgage R0259 Low Score"
    ruleflow-group "mortgage-rules-0259"
    salience 5
when
    $o : PaymentsPayment0152(score < 640, status == null)
then
    $o.setStatus("DECLINE");
    $o.setValidated(true);
end

rule "Mortgage R0259 Standard"
    ruleflow-group "mortgage-rules-0259"
    salience 1
when
    $o : PaymentsPayment0152(amount <= 650, score >= 640, status == null)
then
    $o.setStatus("APPROVE");
    $o.setValidated(true);
end

